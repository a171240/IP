page, :root {
  --obsidian: #050507;
  --champagne: #E5D3B3;
  --champagne-2: #F5E7CF;
  --champagne-3: #C6A87C;
  --pearl: #F5F3FF;
  --slate: #2A2A35;
  --text: #F5F5F5;
  --muted: #B9B3C2;
  --subtle: #8E8796;
  --glass: rgba(15, 15, 20, 0.35);
  --glass-strong: rgba(15, 15, 20, 0.6);
  --border: rgba(255, 255, 255, 0.08);
  --border-gold: rgba(229, 211, 179, 0.35);
  --shadow-soft: 0 18rpx 45rpx rgba(0, 0, 0, 0.45);
  --shadow-glow: 0 32rpx 90rpx rgba(229, 211, 179, 0.2);
  --glow-gold: 0 0 45rpx rgba(229, 211, 179, 0.35);

  /* Shared beauty-system tokens for the new mini-program UI pass. */
  --beauty-paper: #f7f1ea;
  --beauty-paper-2: #f2ebe3;
  --beauty-paper-3: #ece2d9;
  --beauty-ink: #281f1c;
  --beauty-ink-soft: #6e605a;
  --beauty-ink-subtle: #8c7e76;
  --beauty-line: rgba(108, 85, 77, 0.12);
  --beauty-line-strong: rgba(108, 85, 77, 0.18);
  --beauty-shadow-light: 0 18rpx 42rpx rgba(59, 43, 37, 0.10);
  --beauty-shadow-card: 0 12rpx 28rpx rgba(59, 43, 37, 0.08);
  --beauty-shadow-tight: 0 8rpx 18rpx rgba(59, 43, 37, 0.06);

  --beauty-sage-1: #a8b49c;
  --beauty-sage-2: #91a085;
  --beauty-sage-3: #79886d;
  --beauty-sage-deep: #273026;
  --beauty-sage-surface: rgba(160, 176, 147, 0.92);
  --beauty-sage-surface-2: rgba(143, 158, 131, 0.94);
  --beauty-sage-line: rgba(205, 218, 194, 0.28);

  --beauty-rose-1: #cb9887;
  --beauty-rose-2: #b77f6b;
  --beauty-rose-3: #9d6a57;
  --beauty-rose-surface: rgba(203, 152, 135, 0.92);
  --beauty-rose-line: rgba(243, 217, 205, 0.24);

  --beauty-cocoa-1: #bf8a74;
  --beauty-cocoa-2: #a86f5b;
  --beauty-cocoa-3: #905845;

  --beauty-pill-bg: rgba(255, 255, 255, 0.78);
  --beauty-pill-text: #6b5a53;
}

page {
  background-color: #050507;
  color: #F5F5F5;
  font-family: "HarmonyOS Sans", "Alibaba PuHuiTi 2.0", "PingFang SC", "Microsoft YaHei", sans-serif;
  letter-spacing: 0.2rpx;
  background-image:
    radial-gradient(120% 120% at 100% -10%, rgba(229, 211, 179, 0.14) 0%, rgba(5, 5, 7, 0) 58%),
    radial-gradient(120% 120% at -10% 20%, rgba(245, 243, 255, 0.08) 0%, rgba(5, 5, 7, 0) 60%),
    radial-gradient(140% 140% at 40% 120%, rgba(42, 42, 53, 0.5) 0%, rgba(5, 5, 7, 0) 60%),
    linear-gradient(180deg, #050507 0%, #0A0A0E 55%, #050507 100%);
}

view, text, input, textarea, button, navigator {
  box-sizing: border-box;
  color: #F5F5F5;
}

input::placeholder,
textarea::placeholder {
  color: #8E8796;
}

.page,
.container,
.card,
.hero,
.row {
  width: 100%;
}

.container {
  padding: 28rpx 24rpx 180rpx;
  /* Keep content above the tab bar + iOS safe area. */
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
  position: relative;
  z-index: 1;
}

.page {
  min-height: 100vh;
  background-repeat: no-repeat;
  background-size: cover;
  background-color: transparent;
}

.page-home {
  background-image:
    radial-gradient(130% 100% at 0% 0%, rgba(229, 211, 179, 0.18) 0%, rgba(5, 5, 7, 0) 60%),
    radial-gradient(120% 90% at 100% 0%, rgba(245, 243, 255, 0.12) 0%, rgba(5, 5, 7, 0) 60%);
}

.page-workspace {
  background-image:
    radial-gradient(120% 100% at 0% 0%, rgba(229, 211, 179, 0.16) 0%, rgba(5, 5, 7, 0) 60%),
    radial-gradient(120% 90% at 100% 10%, rgba(245, 243, 255, 0.1) 0%, rgba(5, 5, 7, 0) 60%);
}

.page-factory {
  background-image:
    radial-gradient(120% 90% at 0% 0%, rgba(229, 211, 179, 0.22) 0%, rgba(5, 5, 7, 0) 60%),
    radial-gradient(120% 90% at 100% 10%, rgba(245, 243, 255, 0.08) 0%, rgba(5, 5, 7, 0) 60%),
    radial-gradient(140% 120% at 50% 100%, rgba(42, 42, 53, 0.7) 0%, rgba(5, 5, 7, 0) 60%);
}

.page-xhs {
  background-image:
    radial-gradient(120% 100% at 0% 0%, rgba(229, 211, 179, 0.12) 0%, rgba(5, 5, 7, 0) 60%),
    radial-gradient(140% 100% at 100% 10%, rgba(42, 42, 53, 0.6) 0%, rgba(5, 5, 7, 0) 60%);
}

.page-mine {
  background-image:
    radial-gradient(120% 100% at 0% 0%, rgba(245, 243, 255, 0.1) 0%, rgba(5, 5, 7, 0) 60%),
    radial-gradient(120% 100% at 100% 0%, rgba(229, 211, 179, 0.14) 0%, rgba(5, 5, 7, 0) 60%);
}

.page-auth {
  background-image:
    radial-gradient(120% 100% at 50% 0%, rgba(245, 243, 255, 0.12) 0%, rgba(5, 5, 7, 0) 60%),
    radial-gradient(120% 120% at 0% 100%, rgba(229, 211, 179, 0.12) 0%, rgba(5, 5, 7, 0) 60%);
}

.page-diagnosis {
  background-image:
    radial-gradient(120% 100% at 0% 0%, rgba(229, 211, 179, 0.14) 0%, rgba(5, 5, 7, 0) 60%),
    radial-gradient(120% 100% at 100% 0%, rgba(245, 243, 255, 0.1) 0%, rgba(5, 5, 7, 0) 60%);
}

.page-pay {
  background-image:
    radial-gradient(120% 100% at 0% 0%, rgba(229, 211, 179, 0.2) 0%, rgba(5, 5, 7, 0) 60%),
    radial-gradient(120% 100% at 100% 0%, rgba(245, 243, 255, 0.08) 0%, rgba(5, 5, 7, 0) 60%);
}

.page-order {
  background-image:
    radial-gradient(120% 100% at 0% 0%, rgba(42, 42, 53, 0.6) 0%, rgba(5, 5, 7, 0) 60%),
    radial-gradient(120% 100% at 100% 0%, rgba(229, 211, 179, 0.12) 0%, rgba(5, 5, 7, 0) 60%);
}

.title {
  font-size: 46rpx;
  font-weight: 700;
  letter-spacing: 0.4rpx;
  color: #F5F2EA;
  text-shadow: 0 12rpx 28rpx rgba(0, 0, 0, 0.45);
  line-height: 1.16;
  display: block;
  margin-bottom: 8rpx;
}

.subtitle {
  font-size: 24rpx;
  color: #B9B3C2;
  opacity: 0.95;
  line-height: 1.62;
  display: block;
}

.section {
  margin-top: 28rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 14rpx;
  color: #F5F2EA;
  letter-spacing: 0.4rpx;
  line-height: 1.3;
  display: block;
}

.eyebrow {
  font-size: 20rpx;
  color: #E5D3B3;
  letter-spacing: 1.2rpx;
  text-transform: uppercase;
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(229, 211, 179, 0.12);
  border: 1px solid rgba(229, 211, 179, 0.35);
  box-shadow: 0 8rpx 18rpx rgba(229, 211, 179, 0.18);
  margin-bottom: 14rpx;
}

.hero {
  padding: 24rpx;
  border-radius: 28rpx;
  position: relative;
  overflow: hidden;
  background:
    radial-gradient(130% 140% at 0% 0%, rgba(229, 211, 179, 0.12) 0%, rgba(255, 255, 255, 0) 52%),
    linear-gradient(180deg, rgba(20, 22, 28, 0.94) 0%, rgba(10, 12, 16, 0.96) 100%);
  border: 1px solid rgba(255, 255, 255, 0.08);
  box-shadow: 0 20rpx 52rpx rgba(0, 0, 0, 0.26), inset 0 1rpx 0 rgba(255, 255, 255, 0.06);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
}

.hero-actions {
  margin-top: 20rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.hero-actions > button,
.hero-actions > navigator {
  width: 48%;
  margin-bottom: 16rpx;
}

.hero-actions .btn-primary,
.hero-actions .btn-outline {
  margin-top: 0;
}

.hero-actions > button:only-child,
.hero-actions > navigator:only-child {
  width: 100%;
}

.hero-badges {
  margin-top: 18rpx;
  display: flex;
  flex-wrap: wrap;
}

.hero-badges > view {
  margin-right: 10rpx;
  margin-bottom: 10rpx;
}

.action-card {
  padding: 24rpx;
}

.action-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 18rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 700;
  color: #1A1510;
  background: linear-gradient(135deg, #E5D3B3 0%, #FFF 50%, #C6A87C 100%);
  box-shadow: 0 12rpx 26rpx rgba(229, 211, 179, 0.25);
  flex-shrink: 0;
}

.action-meta {
  flex: 1;
  min-width: 0;
}

.action-meta text {
  display: block;
}

.flow {
  display: flex;
  flex-direction: column;
}

.flow-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 14rpx;
}

.flow-item:last-child {
  margin-bottom: 0;
}

.flow-index {
  width: 44rpx;
  height: 44rpx;
  border-radius: 16rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
  font-weight: 700;
  color: #1A1510;
  background: linear-gradient(135deg, #E5D3B3 0%, #FFF 50%, #C6A87C 100%);
  box-shadow: 0 10rpx 20rpx rgba(229, 211, 179, 0.22);
  flex-shrink: 0;
  margin-right: 14rpx;
}

.flow-body {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.card {
  position: relative;
  overflow: visible;
  background:
    radial-gradient(140% 140% at 100% 0%, rgba(229, 211, 179, 0.06) 0%, rgba(5, 5, 7, 0) 52%),
    linear-gradient(180deg, rgba(19, 22, 28, 0.94) 0%, rgba(12, 14, 19, 0.96) 100%);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 24rpx;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  box-shadow: 0 16rpx 42rpx rgba(0, 0, 0, 0.24), inset 0 1rpx 0 rgba(255, 255, 255, 0.06);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
}

.card > view,
.card > text,
.card > image {
  margin-top: 10rpx;
}

.card > view:first-child,
.card > text:first-child,
.card > image:first-child {
  margin-top: 0;
}

.card-title {
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 6rpx;
  color: #F5F2EA;
  line-height: 1.34;
  display: block;
}

.muted {
  color: #B9B3C2;
  line-height: 1.55;
}

.small {
  font-size: 22rpx;
  line-height: 1.5;
}

.row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.space-between {
  justify-content: space-between;
}

.row > view,
.row > text,
.row > button,
.row > navigator,
.row > image {
  margin-right: 12rpx;
  margin-bottom: 12rpx;
}

.row > view:last-child,
.row > text:last-child,
.row > button:last-child,
.row > navigator:last-child,
.row > image:last-child {
  margin-right: 0;
}

.row.space-between > view,
.row.space-between > text,
.row.space-between > button,
.row.space-between > navigator,
.row.space-between > image {
  margin-right: 0;
  margin-bottom: 0;
}

.row.action-row {
  flex-wrap: nowrap;
  align-items: center;
}

.row.action-row > view,
.row.action-row > text,
.row.action-row > button,
.row.action-row > navigator,
.row.action-row > image {
  margin-bottom: 0;
}

.grid-2 {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.grid-2 > view,
.grid-2 > navigator,
.grid-2 > button {
  width: 48%;
  margin-bottom: 18rpx;
}

.grid-2 > view:only-child,
.grid-2 > navigator:only-child,
.grid-2 > button:only-child {
  width: 100%;
}

.grid-3 {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.grid-3 > view,
.grid-3 > navigator,
.grid-3 > button {
  width: 31%;
  margin-bottom: 14rpx;
}

.chip {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  border: 1px solid rgba(229, 211, 179, 0.4);
  color: #E5D3B3;
  background: linear-gradient(135deg, rgba(229, 211, 179, 0.2), rgba(255, 255, 255, 0.04));
  box-shadow: 0 10rpx 22rpx rgba(229, 211, 179, 0.2), inset 0 1rpx 0 rgba(255, 255, 255, 0.08);
  display: inline-block;
  line-height: 1.4;
  transition: opacity 140ms ease, transform 140ms ease;
}

.tag {
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  border: 1px solid rgba(255, 255, 255, 0.12);
  color: #CFC6B8;
  background: rgba(255, 255, 255, 0.04);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.08);
  display: inline-block;
  line-height: 1.4;
  transition: opacity 140ms ease, transform 140ms ease;
}

.tag-accent {
  color: #F1E3C6;
  border-color: rgba(229, 211, 179, 0.5);
  background: linear-gradient(135deg, rgba(229, 211, 179, 0.2), rgba(255, 255, 255, 0.04));
}

.tag-success {
  color: #9FECCB;
  border-color: rgba(34, 197, 94, 0.4);
  background: linear-gradient(135deg, rgba(34, 197, 94, 0.2), rgba(34, 197, 94, 0.08));
}

.tag:active,
.chip:active {
  opacity: 0.92;
  transform: translateY(1rpx);
}

.plan-card-pro {
  border-color: rgba(229, 211, 179, 0.42);
  box-shadow: var(--shadow-soft), var(--shadow-glow), inset 0 1rpx 0 rgba(255, 255, 255, 0.1);
}

.btn-primary {
  margin-top: 18rpx;
  background: linear-gradient(135deg, #DCC7A6 0%, #F1E3C6 52%, #C1A076 100%);
  color: #1A1510;
  border-radius: 18rpx;
  font-size: 26rpx;
  min-height: 84rpx;
  padding: 0 24rpx;
  border: none;
  letter-spacing: 0.4rpx;
  box-shadow: 0 12rpx 26rpx rgba(193, 160, 118, 0.18), 0 10rpx 24rpx rgba(0, 0, 0, 0.3);
  line-height: 1.2;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
}

.btn-primary:active {
  opacity: 0.92;
}

.btn-outline {
  margin-top: 12rpx;
  background: rgba(255, 255, 255, 0.03);
  color: #F1E3C6;
  border-radius: 18rpx;
  font-size: 24rpx;
  min-height: 84rpx;
  padding: 0 24rpx;
  border: 1px solid rgba(255, 255, 255, 0.12);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  box-shadow: 0 8rpx 18rpx rgba(0, 0, 0, 0.28), inset 0 1rpx 0 rgba(255, 255, 255, 0.04);
  line-height: 1.2;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
}

.btn-outline:active {
  opacity: 0.9;
}

.btn-primary[disabled],
.btn-outline[disabled] {
  opacity: 0.55;
}

button[size="mini"].btn-primary,
button[size="mini"].btn-outline {
  width: auto;
  min-height: 64rpx;
  padding: 0 18rpx;
  font-size: 22rpx;
  border-radius: 16rpx;
  margin-top: 0;
}

button[size="mini"].btn-primary {
  box-shadow: 0 8rpx 16rpx rgba(229, 211, 179, 0.14), 0 4rpx 12rpx rgba(0, 0, 0, 0.55);
}

button[size="mini"].btn-outline {
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.45), inset 0 1rpx 0 rgba(255, 255, 255, 0.05);
}

button::after {
  border: none;
}

.progress-bar {
  width: 100%;
  height: 12rpx;
  border-radius: 999rpx;
  background: rgba(229, 211, 179, 0.18);
  overflow: hidden;
  margin: 18rpx 0 10rpx;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #E5D3B3, #FFF, #C6A87C);
  box-shadow: var(--glow-gold);
}

.input {
  width: 100%;
  background: rgba(8, 10, 14, 0.8);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 18rpx;
  height: 84rpx;
  padding: 0 18rpx;
  color: #F5F5F5;
  font-size: 24rpx;
  margin-top: 12rpx;
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  box-shadow: inset 0 2rpx 6rpx rgba(0, 0, 0, 0.32), inset 0 1rpx 0 rgba(255, 255, 255, 0.05);
  line-height: 84rpx;
}

.textarea {
  height: auto;
  min-height: 160rpx;
  padding: 16rpx;
  line-height: 1.6;
}

.divider {
  height: 1rpx;
  background: linear-gradient(90deg, rgba(229, 211, 179, 0.05), rgba(229, 211, 179, 0.35), rgba(229, 211, 179, 0.05));
  margin: 18rpx 0;
  opacity: 0.8;
  transform: scaleY(0.6);
  transform-origin: center;
}

.cover-image {
  width: 100%;
  border-radius: 18rpx;
  margin-top: 14rpx;
  box-shadow: var(--shadow-soft);
}

.section-head {
  margin-bottom: 14rpx;
}

.section-copy {
  display: block;
  margin-top: -4rpx;
  font-size: 22rpx;
  line-height: 1.58;
  color: var(--muted);
}

.hero-head,
.panel-head,
.list-head,
.list-item-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.hero-head > view,
.panel-head > view,
.list-head > view,
.list-item-head > view {
  min-width: 0;
  flex: 1;
}

.hero-mini-btn {
  width: auto;
  min-width: 148rpx;
  margin-top: 0;
  flex-shrink: 0;
}

.panel-kicker,
.eyebrow-copy {
  display: block;
  font-size: 18rpx;
  line-height: 1.3;
  letter-spacing: 1.4rpx;
  text-transform: uppercase;
  color: rgba(229, 211, 179, 0.72);
}

.field-stack {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.field-group {
  display: flex;
  flex-direction: column;
}

.field-label {
  display: block;
  margin-bottom: 8rpx;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1.45;
  color: #F5F2EA;
}

.field-help {
  display: block;
  margin-bottom: 4rpx;
  font-size: 21rpx;
  line-height: 1.56;
  color: var(--subtle);
}

.field-inline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.field-inline-copy {
  min-width: 0;
  flex: 1;
}

.cta-row,
.card-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.cta-row > button,
.card-actions > button {
  flex: 1 1 0;
  min-width: 0;
  margin-top: 0;
}

.card-actions > button:only-child,
.cta-row > button:only-child {
  width: 100%;
}

.list-stack {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.meta-lines {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.meta-line {
  display: block;
  font-size: 22rpx;
  line-height: 1.56;
  color: var(--muted);
  word-break: break-word;
}

.status-pill {
  display: inline-flex;
  align-items: center;
  min-height: 42rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  line-height: 1.3;
  color: #CFC6B8;
  border: 1px solid rgba(255, 255, 255, 0.12);
  background: rgba(255, 255, 255, 0.04);
}

.status-pill-accent {
  color: #F1E3C6;
  border-color: rgba(229, 211, 179, 0.42);
  background: rgba(229, 211, 179, 0.1);
}

.status-pill-success {
  color: #9FECCB;
  border-color: rgba(34, 197, 94, 0.4);
  background: rgba(34, 197, 94, 0.12);
}

.status-pill-muted {
  color: var(--muted);
}

.surface-divider {
  height: 1rpx;
  margin: 16rpx 0;
  background: linear-gradient(90deg, rgba(255, 255, 255, 0), rgba(255, 255, 255, 0.14), rgba(255, 255, 255, 0));
}

.hero-summary {
  margin-top: 18rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.hero-summary-item {
  padding: 16rpx;
  border-radius: 18rpx;
  border: 1px solid rgba(255, 255, 255, 0.08);
  background: rgba(255, 255, 255, 0.03);
}

.hero-summary-label {
  display: block;
  font-size: 20rpx;
  line-height: 1.4;
  color: var(--subtle);
}

.hero-summary-value {
  display: block;
  margin-top: 6rpx;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.36;
  color: #F5F2EA;
}

.compact-cover {
  width: 100%;
  max-height: 520rpx;
  object-fit: cover;
}

navigator {
  text-decoration: none;
}

.fade-up {
  animation: fadeUp 420ms ease both;
}

.delay-1 {
  animation-delay: 80ms;
}

.delay-2 {
  animation-delay: 160ms;
}

@keyframes fadeUp {
  from {
    opacity: 0;
    transform: translateY(12rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
