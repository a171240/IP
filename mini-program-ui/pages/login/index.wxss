.auth-shell {
  padding-top: 80rpx;
}

.auth-hero {
  gap: 18rpx;
}

.auth-note {
  display: block;
  margin-top: 10rpx;
}

.avatar-btn {
  width: 120rpx;
  height: 120rpx;
  padding: 0;
  margin: 20rpx auto;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
  border: 2rpx solid rgba(255, 255, 255, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.avatar-btn::after {
  border: none;
}

.avatar-preview {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
}

.avatar-placeholder {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.45);
  text-align: center;
  padding: 20rpx;
}

.nickname-input {
  width: 100%;
  height: 80rpx;
  padding: 0 32rpx;
  margin: 16rpx 0;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 2rpx solid rgba(255, 255, 255, 0.12);
  font-size: 28rpx;
  color: #ffffff;
  box-sizing: border-box;
}
