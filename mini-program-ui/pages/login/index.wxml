<view class="page page-auth page-auth-entry">
  <view class="container auth-shell">
    <view class="hero auth-hero fade-up">
      <text class="eyebrow">账户</text>
      <text class="title">连接当前账号</text>
      <text class="subtitle">完成连接后，可同步权益、订单和积分状态。</text>

      <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image class="avatar-preview" src="{{avatarUrl}}" mode="aspectFill" wx:if="{{avatarUrl}}" />
        <text class="avatar-placeholder" wx:else>点击设置头像</text>
      </button>

      <input
        class="nickname-input"
        type="nickname"
        placeholder="请输入昵称"
        value="{{nickname}}"
        bindchange="onNicknameChange"
      />

      <button class="btn-primary" bindtap="handleLogin" loading="{{loading}}">继续连接</button>
      <text class="muted small auth-note">首次进入会自动完成基础账号初始化。</text>
    </view>
  </view>
</view>
