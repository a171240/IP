<view class="page page-auth page-auth-entry">
  <view class="container auth-shell">
    <view class="hero auth-hero fade-up">
      <text class="eyebrow">Sign In</text>
      <text class="title">微信一键登录</text>
      <text class="subtitle">连接账号后，积分、订单和订阅状态会自动同步到当前小程序。</text>

      <view class="hero-summary">
        <view class="hero-summary-item">
          <text class="hero-summary-label">同步内容</text>
          <text class="hero-summary-value">积分、订单、权益状态</text>
        </view>
        <view class="hero-summary-item">
          <text class="hero-summary-label">登录方式</text>
          <text class="hero-summary-value">保持现有微信授权逻辑</text>
        </view>
      </view>

      <button class="btn-primary" bindtap="handleLogin" loading="{{loading}}">微信一键登录</button>
      <text class="muted small auth-note">首次登录将自动创建账号。</text>
    </view>
  </view>
</view>
