<view class="page page-auth page-auth-entry">
  <view class="container auth-shell">
    <view class="hero auth-hero fade-up">
      <text class="eyebrow">账户</text>
      <text class="title">连接当前账号</text>
      <text class="subtitle">完成连接后，可同步权益、订单和积分状态。</text>

      <button class="btn-primary" bindtap="handleLogin" loading="{{loading}}">继续</button>
      <text class="muted small auth-note">首次进入会自动完成基础账号初始化。</text>
    </view>
  </view>
</view>
