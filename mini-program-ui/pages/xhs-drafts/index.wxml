<view class="page page-xhs page-xhs-drafts">
  <view class="container drafts-container">
    <view class="hero drafts-hero fade-up">
      <view class="hero-head drafts-hero-head">
        <view class="drafts-hero-copy">
          <text class="eyebrow">草稿入口</text>
          <text class="title">草稿库</text>
          <text class="subtitle">把可继续编辑、可复制复用、已发布的内容放进同一条队列，先看状态，再决定下一步。</text>
        </view>
      </view>

      <view class="drafts-focus-band">
        <view class="drafts-focus-copy">
          <text class="drafts-band-label">今日处理</text>
          <text class="drafts-band-title">优先推进未发布草稿</text>
          <text class="drafts-band-note">封面只做辅助预览，标题、时间、状态和操作会始终在主层级。</text>
        </view>
        <view class="drafts-focus-side">
          <view class="drafts-focus-stat">
            <text class="drafts-stat-value">{{loading ? '--' : drafts.length}}</text>
            <text class="drafts-stat-label">{{loading ? '加载中' : '条内容资产'}}</text>
          </view>
          <button class="btn-outline drafts-band-action" size="mini" bindtap="handleGoWorkshop">去发文</button>
        </view>
      </view>
    </view>

    <view class="section drafts-control-section fade-up delay-1">
      <view class="drafts-control-panel">
        <view class="drafts-filter-head">
          <view>
            <text class="drafts-filter-kicker">筛选</text>
            <text class="drafts-filter-title">内容队列</text>
          </view>
          <text class="drafts-filter-count">{{loading ? '同步中' : drafts.length + ' 条'}}</text>
        </view>

        <view class="drafts-filter-rail">
          <text class="drafts-filter-chip drafts-filter-chip-active">全部</text>
          <text class="drafts-filter-chip">待编辑</text>
          <text class="drafts-filter-chip">可复制</text>
          <text class="drafts-filter-chip">已发布</text>
        </view>
      </view>
    </view>

    <view class="section drafts-library-section fade-up delay-2">
      <view class="section-head drafts-section-head">
        <view>
          <text class="section-title">最近草稿</text>
          <text class="section-copy">按资产库方式扫描：状态在前，封面降级，主操作只保留继续编辑。</text>
        </view>
        <text class="drafts-view-mode">列表</text>
      </view>

      <view wx:if="{{loading}}" class="card drafts-state-card drafts-loading-card">
        <view class="drafts-state-mark"></view>
        <view class="drafts-state-copy">
          <text class="card-title">正在同步草稿</text>
          <text class="muted small">读取已生成内容、封面和发布结果。</text>
        </view>
      </view>

      <view wx:if="{{!loading && !drafts.length}}" class="card drafts-state-card drafts-empty-card">
        <view class="drafts-empty-top">
          <view class="drafts-state-mark drafts-state-mark-empty"></view>
          <text class="status-pill status-pill-muted">空队列</text>
        </view>
        <view class="drafts-state-copy">
          <text class="card-title">还没有草稿</text>
          <text class="muted small">先生成第一条内容，这里会沉淀成可继续编辑、可复制和可发布的资产队列。</text>
        </view>
        <button class="btn-primary drafts-empty-btn" bindtap="handleGoWorkshop">去工坊生成</button>
      </view>

      <view wx:if="{{!loading && drafts.length}}" class="drafts-list list-stack">
        <view
          wx:for="{{drafts}}"
          wx:key="id"
          class="card draft-list-card"
          bindtap="handleOpenDraft"
          data-id="{{item.id}}"
        >
          <view class="draft-row-top">
            <view class="draft-main">
              <view class="draft-status-line">
                <text class="status-pill {{item.status === 'published' ? 'status-pill-success' : 'status-pill-accent'}}">{{item.statusLabel}}</text>
                <text class="draft-time">{{item.createdAtLabel}}</text>
              </view>

              <text class="card-title draft-title">{{item.title}}</text>

              <view class="draft-meta-lines">
                <text class="draft-meta-item">{{item.riskLabel}}</text>
                <text class="draft-meta-item">{{item.publish_url ? '已生成发布结果' : '待继续处理'}}</text>
              </view>
            </view>

            <view class="draft-preview">
              <image wx:if="{{item.coverAbs}}" src="{{item.coverAbs}}" mode="aspectFill" class="draft-cover-image" />
              <view wx:else class="draft-cover-placeholder">
                <text>未补封面</text>
              </view>
            </view>
          </view>

          <view class="draft-actions">
            <button class="btn-primary draft-primary-action" size="mini" data-id="{{item.id}}" catchtap="handleOpenDraft">继续编辑</button>
            <button class="btn-outline draft-secondary-action" size="mini" data-id="{{item.id}}" catchtap="handleCopyContent">复制文案</button>
          </view>

          <view wx:if="{{item.publish_url}}" class="draft-publish-info">
            <view class="draft-publish-copy">
              <text class="field-label">发布结果</text>
              <text class="meta-line draft-publish-url">{{item.publish_url}}</text>
            </view>
            <view class="draft-publish-actions">
              <button class="btn-outline draft-link-action" size="mini" data-url="{{item.publish_url}}" catchtap="handleCopyUrl">复制链接</button>
              <image wx:if="{{item.qrAbs}}" src="{{item.qrAbs}}" mode="aspectFit" class="draft-qr-image" />
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
