<view class="page page-xhs page-xhs-drafts">
  <view class="container">
    <view class="hero drafts-hero fade-up">
      <view class="hero-head">
        <view>
          <text class="eyebrow">草稿库</text>
          <text class="title">继续编辑，或直接复用</text>
          <text class="subtitle">标题、状态、时间优先，继续编辑更直接。</text>
        </view>
        <button class="btn-outline hero-mini-btn" size="mini" bindtap="handleGoWorkshop">去工坊</button>
      </view>

      <view class="hero-badges">
        <text class="tag">{{loading ? '加载中...' : drafts.length + ' 条记录'}}</text>
      </view>
    </view>

    <view class="section fade-up delay-1">
      <view class="section-head">
        <text class="section-title">最近草稿</text>
        <text class="section-copy">继续编辑可发内容。</text>
      </view>

      <view wx:if="{{loading}}" class="card">
        <text class="muted small">加载中...</text>
      </view>

      <view wx:if="{{!loading && !drafts.length}}" class="card">
        <text class="card-title">还没有草稿</text>
        <text class="muted small">先去工坊生成第一条内容。</text>
        <button class="btn-primary" bindtap="handleGoWorkshop">去工坊</button>
      </view>

      <view wx:if="{{!loading && drafts.length}}" class="list-stack">
        <view
          wx:for="{{drafts}}"
          wx:key="id"
          class="card draft-list-card"
          bindtap="handleOpenDraft"
          data-id="{{item.id}}"
        >
          <view class="list-item-head">
            <view>
              <text class="card-title draft-title">{{item.title}}</text>
              <view class="meta-lines draft-meta-lines">
                <text class="meta-line">{{item.createdAtLabel}}</text>
                <text class="meta-line">{{item.riskLabel}}</text>
              </view>
            </view>
            <text class="status-pill {{item.status === 'published' ? 'status-pill-success' : 'status-pill-accent'}}">{{item.statusLabel}}</text>
          </view>

          <image wx:if="{{item.coverAbs}}" src="{{item.coverAbs}}" mode="widthFix" class="cover-image draft-cover-image" />

          <view class="card-actions draft-actions">
            <button class="btn-primary" size="mini" data-id="{{item.id}}" catchtap="handleOpenDraft">继续编辑</button>
            <button class="btn-outline" size="mini" data-id="{{item.id}}" catchtap="handleCopyContent">复制文案</button>
          </view>

          <view wx:if="{{item.publish_url}}" class="draft-publish-info">
            <text class="field-label">发布结果</text>
            <text class="meta-line">{{item.publish_url}}</text>
            <view class="card-actions">
              <button class="btn-outline" size="mini" data-url="{{item.publish_url}}" catchtap="handleCopyUrl">复制链接</button>
            </view>
            <image wx:if="{{item.qrAbs}}" src="{{item.qrAbs}}" mode="widthFix" class="cover-image draft-qr-image" />
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
