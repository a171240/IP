<view class="page page-xhs page-store-center">
  <view class="container">
    <view class="hero fade-up">
      <view class="hero-head">
        <view>
          <text class="eyebrow">门店档案</text>
          <text class="title">管理可复用的门店信息</text>
          <text class="subtitle">创建后可直接用于发文生成。</text>
        </view>
        <button class="btn-primary hero-mini-btn" size="mini" bindtap="handleCreate">新建档案</button>
      </view>

      <view class="hero-badges">
        <text class="tag">{{loading ? '加载中...' : profiles.length + ' 份档案'}}</text>
      </view>
    </view>

    <view class="section fade-up delay-1">
      <view class="section-head">
        <text class="section-title">我的档案</text>
        <text class="section-copy">选用、编辑、删除都保留原逻辑。</text>
      </view>

      <view wx:if="{{loading}}" class="card">
        <text class="muted small">加载中...</text>
      </view>

      <view wx:if="{{!loading && !profiles.length}}" class="card">
        <text class="card-title">暂无门店档案</text>
        <text class="muted small">建议先创建一份，后续发文会更稳定。</text>
        <button class="btn-primary" bindtap="handleCreate">去新建</button>
      </view>

      <view wx:if="{{!loading && profiles.length}}" class="list-stack">
        <view
          wx:for="{{profiles}}"
          wx:key="id"
          class="card store-list-card"
        >
          <view class="list-item-head">
            <view>
              <text class="card-title">{{item.name}}</text>
              <text class="meta-line" wx:if="{{item.metaLabel}}">{{item.metaLabel}}</text>
            </view>
            <text class="status-pill status-pill-accent" wx:if="{{item.placeLabel}}">{{item.placeLabel}}</text>
          </view>

          <view class="card-actions">
            <button class="btn-primary" size="mini" data-id="{{item.id}}" catchtap="handleUse">选用</button>
            <button class="btn-outline" size="mini" data-id="{{item.id}}" catchtap="handleEdit">编辑</button>
            <button class="btn-outline" size="mini" data-id="{{item.id}}" catchtap="handleDelete">删除</button>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
