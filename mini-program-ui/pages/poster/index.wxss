page {
  position: fixed;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #efe5d8;
}

.poster-chat-page,
.poster-chat-shell {
  height: 100%;
  overflow: hidden;
}

.poster-chat-page {
  color: #21191c;
  background: #efe5d8;
}

.poster-chat-page view,
.poster-chat-page text,
.poster-chat-page input,
.poster-chat-page button {
  font-family: "Inter", "PingFang SC", "Microsoft YaHei", sans-serif;
  letter-spacing: 0;
  box-sizing: border-box;
}

.poster-chat-shell {
  display: flex;
  flex-direction: column;
  background: #efe5d8;
}

.poster-chat-top {
  flex-shrink: 0;
  min-height: 152rpx;
  padding: 30rpx 34rpx 24rpx;
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  align-items: center;
  color: #21191c;
  background: #f8f0e8;
  border-bottom: 1rpx solid rgba(216, 200, 187, 0.78);
  box-shadow: 0 10rpx 24rpx rgba(58, 42, 36, 0.04);
}

.poster-plus-btn,
.poster-send-btn,
.poster-voice-btn {
  margin: 0;
  padding: 0;
  border: 0;
}

.poster-chat-heading {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.poster-chat-title {
  display: block;
  color: #21191c;
  font-size: 35rpx;
  line-height: 1.2;
  font-weight: 800;
}

.poster-chat-subtitle {
  max-width: 100%;
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: #6e605a;
  font-size: 22rpx;
  line-height: 1.25;
  font-weight: 700;
}

.poster-chat-subtitle text {
  min-width: 0;
  color: inherit;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.poster-status-dot {
  flex-shrink: 0;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #b88667;
  box-shadow: 0 0 0 6rpx rgba(184, 134, 103, 0.14);
}

.poster-chat-scroll {
  flex: 1;
  height: 0;
  background: #efe5d8;
}

.poster-chat-list {
  min-height: 100%;
  padding: 28rpx 30rpx 34rpx;
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.poster-chat-message {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
}

.poster-chat-message.is-user {
  justify-content: flex-end;
}

.poster-chat-avatar {
  flex-shrink: 0;
  width: 54rpx;
  height: 54rpx;
  border-radius: 19rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #a86a5f;
  background: #fff8ef;
  border: 1rpx solid rgba(184, 134, 103, 0.38);
  box-shadow: 0 10rpx 18rpx rgba(97, 56, 49, 0.1);
  font-size: 18rpx;
  line-height: 1;
  font-weight: 900;
}

.poster-chat-bubble {
  max-width: 578rpx;
  padding: 22rpx 26rpx;
  border-radius: 30rpx;
  color: #251b18;
  background: #fff8ef;
  border: 1rpx solid rgba(216, 200, 187, 0.86);
  box-shadow:
    0 14rpx 28rpx rgba(55, 42, 36, 0.06),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.72);
}

.poster-chat-message.is-ai .poster-chat-bubble {
  border-top-left-radius: 14rpx;
}

.poster-chat-message.is-user .poster-chat-bubble {
  color: #fff8ef;
  background: #a86a5f;
  border-color: rgba(168, 106, 95, 0.86);
  border-top-right-radius: 14rpx;
  box-shadow: 0 14rpx 28rpx rgba(107, 65, 58, 0.13);
}

.poster-chat-bubble.has-poster {
  width: 578rpx;
  padding: 18rpx;
}

.poster-chat-text {
  display: block;
  color: inherit;
  font-size: 27rpx;
  line-height: 1.58;
  font-weight: 600;
  word-break: break-word;
}

.poster-prompt-chips {
  margin-top: 18rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.poster-prompt-chips button {
  width: auto;
  max-width: 100%;
  height: 52rpx;
  margin: 0;
  padding: 0 20rpx;
  border: 1rpx solid rgba(216, 200, 187, 0.82);
  border-radius: 26rpx;
  color: #6e605a;
  background: #f8f0e8;
  font-size: 22rpx;
  line-height: 50rpx;
  font-weight: 700;
  text-align: left;
}

.poster-chat-image {
  display: block;
  width: 100%;
  margin-top: 12rpx;
  border-radius: 24rpx;
  background: #efe5d8;
}

.poster-inline-note,
.poster-inline-action,
.poster-result-panel,
.poster-error {
  margin-left: 68rpx;
  border-radius: 30rpx;
  border: 1rpx solid rgba(216, 200, 187, 0.82);
  background: rgba(248, 240, 232, 0.92);
  box-shadow: 0 12rpx 24rpx rgba(55, 42, 36, 0.04);
}

.poster-inline-note {
  min-height: 76rpx;
  padding: 12rpx 14rpx 12rpx 22rpx;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 142rpx;
  align-items: center;
  gap: 12rpx;
}

.poster-inline-note text {
  color: #6e605a;
  font-size: 23rpx;
  line-height: 1.35;
  font-weight: 700;
}

.poster-inline-note button {
  height: 52rpx;
  margin: 0;
  padding: 0 18rpx;
  border: 0;
  border-radius: 26rpx;
  color: #fff8ef;
  background: #a86a5f;
  font-size: 22rpx;
  line-height: 52rpx;
  font-weight: 800;
}

.poster-inline-action {
  padding: 24rpx;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 174rpx;
  align-items: center;
  gap: 18rpx;
}

.poster-inline-copy {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.poster-inline-title,
.poster-inline-desc {
  display: block;
}

.poster-inline-title {
  color: #251b18;
  font-size: 28rpx;
  line-height: 1.25;
  font-weight: 800;
}

.poster-inline-desc {
  color: #6e605a;
  font-size: 23rpx;
  line-height: 1.42;
  font-weight: 600;
}

.poster-generate-btn {
  height: 66rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 33rpx;
  color: #fff8ef;
  background: #a86a5f;
  box-shadow: 0 10rpx 20rpx rgba(107, 65, 58, 0.14);
  font-size: 24rpx;
  line-height: 66rpx;
  font-weight: 800;
}

.poster-result-panel {
  padding: 18rpx;
}

.poster-result-image {
  display: block;
  width: 100%;
  border-radius: 26rpx;
  background: #efe5d8;
}

.poster-result-actions {
  margin-top: 16rpx;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
}

.poster-result-actions button {
  min-width: 0;
  height: 60rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 30rpx;
  color: #6e605a;
  background: #efe4d9;
  font-size: 23rpx;
  line-height: 60rpx;
  font-weight: 800;
}

.poster-result-actions button.is-primary {
  color: #fff8ef;
  background: #a86a5f;
}

.status-text {
  min-height: 74rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  color: #4f403a;
}

.status-text text {
  display: block;
  color: inherit;
  font-size: 27rpx;
  line-height: 1.45;
  font-weight: 800;
}

.typing-dot {
  flex-shrink: 0;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #a86a5f;
  animation: posterPulse 1s ease-in-out infinite;
}

.poster-chat-message.is-user.is-voice-working .poster-chat-bubble {
  color: #fff8ef;
  background: #a86a5f;
  border-color: rgba(168, 106, 95, 0.9);
  box-shadow: 0 16rpx 30rpx rgba(107, 65, 58, 0.16);
}

.poster-chat-message.is-user.is-voice-working .typing-dot {
  background: #fff8ef;
  box-shadow: 0 0 0 6rpx rgba(255, 248, 239, 0.18);
}

.poster-chat-message.is-user.is-voice-working.is-canceling .poster-chat-bubble {
  background: #8f3928;
  border-color: rgba(143, 57, 40, 0.88);
}

.poster-error {
  padding: 18rpx 22rpx;
  color: #8f3928;
  background: #fff0eb;
  border-color: rgba(184, 86, 62, 0.2);
  font-size: 24rpx;
  line-height: 1.45;
  font-weight: 700;
}

.poster-composer {
  flex-shrink: 0;
  padding: 12rpx 24rpx calc(80rpx + env(safe-area-inset-bottom));
  background:
    linear-gradient(180deg, rgba(239, 229, 216, 0) 0rpx, rgba(239, 229, 216, 0.98) 18rpx, #efe5d8 100%);
}

.poster-compose-status {
  margin: 0 10rpx 12rpx;
  padding: 0 10rpx;
  color: #a86a5f;
  font-size: 22rpx;
  line-height: 1.4;
  font-weight: 800;
}

.poster-compose-row {
  min-height: 82rpx;
  padding: 10rpx;
  border-radius: 38rpx;
  display: grid;
  grid-template-columns: 60rpx minmax(0, 1fr) 140rpx 88rpx;
  align-items: center;
  gap: 10rpx;
  background: #fff8ef;
  border: 1rpx solid rgba(216, 200, 187, 0.9);
  box-shadow:
    0 16rpx 34rpx rgba(60, 44, 38, 0.12),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.76);
}

.poster-plus-btn,
.poster-send-btn,
.poster-voice-btn {
  height: 62rpx;
  border-radius: 31rpx;
  font-weight: 800;
}

.poster-plus-btn {
  width: 60rpx;
  color: #21191c;
  background: #f1e7dc;
  font-size: 34rpx;
  line-height: 58rpx;
}

.poster-draft-input {
  width: 100%;
  height: 62rpx;
  padding: 0 8rpx;
  color: #21191c;
  background: transparent;
  font-size: 24rpx;
  line-height: 62rpx;
  font-weight: 600;
}

.poster-input-placeholder {
  color: rgba(110, 96, 90, 0.5);
}

.poster-voice-btn {
  width: 140rpx;
  color: #6e605a;
  background: #f4eadf;
  font-size: 22rpx;
  line-height: 62rpx;
}

.poster-send-btn {
  width: 88rpx;
  color: #fff8ef;
  background: #a86a5f;
  font-size: 22rpx;
  line-height: 62rpx;
  box-shadow: 0 8rpx 18rpx rgba(107, 65, 58, 0.14);
}

.poster-voice-btn.is-recording {
  color: #fff8ef;
  background: #a86a5f;
}

.poster-voice-btn.is-canceling {
  color: #fff8ef;
  background: #8f3928;
}

button::after {
  border: none;
}

button[disabled] {
  opacity: 0.52;
}

button:active {
  opacity: 0.92;
}

@keyframes posterPulse {
  0%,
  100% {
    opacity: 0.35;
    transform: scale(0.9);
  }

  50% {
    opacity: 1;
    transform: scale(1);
  }
}
