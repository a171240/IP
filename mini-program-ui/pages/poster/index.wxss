.page-poster-chat {
  --poster-bg: #efe5d8;
  --poster-top: #21181c;
  --poster-top-soft: #33262b;
  --poster-paper: #f7efe6;
  --poster-paper-2: #fff8ef;
  --poster-ink: #211a17;
  --poster-ink-soft: #6f6259;
  --poster-muted: #9b8c82;
  --poster-line: rgba(96, 74, 66, 0.14);
  --poster-rose: #a86a5f;
  --poster-rose-deep: #86504a;
  --poster-sage: #7d8a71;
  min-height: 100vh;
  background: linear-gradient(180deg, var(--poster-top) 0rpx, var(--poster-top-soft) 300rpx, var(--poster-bg) 300rpx, #eee2d5 100%);
}

.page-poster-chat text,
.page-poster-chat input,
.page-poster-chat button {
  font-family: "HarmonyOS Sans", "Alibaba PuHuiTi 2.0", "PingFang SC", "Microsoft YaHei", sans-serif;
  letter-spacing: 0;
  box-sizing: border-box;
}

.chat-shell {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 34rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.chat-top {
  flex-shrink: 0;
  padding: 30rpx 30rpx 26rpx;
  border-radius: 34rpx;
  color: #f8f0e7;
  background: linear-gradient(180deg, rgba(45, 33, 39, 0.98) 0%, rgba(31, 23, 27, 0.98) 100%);
  border: 1rpx solid rgba(244, 226, 218, 0.10);
  box-shadow:
    0 18rpx 34rpx rgba(31, 19, 23, 0.18),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.06);
}

.top-copy {
  display: flex;
  flex-direction: column;
}

.top-kicker {
  color: rgba(232, 211, 201, 0.82);
  font-size: 20rpx;
  line-height: 1.2;
  font-weight: 800;
}

.top-title {
  margin-top: 10rpx;
  color: #fff9f1;
  font-size: 44rpx;
  line-height: 1.14;
  font-weight: 800;
}

.top-subtitle {
  margin-top: 12rpx;
  color: rgba(244, 235, 226, 0.76);
  font-size: 24rpx;
  line-height: 1.5;
  font-weight: 500;
}

.store-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 24rpx;
  padding: 18rpx 18rpx 18rpx 22rpx;
  border-radius: 26rpx;
  background: rgba(255, 245, 236, 0.08);
  border: 1rpx solid rgba(244, 226, 218, 0.12);
}

.store-copy {
  min-width: 0;
  flex: 1;
}

.store-label,
.store-name {
  display: block;
}

.store-label {
  color: rgba(232, 211, 201, 0.70);
  font-size: 18rpx;
  line-height: 1.2;
  font-weight: 700;
}

.store-name {
  margin-top: 6rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  color: #fff9f1;
  font-size: 25rpx;
  line-height: 1.35;
  font-weight: 800;
}

.store-btn {
  flex-shrink: 0;
  min-width: 104rpx;
  height: 58rpx;
  margin: 0;
  padding: 0 20rpx;
  border-radius: 18rpx;
  color: #fff9f1;
  background: rgba(168, 106, 95, 0.92);
  border: 0;
  font-size: 22rpx;
  line-height: 58rpx;
  font-weight: 800;
}

.chat-list {
  flex: 1;
  height: 0;
  margin: 18rpx -6rpx 16rpx;
  padding: 0 6rpx;
  box-sizing: border-box;
}

.chat-spacer {
  height: 12rpx;
}

.chat-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 18rpx;
}

.chat-row.is-user {
  justify-content: flex-end;
}

.chat-avatar {
  flex-shrink: 0;
  width: 50rpx;
  height: 50rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff8f0;
  background: linear-gradient(180deg, #aa7567 0%, #86504a 100%);
  font-size: 18rpx;
  line-height: 50rpx;
  font-weight: 900;
}

.chat-bubble {
  max-width: 560rpx;
  padding: 20rpx 22rpx;
  border-radius: 26rpx;
  background: rgba(255, 249, 242, 0.94);
  border: 1rpx solid var(--poster-line);
  box-shadow:
    0 10rpx 22rpx rgba(78, 59, 52, 0.06),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.66);
}

.is-user .chat-bubble {
  color: #fff9f1;
  background: linear-gradient(180deg, #a86a5f 0%, #86504a 100%);
  border-color: rgba(255, 241, 235, 0.14);
  box-shadow: 0 12rpx 24rpx rgba(132, 80, 74, 0.12);
}

.chat-bubble.is-status {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: var(--poster-ink-soft);
}

.chat-bubble.is-poster {
  width: 566rpx;
  max-width: 566rpx;
  padding: 20rpx;
}

.chat-text {
  display: block;
  color: var(--poster-ink);
  font-size: 27rpx;
  line-height: 1.58;
  font-weight: 600;
  word-break: break-word;
}

.is-user .chat-text {
  color: #fff9f1;
}

.poster-message {
  margin-top: 16rpx;
}

.poster-message-image {
  display: block;
  width: 100%;
  border-radius: 22rpx;
  background: #dacabc;
  box-shadow: 0 14rpx 32rpx rgba(78, 59, 52, 0.12);
}

.poster-actions {
  display: grid;
  grid-template-columns: 1fr 1fr 0.8fr;
  gap: 10rpx;
  margin-top: 16rpx;
}

.ghost-btn,
.solid-btn {
  min-width: 0;
  height: 68rpx;
  margin: 0;
  padding: 0 8rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  line-height: 68rpx;
  font-weight: 800;
}

.ghost-btn {
  color: var(--poster-ink);
  background: rgba(247, 239, 230, 0.88);
  border: 1rpx solid rgba(108, 82, 74, 0.12);
}

.solid-btn {
  color: #fff9f1;
  background: linear-gradient(180deg, #a86a5f 0%, #86504a 100%);
  border: 0;
}

.typing-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 999rpx;
  background: var(--poster-sage);
  box-shadow: 22rpx 0 0 rgba(125, 138, 113, 0.55), 44rpx 0 0 rgba(125, 138, 113, 0.25);
}

.error-line {
  margin: 18rpx 50rpx 0 62rpx;
  padding: 16rpx 18rpx;
  border-radius: 20rpx;
  color: #8f3928;
  background: #fff0eb;
  border: 1rpx solid rgba(184, 86, 62, 0.20);
  font-size: 23rpx;
  line-height: 1.45;
  font-weight: 600;
}

.bottom-spacer {
  height: 18rpx;
}

.input-panel {
  flex-shrink: 0;
  padding: 16rpx;
  border-radius: 30rpx;
  background: rgba(255, 248, 240, 0.96);
  border: 1rpx solid rgba(108, 82, 74, 0.12);
  box-shadow:
    0 -4rpx 18rpx rgba(80, 59, 51, 0.05),
    0 12rpx 24rpx rgba(80, 59, 51, 0.08),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.72);
}

.text-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.chat-input {
  min-width: 0;
  flex: 1;
  height: 72rpx;
  padding: 0 22rpx;
  border-radius: 22rpx;
  color: var(--poster-ink);
  background: #f1e7dc;
  border: 1rpx solid rgba(108, 82, 74, 0.10);
  font-size: 25rpx;
  line-height: 72rpx;
}

.send-btn {
  flex-shrink: 0;
  width: 112rpx;
  height: 72rpx;
  margin: 0;
  padding: 0;
  border-radius: 22rpx;
  color: #fff9f1;
  background: linear-gradient(180deg, #a86a5f 0%, #86504a 100%);
  border: 0;
  font-size: 24rpx;
  line-height: 72rpx;
  font-weight: 900;
}

.voice-btn {
  width: 100%;
  height: 88rpx;
  margin: 14rpx 0 0;
  padding: 0;
  border-radius: 24rpx;
  color: #fff9f1;
  background: linear-gradient(180deg, #2f2528 0%, #21191c 100%);
  border: 0;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.08);
  font-size: 29rpx;
  line-height: 88rpx;
  font-weight: 900;
}

.voice-btn.is-recording {
  background: linear-gradient(180deg, #a86a5f 0%, #86504a 100%);
}

.voice-btn.is-canceling {
  background: linear-gradient(180deg, #9b4c3d 0%, #7f362c 100%);
}

button::after {
  border: none;
}

button[disabled] {
  opacity: 0.58;
}

button:active,
.store-row:active,
.chat-bubble:active {
  opacity: 0.94;
}

@media (max-width: 420rpx) {
  .chat-bubble,
  .chat-bubble.is-poster {
    max-width: 500rpx;
    width: auto;
  }

  .poster-actions {
    grid-template-columns: 1fr;
  }
}
