<view class="page page-poster-chat">
  <view class="chat-shell">
    <view class="chat-top">
      <view class="top-copy">
        <text class="top-kicker">海报助手</text>
        <text class="top-title">说需求，直接出图</text>
        <text class="top-subtitle">我会追问缺的信息，够了就自动生成。</text>
      </view>

      <view class="store-row">
        <view class="store-copy">
          <text class="store-label">当前门店</text>
          <text class="store-name">{{storeProfileLabel}}</text>
        </view>
        <button class="store-btn" bindtap="handleOpenStoreProfiles">{{storeProfileId ? '切换' : '选择'}}</button>
      </view>
    </view>

    <scroll-view
      class="chat-list"
      scroll-y
      scroll-with-animation
      scroll-into-view="{{chatScrollIntoView}}"
      enhanced="{{true}}"
      show-scrollbar="{{false}}"
    >
      <view class="chat-spacer"></view>

      <block wx:for="{{chatMessages}}" wx:key="id">
        <view id="{{item.id}}" class="chat-row {{item.role === 'user' ? 'is-user' : 'is-assistant'}}">
          <view class="chat-avatar" wx:if="{{item.role !== 'user'}}">AI</view>
          <view class="chat-bubble {{item.type === 'poster' ? 'is-poster' : ''}}">
            <text wx:if="{{item.text}}" class="chat-text">{{item.text}}</text>
            <view wx:if="{{item.type === 'poster' && item.imageUrl}}" class="poster-message">
              <image class="poster-message-image" src="{{item.imageUrl}}" mode="widthFix" />
              <view class="poster-actions">
                <button class="ghost-btn" data-strict="1" bindtap="handleGenerate" loading="{{isGenerating}}">修正文字</button>
                <button class="ghost-btn" bindtap="handleGenerate" loading="{{isGenerating}}">重做一张</button>
                <button class="solid-btn" bindtap="handleSavePoster" loading="{{isSaving}}">保存</button>
              </view>
            </view>
          </view>
        </view>
      </block>

      <view wx:if="{{workingText}}" id="msg_working" class="chat-row is-assistant">
        <view class="chat-avatar">AI</view>
        <view class="chat-bubble is-status">
          <view class="typing-dot"></view>
          <text class="chat-text">{{workingText}}</text>
        </view>
      </view>

      <view wx:if="{{lastError}}" class="error-line">{{lastError}}</view>
      <view class="bottom-spacer"></view>
    </scroll-view>

    <view class="input-panel">
      <view class="text-row">
        <input
          class="chat-input"
          value="{{draftText}}"
          placeholder="也可以打字，例如：五一新客补水99元"
          confirm-type="send"
          bindinput="onDraftInput"
          bindconfirm="handleSendText"
        />
        <button class="send-btn" bindtap="handleSendText" disabled="{{!draftText || conversationLoading || isGenerating}}">发送</button>
      </view>

      <button
        class="voice-btn {{recording ? 'is-recording' : ''}} {{recordCanceling ? 'is-canceling' : ''}}"
        bindtouchstart="onRecordStart"
        bindtouchmove="onRecordMove"
        bindtouchend="onRecordEnd"
        bindtouchcancel="onRecordCancel"
        disabled="{{conversationLoading || transcribing || isGenerating}}"
      >
        {{recording ? (recordCanceling ? '松手取消' : '松开发送') : (transcribing ? '正在识别' : '按住说话')}}
      </button>
    </view>
  </view>
</view>
