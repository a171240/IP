@import "../theme.wxss";

.vc-library-minimal .container {
  padding-top: 36rpx;
}

.vc-library-minimal .compact-hero {
  padding: 20rpx 18rpx;
}

.vc-library-minimal .library-item-card + .library-item-card {
  margin-top: 10rpx;
}

.vc-library-minimal .library-item-meta {
  margin-top: 10rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.vc-library-minimal .library-item-line {
  font-size: 21rpx;
  line-height: 1.42;
  color: var(--vc-text-muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.vc-library-minimal .hero-actions {
  margin-top: 16rpx;
  gap: 10rpx;
}

.vc-library-minimal .library-item-card {
  gap: 14rpx;
}

.vc-library-minimal .muted.small {
  display: block;
  margin-top: 2rpx;
  white-space: normal;
  overflow: visible;
  text-overflow: clip;
}

.vc-library-minimal .library-item-line {
  white-space: normal;
  overflow: visible;
  text-overflow: clip;
}

.vc-library-minimal .library-item-meta .library-item-line + .library-item-line {
  display: block;
}
