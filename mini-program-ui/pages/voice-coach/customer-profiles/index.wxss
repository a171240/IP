@import "../theme.wxss";

page {
  position: fixed;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #efe5d8;
}

.vc-page.vc-library-v2 {
  background: #efe5d8;
}

.vc-library-v2 .container {
  min-height: 100%;
  padding: 36rpx 42rpx calc(64rpx + env(safe-area-inset-bottom));
  background: #efe5d8;
}

.vc-library-v2 view,
.vc-library-v2 text,
.vc-library-v2 button {
  box-sizing: border-box;
  letter-spacing: 0;
}

.library-top {
  padding: 20rpx 0 26rpx;
}

.library-top-copy {
  display: flex;
  flex-direction: column;
}

.library-eyebrow {
  align-self: flex-start;
  min-height: 40rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  display: inline-flex;
  align-items: center;
  color: #526149;
  background: #edf4e8;
  border: 1rpx solid rgba(130, 148, 116, 0.18);
  font-size: 21rpx;
  line-height: 40rpx;
  font-weight: 800;
}

.library-title {
  display: block;
  margin-top: 26rpx;
  color: #281f1c;
  font-size: 50rpx;
  line-height: 1.2;
  font-weight: 800;
}

.library-subtitle {
  display: block;
  margin-top: 18rpx;
  max-width: 620rpx;
  color: #6e605a;
  font-size: 24rpx;
  line-height: 1.62;
  font-weight: 500;
}

.library-top-actions {
  margin-top: 28rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.library-top-actions button {
  width: 100%;
  min-height: 82rpx;
  border-radius: 41rpx;
  font-size: 25rpx;
  font-weight: 800;
}

.vc-library-v2 .library-top-actions .btn-primary {
  color: #fff8ef;
  background: #7f8d72;
}

.vc-library-v2 .library-top-actions .btn-outline {
  color: #3f352f;
  background: #f8f1e8;
  border: 1rpx solid rgba(177, 153, 139, 0.42);
}

.vc-page.vc-library-v2 .summary-card {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 18rpx;
  padding: 34rpx 32rpx;
  border-radius: 34rpx;
  background: #f8f1e8;
  border: 1rpx solid #d8c8bb;
  box-shadow:
    0 14rpx 28rpx rgba(40, 31, 28, 0.07),
    inset 0 1rpx 0 rgba(244, 236, 228, 0.82);
}

.vc-library-v2 .summary-card .hero-actions {
  margin-top: 2rpx;
}

.vc-library-v2 .summary-card .hero-actions > button {
  width: auto;
  flex: 0 0 auto;
  min-width: 240rpx;
}

.vc-page.vc-library-v2 .library-item-card {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 18rpx;
  padding: 30rpx 28rpx;
  border-radius: 34rpx;
  background: #f8f1e8;
  border: 1rpx solid #d8c8bb;
  box-shadow:
    0 14rpx 28rpx rgba(40, 31, 28, 0.07),
    inset 0 1rpx 0 rgba(244, 236, 228, 0.82);
}

.vc-library-v2 .library-item-card:first-of-type {
  margin-top: 18rpx;
}

.library-item-head {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}

.library-avatar {
  width: 62rpx;
  height: 62rpx;
  border-radius: 50%;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff8ef;
  background: #b98a7f;
  border: 4rpx solid #efe4d9;
  box-shadow: 0 10rpx 18rpx rgba(73, 57, 49, 0.08);
  font-size: 22rpx;
  line-height: 1;
  font-weight: 800;
}

.vc-library-v2 .selection-copy {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
  gap: 8rpx;
  padding-right: 8rpx;
}

.vc-page.vc-library-v2 .selection-copy .card-title {
  font-size: 31rpx;
  line-height: 1.2;
}

.vc-page.vc-library-v2 .muted.small {
  font-size: 22rpx;
  line-height: 1.56;
}

.vc-page.vc-library-v2 .library-item-meta {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding: 18rpx 20rpx;
  border-radius: 24rpx;
  background: #fff8ef;
  border: 1rpx solid rgba(216, 200, 187, 0.8);
}

.vc-page.vc-library-v2 .library-item-line {
  font-size: 22rpx;
  line-height: 1.58;
  color: var(--vc-flow-ink-soft);
}

.vc-library-v2 .hero-actions.compact-actions {
  margin-top: 16rpx;
  gap: 12rpx;
}

.vc-library-v2 .library-item-card .hero-actions {
  margin-top: 0;
}

.vc-library-v2 .library-item-card .hero-actions > button {
  width: auto;
  flex: 1 1 0;
  min-width: 0;
}

.vc-page.vc-library-v2 button[size="mini"].btn-primary,
.vc-page.vc-library-v2 button[size="mini"].btn-outline {
  min-height: 58rpx;
  border-radius: 18rpx;
  font-size: 21rpx;
}

.vc-page.vc-library-v2 .library-actions button[size="mini"].btn-primary {
  color: #fff8ef;
  background: #7f8d72;
}

.vc-page.vc-library-v2 .library-actions button[size="mini"].btn-outline {
  color: #3f352f;
  background: #efe4d9;
  border: 1rpx solid rgba(177, 153, 139, 0.42);
}
