<view class="vc-page vc-library-page vc-flow-v2 vc-library-v2">
  <view class="vc-page-scroll-shell">
    <scroll-view class="page-scroll" scroll-y="true" enhanced="true" bounces="false" show-scrollbar="false">
      <view class="container">
      <view class="library-top fade-up">
        <view class="library-top-copy">
          <text class="library-eyebrow">顾客资料库</text>
          <text class="library-title">顾客档案</text>
          <text class="library-subtitle">选真实顾客，或者先生成一位模拟顾客。</text>
        </view>

        <view class="library-top-actions">
          <button class="btn-primary" bindtap="handleCreate">新建档案</button>
          <button
            class="btn-outline"
            loading="{{creatingTestProfile}}"
            disabled="{{creatingTestProfile}}"
            bindtap="handleUseTestProfile"
          >模拟顾客</button>
        </view>
      </view>

      <view wx:if="{{loading}}" class="summary-card fade-up delay-1">
        <text class="empty-copy">正在加载顾客档案...</text>
      </view>

      <view wx:if="{{!loading && !profiles.length}}" class="summary-card fade-up delay-1">
        <text class="empty-title">还没有顾客档案</text>
        <text class="empty-copy">可以先生成模拟顾客，回到话术页后直接开始训练。</text>
        <view class="hero-actions compact-actions">
          <button
            class="btn-primary"
            loading="{{creatingTestProfile}}"
            disabled="{{creatingTestProfile}}"
            bindtap="handleUseTestProfile"
          >生成模拟顾客</button>
        </view>
      </view>

      <view wx:for="{{profiles}}" wx:key="id" class="card library-item-card fade-up delay-1">
        <view class="library-item-head">
          <view class="library-avatar">客</view>
          <view class="selection-copy">
            <text class="card-title">{{item.name}}</text>
            <text wx:if="{{item.metaLabel}}" class="muted small">{{item.metaLabel}}</text>
          </view>
          <text class="tag {{selectedId === item.id ? 'tag-success' : 'tag-accent'}}">{{selectedId === item.id ? '当前' : '档案'}}</text>
        </view>

        <view class="library-item-meta" wx:if="{{item.concernLabel || item.trustLabel}}">
          <text wx:if="{{item.concernLabel}}" class="library-item-line">顾虑：{{item.concernLabel}}</text>
          <text wx:if="{{item.trustLabel}}" class="library-item-line">信任：{{item.trustLabel}}</text>
        </view>

        <view class="hero-actions compact-actions library-actions">
          <button class="btn-primary" size="mini" data-id="{{item.id}}" catchtap="handleUse">{{pickMode ? '选用' : '设为当前'}}</button>
          <button class="btn-outline" size="mini" data-id="{{item.id}}" catchtap="handleEdit">编辑</button>
          <button class="btn-outline" size="mini" data-id="{{item.id}}" catchtap="handleDelete">删除</button>
        </view>
      </view>
      </view>
    </scroll-view>
  </view>
</view>
