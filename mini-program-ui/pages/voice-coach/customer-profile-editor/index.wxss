@import "../theme.wxss";

.vc-editor-page .container {
  padding-top: 28rpx;
}

.vc-editor-page .hero {
  padding: 22rpx 20rpx;
}

.vc-editor-page .card {
  gap: 18rpx;
}

.vc-editor-page .field-stack {
  gap: 18rpx;
}

.vc-editor-page .field-help {
  display: block;
}

.vc-editor-page .textarea {
  min-height: 176rpx;
}

.vc-editor-page .footer-cta-card {
  background:
    radial-gradient(130% 150% at 0% 0%, rgba(215, 191, 150, 0.1) 0%, rgba(255, 255, 255, 0) 52%),
    linear-gradient(180deg, rgba(18, 23, 31, 0.98) 0%, rgba(11, 14, 20, 0.98) 100%);
}
