@import "../theme.wxss";

page {
  position: fixed;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #efe5d8;
}

.vc-page.vc-editor-v2 {
  background: #efe5d8;
}

.vc-editor-v2 .container {
  min-height: 100%;
  padding: 36rpx 42rpx calc(64rpx + env(safe-area-inset-bottom));
  background: #efe5d8;
}

.vc-editor-v2 view,
.vc-editor-v2 text,
.vc-editor-v2 input,
.vc-editor-v2 textarea,
.vc-editor-v2 button {
  box-sizing: border-box;
  letter-spacing: 0;
}

.editor-top {
  padding: 20rpx 0 28rpx;
}

.editor-eyebrow {
  align-self: flex-start;
  min-height: 40rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  display: inline-flex;
  align-items: center;
  color: #526149;
  background: #edf4e8;
  border: 1rpx solid rgba(130, 148, 116, 0.18);
  font-size: 21rpx;
  line-height: 40rpx;
  font-weight: 800;
}

.editor-title {
  display: block;
  margin-top: 26rpx;
  color: #281f1c;
  font-size: 42rpx;
  line-height: 1.28;
  font-weight: 800;
}

.editor-subtitle {
  display: block;
  margin-top: 18rpx;
  max-width: 620rpx;
  color: #6e605a;
  font-size: 24rpx;
  line-height: 1.62;
  font-weight: 500;
}

.vc-page.vc-editor-v2 .section {
  margin-top: 26rpx;
}

.vc-page.vc-editor-v2 .section-head {
  margin-bottom: 16rpx;
}

.vc-page.vc-editor-v2 .section-kicker {
  display: inline-flex;
  min-height: 36rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  align-items: center;
  color: #526149;
  background: #edf4e8;
  font-size: 19rpx;
  line-height: 36rpx;
  font-weight: 800;
}

.vc-page.vc-editor-v2 .section-title {
  margin-top: 14rpx;
  margin-bottom: 0;
  color: #281f1c;
  font-size: 32rpx;
  line-height: 1.28;
  font-weight: 800;
}

.vc-page.vc-editor-v2 .card {
  padding: 30rpx 28rpx;
  border-radius: 34rpx;
  background: #f8f1e8;
  border: 1rpx solid #d8c8bb;
  box-shadow:
    0 14rpx 28rpx rgba(40, 31, 28, 0.07),
    inset 0 1rpx 0 rgba(244, 236, 228, 0.82);
}

.vc-page.vc-editor-v2 .field-stack {
  gap: 28rpx;
}

.vc-page.vc-editor-v2 .field-block {
  gap: 14rpx;
}

.vc-page.vc-editor-v2 .field-label {
  color: #281f1c;
  font-size: 25rpx;
  line-height: 1.3;
  font-weight: 800;
}

.vc-page.vc-editor-v2 .field-help {
  display: block;
  color: #8a7b72;
  font-size: 21rpx;
  line-height: 1.48;
  font-weight: 500;
}

.vc-page.vc-editor-v2 .input,
.vc-page.vc-editor-v2 .picker-input {
  min-height: 86rpx;
  padding: 0 24rpx;
  border-radius: 24rpx;
  color: #281f1c;
  background: #fff8ef;
  border: 1rpx solid rgba(216, 200, 187, 0.9);
  box-shadow: inset 0 1rpx 0 rgba(248, 241, 232, 0.7);
  font-size: 24rpx;
  line-height: 86rpx;
  font-weight: 600;
}

.vc-page.vc-editor-v2 .textarea {
  min-height: 174rpx;
  padding: 22rpx 24rpx;
  line-height: 1.52;
}

.vc-page.vc-editor-v2 .footer-cta-card {
  padding: 28rpx;
  border-radius: 34rpx;
  background: #f8f1e8;
  border: 1rpx solid #d8c8bb;
  box-shadow:
    0 14rpx 28rpx rgba(40, 31, 28, 0.07),
    inset 0 1rpx 0 rgba(244, 236, 228, 0.82);
}

.vc-page.vc-editor-v2 .footer-cta-card .btn-primary {
  margin-top: 18rpx;
  color: #fff8ef;
  background: #7f8d72;
  min-height: 86rpx;
  border-radius: 43rpx;
  font-size: 26rpx;
  font-weight: 800;
}
