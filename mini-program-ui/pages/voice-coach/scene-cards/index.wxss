@import "../theme.wxss";

page {
  position: fixed;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

.vc-library-v2 .container {
  padding-top: 36rpx;
}

.vc-library-v2 .hero.compact-hero {
  padding-bottom: 24rpx;
}

.vc-library-v2 .hero .subtitle {
  max-width: 620rpx;
}

.vc-library-v2 .summary-card {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.vc-library-v2 .summary-card .hero-actions {
  margin-top: 2rpx;
}

.vc-library-v2 .summary-card .hero-actions > button {
  width: auto;
  flex: 0 0 auto;
  min-width: 240rpx;
}

.vc-library-v2 .library-item-card {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.vc-library-v2 .selection-copy {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding-right: 12rpx;
}

.vc-library-v2 .selection-copy .card-title {
  font-size: 31rpx;
  line-height: 1.2;
}

.vc-library-v2 .muted.small {
  font-size: 22rpx;
  line-height: 1.56;
}

.vc-library-v2 .library-item-meta {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid rgba(115, 92, 82, 0.08);
}

.vc-library-v2 .library-item-line {
  font-size: 22rpx;
  line-height: 1.58;
  color: var(--vc-flow-ink-soft);
}

.vc-library-v2 .hero-actions.compact-actions {
  margin-top: 18rpx;
  gap: 10rpx;
}

.vc-library-v2 .library-item-card .hero-actions {
  margin-top: 2rpx;
}

.vc-library-v2 .library-item-card .hero-actions > button {
  width: auto;
  flex: 0 0 auto;
}

.vc-library-v2 button[size="mini"].btn-primary,
.vc-library-v2 button[size="mini"].btn-outline {
  min-height: 58rpx;
  border-radius: 18rpx;
  font-size: 21rpx;
}
