<view class="vc-page vc-library-page vc-flow-v2 vc-library-v2">
  <view class="vc-page-scroll-shell">
    <scroll-view class="page-scroll" scroll-y="true" enhanced="true" bounces="false" show-scrollbar="false">
      <view class="container">
      <view class="scene-library-top fade-up">
        <view class="scene-library-top-copy">
          <text class="scene-library-eyebrow">项目启动</text>
          <text class="scene-library-title">项目卡</text>
          <text class="scene-library-subtitle">把新项目的专业知识、推荐话术和拒绝应对整理成一张训练卡。</text>
        </view>

        <view class="scene-library-actions">
          <button class="btn-primary" bindtap="handleCreate">新建项目</button>
          <button
            class="btn-outline"
            loading="{{creatingTestCard}}"
            disabled="{{creatingTestCard}}"
            bindtap="handleUseTestCard"
          >示例项目</button>
        </view>
      </view>

      <view wx:if="{{loading}}" class="summary-card fade-up delay-1">
        <text class="empty-copy">正在加载项目卡...</text>
      </view>

      <view wx:if="{{!loading && !cards.length}}" class="summary-card fade-up delay-1">
        <text class="empty-title">还没有项目卡</text>
        <text class="empty-copy">可以先生成示例项目，看看新项目启动训练应该怎么整理。</text>
        <view class="hero-actions compact-actions">
          <button
            class="btn-outline"
            loading="{{creatingTestCard}}"
            disabled="{{creatingTestCard}}"
            bindtap="handleUseTestCard"
          >生成示例项目</button>
          <button class="btn-primary" bindtap="handleCreate">新建项目</button>
        </view>
      </view>

      <view wx:for="{{cards}}" wx:key="id" class="card library-item-card scene-item-card fade-up delay-1">
        <view class="scene-item-head">
          <view class="scene-icon">项</view>
          <view class="selection-copy">
            <text class="card-title">{{item.displayName || item.name}}</text>
            <text wx:if="{{item.metaLabel}}" class="muted small">{{item.metaLabel}}</text>
          </view>
          <text class="tag {{selectedId === item.id ? 'tag-success' : 'tag-accent'}}">{{selectedId === item.id ? '当前' : '项目'}}</text>
        </view>

        <text wx:if="{{item.simplePitch}}" class="project-card-pitch">{{item.simplePitch}}</text>

        <view class="project-card-tags">
          <text wx:for="{{item.packTags}}" wx:key="*this" class="project-card-tag">{{item}}</text>
        </view>

        <view class="hero-actions compact-actions scene-card-actions">
          <button class="btn-primary" size="mini" data-id="{{item.id}}" catchtap="handleUse">{{pickMode ? '选用' : '设为项目'}}</button>
          <button class="btn-outline" size="mini" data-id="{{item.id}}" catchtap="handleEdit">编辑</button>
        </view>
      </view>
      </view>
    </scroll-view>
  </view>
</view>
