@import "theme.wxss";

.vc-home-minimal .container {
  padding-top: 40rpx;
}

.vc-home-minimal .compact-hero {
  padding: 24rpx 22rpx;
}

.vc-home-minimal .quick-launch-card {
  margin-top: 18rpx;
  padding-top: 0;
  border-top: none;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.vc-home-minimal .quick-launch-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #f5f3ef;
}

.vc-home-minimal .quick-launch-note {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--vc-text-muted);
}

.vc-home-minimal .minimal-section-head {
  display: none;
}

.vc-home-minimal .minimal-grid {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.vc-home-minimal .minimal-action-card {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-height: 0;
}

.vc-home-minimal .minimal-action-kicker {
  display: none;
}

.vc-home-minimal .minimal-action-copy {
  display: none;
}

.vc-home-minimal .minimal-action-link {
  display: none;
}

.vc-home-minimal .eyebrow {
  display: none;
}

.vc-home-minimal .subtitle {
  font-size: 23rpx;
  line-height: 1.5;
}
