@import "theme.wxss";

.vc-home-minimal .container {
  padding-top: 40rpx;
}

.vc-home-minimal .compact-hero {
  padding: 30rpx 26rpx;
}

.vc-home-minimal .quick-launch-card {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.08);
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.vc-home-minimal .quick-launch-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #f5f3ef;
}

.vc-home-minimal .quick-launch-note {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--vc-text-muted);
}

.vc-home-minimal .minimal-section-head {
  margin-bottom: 16rpx;
}

.vc-home-minimal .minimal-grid {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.vc-home-minimal .minimal-action-card {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-height: 0;
}

.vc-home-minimal .minimal-action-kicker {
  font-size: 18rpx;
  line-height: 1;
  letter-spacing: 1.8rpx;
  text-transform: uppercase;
  color: rgba(215, 191, 150, 0.72);
}

.vc-home-minimal .minimal-action-copy {
  font-size: 23rpx;
  line-height: 1.58;
  color: var(--vc-text-muted);
}

.vc-home-minimal .minimal-action-link {
  margin-top: 6rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--vc-gold);
}
