@import "theme.wxss";

page {
  position: fixed;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background-color: #21261f;
}

.vc-home-v2,
.vc-home-v2 .vc-page-scroll-shell,
.vc-home-v2 .page-scroll {
  height: 100%;
  overflow: hidden;
}

.vc-home-focus {}

.vc-home-v2 {
  background: #e7dccf;
}

.vc-home-v2 .container {
  padding-top: 48rpx;
  padding-bottom: calc(188rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(120% 120% at 0% 0%, rgba(173, 188, 160, 0.16) 0%, rgba(35, 40, 34, 0) 42%),
    radial-gradient(120% 140% at 100% 0%, rgba(126, 145, 111, 0.14) 0%, rgba(35, 40, 34, 0) 38%),
    linear-gradient(180deg, #21261f 0rpx, #21261f 600rpx, #e7dccf 600rpx, #ece1d5 100%);
}

.vc-home-v2 .vc-home-hero-v2 {
  min-height: 684rpx;
  padding: 48rpx 38rpx 38rpx;
  border-radius: 42rpx;
  background:
    radial-gradient(120% 130% at 100% 0%, rgba(137, 152, 123, 0.06) 0%, rgba(255, 255, 255, 0) 52%),
    linear-gradient(180deg, rgba(34, 39, 32, 0.98) 0%, rgba(27, 32, 26, 0.99) 100%);
  border: 1rpx solid rgba(208, 220, 197, 0.10);
  box-shadow:
    0 18rpx 36rpx rgba(17, 22, 16, 0.22),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.05);
}

.vc-home-v2 .vc-home-copy {
  display: flex;
  flex-direction: column;
}

.vc-home-v2 .eyebrow {
  width: auto;
  align-self: flex-start;
  min-height: 42rpx;
  padding: 0 18rpx;
  margin-bottom: 18rpx;
  border-radius: 20rpx;
  color: rgba(242, 236, 227, 0.86);
  border-color: rgba(214, 226, 203, 0.18);
  background: rgba(255, 255, 255, 0.06);
  font-size: 18rpx;
  line-height: 42rpx;
  letter-spacing: 1.5rpx;
}

.vc-home-v2 .title {
  margin-bottom: 16rpx;
  font-size: 54rpx;
  line-height: 1.14;
  font-family: var(--vc-font-display);
  font-weight: 700;
  letter-spacing: -0.9rpx;
  color: #f7f2ea;
}

.vc-home-v2 .subtitle {
  display: block;
  max-width: 15em;
  font-size: 23rpx;
  line-height: 1.76;
  font-weight: 500;
  color: rgba(237, 232, 223, 0.78);
}

.vc-home-band-v2 {
  margin-top: 38rpx;
  padding: 38rpx 34rpx 36rpx;
  border-radius: 40rpx;
  background:
    radial-gradient(110% 110% at 50% 0%, rgba(255, 255, 255, 0.03) 0%, rgba(255, 255, 255, 0) 54%),
    linear-gradient(180deg, rgba(138, 152, 123, 0.96) 0%, rgba(111, 124, 96, 0.98) 100%);
  border: 1rpx solid rgba(208, 220, 197, 0.18);
  box-shadow:
    0 14rpx 24rpx rgba(37, 47, 35, 0.14),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.10);
}

.vc-home-band-copy {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.vc-band-label {
  display: inline-flex;
  align-items: center;
  font-size: 17rpx;
  line-height: 1;
  font-weight: 700;
  letter-spacing: 1.6rpx;
  color: rgba(245, 240, 232, 0.72);
}

.vc-band-label::before {
  content: "";
  width: 34rpx;
  height: 2rpx;
  margin-right: 10rpx;
  border-radius: 999rpx;
  background: rgba(245, 240, 232, 0.54);
}

.vc-band-title {
  display: block;
  max-width: 12.8em;
  font-size: 42rpx;
  line-height: 1.16;
  font-family: var(--vc-font-display);
  font-weight: 700;
  letter-spacing: -0.8rpx;
  color: #faf6ef;
}

.vc-band-note {
  display: block;
  max-width: 15em;
  font-size: 23rpx;
  line-height: 1.76;
  font-weight: 500;
  color: rgba(245, 240, 232, 0.82);
}

.vc-home-band-meta {
  margin-top: 22rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.vc-home-band-chip {
  display: inline-flex;
  align-items: center;
  min-height: 42rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: rgba(102, 116, 89, 0.26);
  border: 1rpx solid rgba(223, 234, 214, 0.16);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.08);
  font-size: 18rpx;
  font-weight: 700;
  color: rgba(247, 243, 236, 0.92);
}

.vc-home-v2 .vc-home-start-btn {
  margin-top: 24rpx;
  min-height: 86rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, rgba(140, 154, 125, 0.98) 0%, rgba(111, 124, 97, 1) 100%);
  color: #fbf7f0;
  box-shadow:
    0 10rpx 18rpx rgba(49, 63, 45, 0.14),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.08);
}

.vc-home-v2 .section {
  margin-top: 80rpx;
}

.vc-home-v2 .section-head {
  padding: 0 34rpx;
}

.vc-home-v2 .section-head .section-title {
  font-size: 40rpx;
  line-height: 1.12;
  font-family: var(--vc-font-ui);
  font-weight: 700;
  letter-spacing: -0.8rpx;
  color: var(--vc-flow-ink);
}

.vc-home-v2 .section-head .section-caption {
  display: block;
  max-width: 22em;
  font-size: 21rpx;
  line-height: 1.72;
  font-weight: 500;
  color: var(--vc-flow-ink-soft);
  opacity: 1;
}

.vc-home-section-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 18rpx;
}

.vc-home-section-copy {
  flex: 1;
  min-width: 0;
}

.vc-home-section-pill {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  min-height: 42rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: rgba(234, 226, 217, 0.88);
  border: 1rpx solid rgba(145, 125, 114, 0.12);
  box-shadow:
    0 6rpx 14rpx rgba(74, 58, 50, 0.05),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.46);
  font-size: 18rpx;
  font-weight: 700;
  color: rgba(126, 145, 111, 0.92);
}

.vc-home-v2 .card.vc-resource-panel-v2,
.vc-home-v2 .card.vc-recent-panel-v2 {
  padding: 34rpx;
  border-radius: 32rpx;
  background: linear-gradient(180deg, rgba(236, 224, 211, 0.98) 0%, rgba(227, 214, 200, 0.98) 100%);
  border: 1rpx solid rgba(108, 86, 77, 0.12);
  box-shadow:
    0 18rpx 30rpx rgba(71, 54, 47, 0.08),
    0 4rpx 10rpx rgba(71, 54, 47, 0.04),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.52);
}

.vc-resource-row {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.vc-resource-main {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.vc-resource-kicker {
  display: inline-flex;
  align-items: center;
  font-size: 16rpx;
  line-height: 1;
  font-weight: 700;
  letter-spacing: 1.2rpx;
  color: rgba(120, 140, 105, 0.92);
}

.vc-resource-kicker::before {
  content: "";
  width: 28rpx;
  height: 2rpx;
  margin-right: 8rpx;
  border-radius: 999rpx;
  background: rgba(120, 140, 105, 0.74);
}

.vc-resource-title,
.vc-recent-title {
  display: block;
  font-size: 34rpx;
  line-height: 1.18;
  font-family: var(--vc-font-ui);
  font-weight: 700;
  letter-spacing: -0.5rpx;
  color: var(--vc-flow-ink);
}

.vc-resource-copy,
.vc-recent-copy {
  display: block;
  font-size: 22rpx;
  line-height: 1.76;
  font-weight: 500;
  color: var(--vc-flow-ink-soft);
}

.vc-resource-chip,
.vc-recent-chip {
  display: inline-flex;
  align-items: center;
  min-height: 40rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: rgba(233, 224, 214, 0.90);
  border: 1rpx solid rgba(145, 125, 114, 0.12);
  box-shadow:
    0 4rpx 10rpx rgba(80, 64, 56, 0.04),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.48);
  font-size: 16rpx;
  font-weight: 700;
  color: rgba(114, 127, 102, 0.92);
}

.vc-resource-action,
.vc-recent-actions {
  display: flex;
  align-items: center;
  flex-wrap: nowrap;
  justify-content: space-between;
  width: 100%;
  gap: 14rpx 16rpx;
}

.vc-home-v2 .btn-outline.vc-inline-btn,
.vc-home-v2 .btn-outline.vc-recent-btn {
  width: auto;
  min-width: 196rpx;
  min-height: 72rpx;
  padding: 0 24rpx;
  border: 0;
  border-radius: 22rpx;
  background: linear-gradient(180deg, rgba(140, 154, 125, 0.98) 0%, rgba(111, 124, 97, 1) 100%);
  color: #fbf7f0;
  box-shadow:
    0 10rpx 18rpx rgba(55, 71, 49, 0.12),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.08);
  font-size: 22rpx;
  font-weight: 600;
  margin-left: auto;
  flex-shrink: 0;
}

.vc-resource-divider {
  height: 1rpx;
  margin: 24rpx 0;
  background: rgba(116, 95, 86, 0.10);
}

.vc-recent-panel-v2 {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.vc-recent-main {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.vc-recent-actions {
  margin-top: 6rpx;
}

.vc-resource-chip,
.vc-recent-chip {
  flex-shrink: 0;
}

@media (max-width: 420rpx) {
  .vc-resource-action,
  .vc-recent-actions {
    flex-wrap: wrap;
    justify-content: flex-start;
  }

  .vc-home-v2 .btn-outline.vc-inline-btn,
  .vc-home-v2 .btn-outline.vc-recent-btn {
    margin-left: 0;
  }
}
