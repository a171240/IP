@import "theme.wxss";

page {
  position: fixed;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #f2e8dc;
}

.vc-home-v2,
.vc-home-v2 .vc-page-scroll-shell,
.vc-home-v2 .page-scroll {
  height: 100%;
  overflow: hidden;
}

.vc-home-v2 {
  background: #f2e8dc;
}

.vc-home-v2 .container {
  min-height: 100%;
  padding: 62rpx 46rpx calc(172rpx + env(safe-area-inset-bottom));
  background:
    linear-gradient(180deg, #2f372b 0rpx, #2f372b 396rpx, #f2e8dc 396rpx, #f2e8dc 100%);
  box-sizing: border-box;
}

.vc-home-v2 view,
.vc-home-v2 text,
.vc-home-v2 button {
  font-family: "Inter", "PingFang SC", "Microsoft YaHei", sans-serif;
  letter-spacing: 0;
  box-sizing: border-box;
}

.vc-plugin-hero {
  position: relative;
  min-height: 544rpx;
  padding: 50rpx 52rpx 54rpx;
  border-radius: 54rpx;
  display: flex;
  flex-direction: column;
  background: #30382d;
  border: 1rpx solid rgba(205, 215, 191, 0.15);
  box-shadow:
    0 22rpx 44rpx rgba(52, 45, 37, 0.18),
    inset 0 1rpx 0 rgba(248, 241, 232, 0.04);
  overflow: hidden;
}

.vc-home-copy {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
}

.vc-home-v2 .eyebrow {
  align-self: flex-start;
  min-height: 44rpx;
  margin: 0 0 28rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(248, 241, 232, 0.26);
  background: rgba(248, 241, 232, 0.035);
  color: rgba(248, 241, 232, 0.82);
  font-size: 23rpx;
  line-height: 44rpx;
  font-weight: 800;
}

.vc-home-v2 .title {
  display: block;
  width: auto;
  max-width: 500rpx;
  margin: 0;
  color: #F8F1E8;
  font-size: 56rpx;
  line-height: 1.12;
  font-weight: 700;
  text-shadow: 0 3rpx 0 rgba(248, 241, 232, 0.05);
}

.vc-home-v2 .title text {
  display: block;
  color: inherit;
  font: inherit;
  line-height: inherit;
}

.vc-home-v2 .subtitle {
  display: block;
  width: auto;
  max-width: 510rpx;
  margin-top: 22rpx;
  color: rgba(222, 216, 204, 0.82);
  font-size: 25rpx;
  line-height: 1.5;
  font-weight: 400;
}

.vc-plugin-start-btn {
  position: relative;
  z-index: 1;
  width: 100%;
  min-height: 106rpx;
  margin: auto 0 0;
  padding: 0;
  border: 0;
  border-radius: 36rpx;
  background: #7F8D72;
  color: #FFF8EF;
  box-shadow:
    0 16rpx 28rpx rgba(36, 52, 31, 0.18),
    inset 0 1rpx 0 rgba(248, 241, 232, 0.16);
  font-size: 31rpx;
  line-height: 106rpx;
  font-weight: 700;
}

.vc-plugin-stack {
  position: relative;
  z-index: 2;
  margin-top: 38rpx;
  display: grid;
  gap: 24rpx;
}

.vc-plugin-card {
  position: relative;
  min-height: 202rpx;
  padding: 42rpx;
  border-radius: 42rpx;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 160rpx;
  align-items: center;
  gap: 20rpx;
  background: #fbf6ee;
  border: 1rpx solid #dacabe;
  box-shadow:
    0 12rpx 24rpx rgba(60, 49, 42, 0.07),
    inset 0 1rpx 0 rgba(244, 236, 228, 0.82);
  transition: transform 0.14s ease, box-shadow 0.14s ease, border-color 0.14s ease;
  overflow: hidden;
}

.vc-plugin-card::before {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  pointer-events: none;
  background: linear-gradient(90deg, rgba(127, 141, 114, 0.07) 0%, rgba(127, 141, 114, 0) 44%);
  opacity: 0;
  transition: opacity 0.14s ease;
}

.vc-plugin-card-pressed {
  transform: scale(0.985);
  border-color: rgba(127, 141, 114, 0.38);
  box-shadow:
    0 10rpx 22rpx rgba(40, 31, 28, 0.08),
    inset 0 1rpx 0 rgba(244, 236, 228, 0.72);
}

.vc-plugin-card-pressed::before {
  opacity: 1;
}

.vc-plugin-card-primary {
  border-color: #d2c0b2;
}

.vc-plugin-card-secondary {
  min-height: 150rpx;
  padding: 32rpx 42rpx;
  grid-template-columns: minmax(0, 1fr) 160rpx;
  background: #f8f0e6;
  box-shadow:
    0 10rpx 22rpx rgba(60, 49, 42, 0.055),
    inset 0 1rpx 0 rgba(244, 236, 228, 0.74);
}

.vc-plugin-card-secondary .vc-plugin-card-title {
  font-size: 31rpx;
}

.vc-plugin-card-secondary .vc-plugin-card-copy {
  font-size: 24rpx;
  line-height: 1.36;
}

.vc-plugin-card-secondary .vc-plugin-card-btn {
  width: 160rpx;
  background: #7d8b6d;
}

.vc-plugin-card-title,
.vc-plugin-card-copy,
.vc-plugin-recent-text {
  display: block;
}

.vc-plugin-card-title {
  color: #281F1C;
  font-size: 33rpx;
  line-height: 1.3;
  font-weight: 700;
}

.vc-plugin-card-copy {
  margin-top: 10rpx;
  color: #6E605A;
  font-size: 24rpx;
  line-height: 1.36;
  font-weight: 400;
}

.vc-plugin-card-btn {
  width: 160rpx;
  min-height: 62rpx;
  margin: 0;
  padding: 0 16rpx;
  border-radius: 31rpx;
  border: 0;
  background: #7d8b6d;
  color: #fff9ef;
  box-shadow:
    0 10rpx 20rpx rgba(82, 97, 73, 0.16),
    inset 0 1rpx 0 rgba(248, 241, 232, 0.18);
  font-size: 23rpx;
  font-weight: 700;
  text-align: center;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.vc-plugin-card-btn text {
  display: block;
  line-height: 1;
  color: inherit;
}

.vc-plugin-card-chevron {
  margin-top: -1rpx;
  color: rgba(255, 249, 239, 0.86);
  font-size: 28rpx;
  line-height: 1;
  font-weight: 900;
}

.vc-plugin-recent {
  min-height: 94rpx;
  padding: 0 34rpx;
  border-radius: 34rpx;
  display: flex;
  align-items: center;
  background: #eef5e9;
  border: 1rpx solid #d7e2cf;
  box-shadow: inset 0 1rpx 0 rgba(248, 241, 232, 0.48);
}

.vc-plugin-recent-text {
  color: #526149;
  font-size: 24rpx;
  line-height: 1.3;
  font-weight: 700;
}

.vc-history-panel {
  margin-top: 36rpx;
}

.vc-history-head {
  min-height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.vc-history-title-wrap {
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.vc-history-kicker,
.vc-history-title,
.vc-history-refresh,
.vc-history-state text,
.vc-history-item-title,
.vc-history-item-subtitle,
.vc-history-status,
.vc-history-score,
.vc-history-time,
.vc-history-focus-title,
.vc-history-focus-copy,
.vc-history-action text {
  display: block;
}

.vc-history-kicker {
  color: #7F8D72;
  font-size: 22rpx;
  line-height: 1.2;
  font-weight: 800;
}

.vc-history-title {
  margin-top: 8rpx;
  color: #281F1C;
  font-size: 34rpx;
  line-height: 1.18;
  font-weight: 800;
}

.vc-history-refresh {
  flex: 0 0 auto;
  min-width: 112rpx;
  min-height: 54rpx;
  padding: 0 22rpx;
  border-radius: 27rpx;
  background: #e4d8ca;
  color: #534841;
  font-size: 23rpx;
  line-height: 54rpx;
  font-weight: 800;
  text-align: center;
}

.vc-history-state {
  min-height: 136rpx;
  margin-top: 22rpx;
  padding: 30rpx 32rpx;
  border-radius: 34rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  background: #fbf6ee;
  border: 1rpx solid #dacabe;
  box-shadow: inset 0 1rpx 0 rgba(248, 241, 232, 0.64);
}

.vc-history-state text {
  color: #6E605A;
  font-size: 24rpx;
  line-height: 1.48;
  font-weight: 600;
}

.vc-history-state-error {
  border-color: rgba(170, 96, 78, 0.34);
  background: #F7EAE3;
}

.vc-history-state-action {
  margin-top: 10rpx;
  color: #526149 !important;
  font-weight: 800 !important;
}

.vc-history-list {
  margin-top: 22rpx;
  display: grid;
  gap: 16rpx;
}

.vc-history-item {
  min-height: 178rpx;
  padding: 28rpx 28rpx 26rpx;
  border-radius: 34rpx;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 132rpx;
  gap: 22rpx;
  align-items: stretch;
  background: #fbf6ee;
  border: 1rpx solid #d9cabd;
  box-shadow:
    0 12rpx 26rpx rgba(63, 51, 43, 0.075),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.72);
  overflow: hidden;
  transition: transform 0.14s ease, border-color 0.14s ease;
}

.vc-history-item-pressed {
  transform: scale(0.988);
  border-color: rgba(125, 139, 109, 0.48);
}

.vc-history-item-main {
  min-width: 0;
}

.vc-history-item-top {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.vc-history-item-title {
  min-width: 0;
  color: #2b241f;
  font-size: 28rpx;
  line-height: 1.28;
  font-weight: 800;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.vc-history-status {
  flex: 0 0 auto;
  min-height: 38rpx;
  padding: 0 14rpx;
  border-radius: 19rpx;
  background: #e7eee1;
  color: #526149;
  font-size: 20rpx;
  line-height: 38rpx;
  font-weight: 800;
}

.vc-history-item-subtitle {
  margin-top: 10rpx;
  color: #7b6b62;
  font-size: 23rpx;
  line-height: 1.34;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.vc-history-focus {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 24rpx;
  background: #f2eadf;
  border: 1rpx solid #e4d6c8;
}

.vc-history-focus-title {
  color: #5b684f;
  font-size: 22rpx;
  line-height: 1.28;
  font-weight: 800;
}

.vc-history-focus-copy {
  margin-top: 8rpx;
  color: #77675e;
  font-size: 22rpx;
  line-height: 1.42;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.vc-history-item-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: space-between;
  gap: 12rpx;
}

.vc-history-score {
  color: #526149;
  font-size: 30rpx;
  line-height: 1;
  font-weight: 900;
}

.vc-history-time {
  color: #8a7b70;
  font-size: 20rpx;
  line-height: 1.2;
  font-weight: 700;
  text-align: right;
}

.vc-history-action {
  min-height: 50rpx;
  padding: 0 16rpx 0 18rpx;
  border-radius: 25rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  background: #7d8b6d;
  color: #fff9ef;
  font-size: 22rpx;
  font-weight: 800;
}

.vc-history-action text {
  line-height: 1;
  color: inherit;
}

.vc-history-action-arrow {
  margin-top: -1rpx;
  font-size: 26rpx;
  font-weight: 900;
}

.vc-history-fold {
  min-height: 72rpx;
  padding: 0 28rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  background: #ece1d4;
  border: 1rpx solid #dbccbd;
  color: #5f544c;
  font-size: 24rpx;
  line-height: 72rpx;
  font-weight: 800;
}

.vc-history-fold text {
  display: block;
  color: inherit;
  line-height: 1;
}

.vc-history-fold-arrow {
  width: 12rpx;
  height: 12rpx;
  margin-top: -4rpx;
  border-right: 3rpx solid currentColor;
  border-bottom: 3rpx solid currentColor;
  transform: rotate(45deg);
  transition: transform 0.14s ease;
}

.vc-history-fold-arrow-up {
  margin-top: 4rpx;
  transform: rotate(225deg);
}

button::after {
  border: none;
}

button:active {
  opacity: 0.94;
}

.vc-page .fade-up {
  animation: vcFadeUp 360ms ease both;
}

.vc-page .delay-1 {
  animation-delay: 60ms;
}

.vc-page .delay-2 {
  animation-delay: 120ms;
}

@keyframes vcFadeUp {
  from {
    opacity: 0;
    transform: translateY(10rpx);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@media (max-width: 420rpx) {
  .vc-home-v2 .container {
    padding-left: 46rpx;
    padding-right: 46rpx;
  }

  .vc-plugin-card {
    grid-template-columns: minmax(0, 1fr);
  }

  .vc-plugin-card-btn {
    width: auto;
    min-width: 154rpx;
    justify-self: start;
  }

  .vc-history-item {
    grid-template-columns: minmax(0, 1fr);
  }

  .vc-history-item-side {
    flex-direction: row;
    align-items: center;
  }

  .vc-history-time {
    text-align: left;
  }
}
