@import "theme.wxss";

.vc-home-focus .container {
  padding-top: 36rpx;
}

.vc-home-focus .vc-focus-hero {
  padding: 26rpx 22rpx;
}

.vc-home-focus .vc-focus-launch {
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.vc-home-focus .vc-focus-copy {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.vc-home-focus .vc-focus-title {
  display: block;
  font-size: 32rpx;
  line-height: 1.24;
  font-weight: 700;
  color: #f5f3ef;
}

.vc-home-focus .vc-focus-note {
  display: block;
  font-size: 23rpx;
  line-height: 1.64;
  color: var(--vc-text-muted);
}

.vc-home-focus .minimal-grid {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.vc-home-focus .minimal-action-card {
  min-height: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.vc-home-focus .minimal-action-kicker {
  display: block;
  font-size: 20rpx;
  line-height: 1.3;
  letter-spacing: 0.8rpx;
  color: rgba(215, 191, 150, 0.7);
}

.vc-home-focus .minimal-action-copy {
  display: block;
  font-size: 22rpx;
  line-height: 1.58;
  color: var(--vc-text-muted);
}

.vc-home-focus .minimal-action-link {
  display: block;
  font-size: 22rpx;
  line-height: 1.5;
  font-weight: 700;
  color: var(--vc-gold);
}
