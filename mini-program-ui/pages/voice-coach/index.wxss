@import "theme.wxss";

page {
  position: fixed;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #21261f;
}

.vc-home-v2,
.vc-home-v2 .vc-page-scroll-shell,
.vc-home-v2 .page-scroll {
  height: 100%;
  overflow: hidden;
}

.vc-home-v2 {
  background: #EFE5D8;
}

.vc-home-v2 .container {
  min-height: 100%;
  padding: 62rpx 46rpx calc(172rpx + env(safe-area-inset-bottom));
  background:
    linear-gradient(180deg, #21261F 0rpx, #21261F 456rpx, #EFE5D8 456rpx, #EFE5D8 100%);
  box-sizing: border-box;
}

.vc-home-v2 view,
.vc-home-v2 text,
.vc-home-v2 button {
  font-family: "Inter", "PingFang SC", "Microsoft YaHei", sans-serif;
  letter-spacing: 0;
  box-sizing: border-box;
}

.vc-plugin-hero {
  position: relative;
  min-height: 544rpx;
  padding: 50rpx 52rpx 54rpx;
  border-radius: 54rpx;
  display: flex;
  flex-direction: column;
  background: #1E241D;
  border: 1rpx solid rgba(70, 81, 63, 0.34);
  box-shadow:
    0 28rpx 54rpx rgba(40, 31, 28, 0.24),
    inset 0 1rpx 0 rgba(248, 241, 232, 0.04);
  overflow: hidden;
}

.vc-home-copy {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
}

.vc-home-v2 .eyebrow {
  align-self: flex-start;
  min-height: 44rpx;
  margin: 0 0 28rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(248, 241, 232, 0.26);
  background: rgba(248, 241, 232, 0.035);
  color: rgba(248, 241, 232, 0.82);
  font-size: 23rpx;
  line-height: 44rpx;
  font-weight: 800;
}

.vc-home-v2 .title {
  display: block;
  width: auto;
  max-width: 500rpx;
  margin: 0;
  color: #F8F1E8;
  font-size: 56rpx;
  line-height: 1.12;
  font-weight: 700;
  text-shadow: 0 3rpx 0 rgba(248, 241, 232, 0.05);
}

.vc-home-v2 .title text {
  display: block;
  color: inherit;
  font: inherit;
  line-height: inherit;
}

.vc-home-v2 .subtitle {
  display: block;
  width: auto;
  max-width: 510rpx;
  margin-top: 22rpx;
  color: rgba(222, 216, 204, 0.82);
  font-size: 25rpx;
  line-height: 1.5;
  font-weight: 400;
}

.vc-plugin-start-btn {
  position: relative;
  z-index: 1;
  width: 100%;
  min-height: 106rpx;
  margin: auto 0 0;
  padding: 0;
  border: 0;
  border-radius: 36rpx;
  background: #7F8D72;
  color: #FFF8EF;
  box-shadow:
    0 16rpx 28rpx rgba(36, 52, 31, 0.18),
    inset 0 1rpx 0 rgba(248, 241, 232, 0.16);
  font-size: 31rpx;
  line-height: 106rpx;
  font-weight: 700;
}

.vc-plugin-stack {
  position: relative;
  z-index: 2;
  margin-top: 38rpx;
  display: grid;
  gap: 24rpx;
}

.vc-plugin-card {
  min-height: 202rpx;
  padding: 42rpx;
  border-radius: 42rpx;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 158rpx;
  align-items: center;
  gap: 20rpx;
  background: #F8F1E8;
  border: 1rpx solid #D8C8BB;
  box-shadow:
    0 16rpx 34rpx rgba(40, 31, 28, 0.08),
    inset 0 1rpx 0 rgba(244, 236, 228, 0.82);
}

.vc-plugin-card-primary {
  border-color: #d2c0b2;
}

.vc-plugin-card-secondary {
  min-height: 150rpx;
  padding: 32rpx 38rpx;
  grid-template-columns: minmax(0, 1fr) 142rpx;
  background: #f4eadf;
  box-shadow:
    0 10rpx 24rpx rgba(40, 31, 28, 0.055),
    inset 0 1rpx 0 rgba(244, 236, 228, 0.74);
}

.vc-plugin-card-secondary .vc-plugin-card-title {
  font-size: 31rpx;
}

.vc-plugin-card-secondary .vc-plugin-card-copy {
  font-size: 24rpx;
  line-height: 1.36;
}

.vc-plugin-card-secondary .vc-plugin-card-btn {
  width: 142rpx;
  background: #ebe0d5;
}

.vc-plugin-card-title,
.vc-plugin-card-copy,
.vc-plugin-recent-text {
  display: block;
}

.vc-plugin-card-title {
  color: #281F1C;
  font-size: 33rpx;
  line-height: 1.3;
  font-weight: 700;
}

.vc-plugin-card-copy {
  margin-top: 10rpx;
  color: #6E605A;
  font-size: 24rpx;
  line-height: 1.36;
  font-weight: 400;
}

.vc-plugin-card-btn {
  width: 158rpx;
  min-height: 62rpx;
  margin: 0;
  padding: 0 16rpx;
  border-radius: 31rpx;
  border: 0;
  background: #EFE4D9;
  color: #6E605A;
  box-shadow:
    0 8rpx 18rpx rgba(40, 31, 28, 0.05),
    inset 0 1rpx 0 rgba(248, 241, 232, 0.56);
  font-size: 23rpx;
  line-height: 62rpx;
  font-weight: 700;
  text-align: center;
}

.vc-plugin-recent {
  min-height: 94rpx;
  padding: 0 34rpx;
  border-radius: 34rpx;
  display: flex;
  align-items: center;
  background: #EDF4E8;
  border: 1rpx solid #D4DFCC;
  box-shadow: inset 0 1rpx 0 rgba(248, 241, 232, 0.48);
}

.vc-plugin-recent-text {
  color: #526149;
  font-size: 24rpx;
  line-height: 1.3;
  font-weight: 700;
}

button::after {
  border: none;
}

button:active {
  opacity: 0.94;
}

.vc-page .fade-up {
  animation: vcFadeUp 360ms ease both;
}

.vc-page .delay-1 {
  animation-delay: 60ms;
}

@keyframes vcFadeUp {
  from {
    opacity: 0;
    transform: translateY(10rpx);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@media (max-width: 420rpx) {
  .vc-home-v2 .container {
    padding-left: 46rpx;
    padding-right: 46rpx;
  }

  .vc-plugin-card {
    grid-template-columns: minmax(0, 1fr);
  }

  .vc-plugin-card-btn {
    width: auto;
    min-width: 154rpx;
    justify-self: start;
  }
}
