  margin-bottom: 14rpx;
}

.vc-report-page .report-section-title {
  margin-top: 8rpx;
}

.vc-report-page .next-action-card {
  margin-top: 18rpx;
  padding: 22rpx;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  border-radius: 22rpx;
  border: 1rpx solid rgba(209, 180, 127, 0.18);
  background:
    linear-gradient(90deg, rgba(209, 180, 127, 0.10) 0%, rgba(154, 166, 140, 0.075) 42%, rgba(255, 255, 255, 0.015) 100%),
    linear-gradient(180deg, rgba(23, 29, 24, 0.98) 0%, rgba(12, 17, 14, 0.99) 100%);
  box-shadow:
    0 10rpx 24rpx rgba(3, 5, 4, 0.18),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.05);
}

.vc-report-page .next-action-main {
  flex: 1;
  min-width: 0;
}

.vc-report-page .next-action-kicker {
  display: block;
  font-size: 19rpx;
  line-height: 1;
  font-weight: 700;
  letter-spacing: 1.2rpx;
  color: rgba(209, 180, 127, 0.86);
}

.vc-report-page .next-action-title {
  display: block;
  margin-top: 10rpx;
  font-size: 31rpx;
  line-height: 1.28;
  font-weight: 800;
  color: #f7f3eb;
}

.vc-report-page .next-action-copy {
  display: block;
  margin-top: 10rpx;
  font-size: 25rpx;
  line-height: 38rpx;
  color: rgba(221, 226, 216, 0.70);
}

.vc-report-page .next-action-score {
  flex-shrink: 0;
  min-width: 78rpx;
  height: 50rpx;
  padding: 0 14rpx;
  border-radius: 16rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: rgba(209, 180, 127, 0.12);
  border: 1rpx solid rgba(209, 180, 127, 0.22);
  color: #f3dfb5;
  font-size: 24rpx;
  font-weight: 800;
}

/* 2026-04-27 report coherence pass: report is a light-paper page with dark
   evidence cards, matching the main mini-program surface model. */
page {
  background: #e8ded2;
}

.vc-report-page {
  background:
    radial-gradient(120% 92% at 0% 0%, rgba(127, 143, 111, 0.13) 0%, rgba(11, 16, 13, 0) 42%),
    radial-gradient(120% 92% at 100% 0%, rgba(226, 235, 217, 0.08) 0%, rgba(11, 16, 13, 0) 44%),
    linear-gradient(180deg, #0b100d 0rpx, #101711 250rpx, #e8ded2 250rpx, #eee4d8 100%);
}

.vc-report-page .content {
  padding-left: 24rpx;
  padding-right: 24rpx;
  padding-bottom: calc(198rpx + env(safe-area-inset-bottom));
}

.vc-report-page .report-hero {
  border-radius: 32rpx;
  box-shadow:
    0 18rpx 34rpx rgba(3, 5, 4, 0.20),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.05);
}

.vc-report-page .report-section-title {
  color: #241f1b;
  font-size: 34rpx;
  line-height: 1.24;
}

.vc-report-page .section-kicker,
.vc-report-page .panel-block-title {
  color: rgba(96, 118, 84, 0.82);
}

.vc-report-page .tab-panel-head .section-kicker,
.vc-report-page .panel-block-title {
  color: rgba(166, 184, 154, 0.76);
}

.vc-report-page .tabs-wrap {
  margin-left: -24rpx;
  margin-right: -24rpx;
  padding-left: 24rpx;
  padding-right: 24rpx;
  background: linear-gradient(180deg, rgba(232, 222, 210, 0.96) 0%, rgba(238, 228, 216, 0.90) 100%);
}

.vc-report-page .tabs-shell {
  background: linear-gradient(180deg, rgba(18, 24, 20, 0.98) 0%, rgba(10, 14, 12, 0.99) 100%);
}

.vc-report-page .next-action-card {
  border-color: rgba(102, 117, 84, 0.22);
  background:
    linear-gradient(90deg, rgba(102, 117, 84, 0.18) 0%, rgba(154, 166, 140, 0.08) 46%, rgba(255, 255, 255, 0.02) 100%),
    linear-gradient(180deg, rgba(23, 29, 24, 0.98) 0%, rgba(12, 17, 14, 0.99) 100%);
}

.vc-report-page .cta {
  background: linear-gradient(180deg, rgba(232, 222, 210, 0) 0%, rgba(232, 222, 210, 0.86) 38%, rgba(232, 222, 210, 0.98) 100%);
}

.vc-report-page .again-btn {
  border-radius: 22rpx;
  background: linear-gradient(180deg, #9aa68c 0%, #667554 100%);
}

