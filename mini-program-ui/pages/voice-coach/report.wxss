@import "theme.wxss";

.page {
  height: 100vh;
  min-height: 100vh;
  background-color: var(--vc-bg);
  background-image:
    radial-gradient(120% 100% at 0% 0%, rgba(229, 211, 179, 0.16) 0%, rgba(5, 5, 7, 0) 60%),
    radial-gradient(130% 100% at 100% 8%, rgba(149, 236, 105, 0.07) 0%, rgba(5, 5, 7, 0) 60%),
    linear-gradient(180deg, #050507 0%, #0a0a0e 55%, #050507 100%);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.seg {
  margin: 18rpx auto 10rpx;
  background: rgba(21, 21, 29, 0.86);
  border: 1rpx solid var(--vc-border);
  border-radius: 999rpx;
  padding: 6rpx;
  display: flex;
  width: 320rpx;
}

.seg-item {
  flex: 1;
  text-align: center;
  color: var(--vc-text-muted);
  font-size: 28rpx;
  padding: 10rpx 0;
  border-radius: 999rpx;
}

.seg-item.active {
  background: #ffffff;
  color: #1a1510;
  font-weight: 800;
}

.content {
  flex: 1;
  min-height: 0;
  height: 0;
  box-sizing: border-box;
  padding: 0 18rpx 18rpx;
}

.headline {
  color: var(--vc-text);
  font-size: 34rpx;
  font-weight: 800;
  padding: 16rpx 6rpx;
}

.loading-empty {
  padding: 56rpx 18rpx;
  font-size: 28rpx;
  color: var(--vc-text-muted);
  text-align: center;
}

.score-card {
  background: rgba(21, 21, 29, 0.94);
  border: 1rpx solid var(--vc-border);
  border-radius: 26rpx;
  padding: 20rpx 18rpx 18rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  align-items: stretch;
  box-shadow: 0 16rpx 42rpx rgba(0, 0, 0, 0.32);
}

.score-card-top {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
}

.score-left {
  min-width: 0;
}

.score-label {
  font-size: 26rpx;
  color: var(--vc-text-muted);
}

.score-line {
  margin-top: 6rpx;
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}

.score {
  font-size: 64rpx;
  font-weight: 900;
  color: var(--vc-success);
  line-height: 1;
}

.score-suffix {
  font-size: 26rpx;
  color: var(--vc-text-muted);
}

.score-note {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 34rpx;
  color: var(--vc-text-muted);
}

.score-pill {
  flex-shrink: 0;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(229, 211, 179, 0.12);
  border: 1rpx solid rgba(229, 211, 179, 0.24);
  color: var(--vc-gold);
  font-size: 22rpx;
  font-weight: 700;
}

.score-visual {
  border-radius: 22rpx;
  border: 1rpx solid rgba(229, 211, 179, 0.08);
  background:
    radial-gradient(120% 120% at 50% 20%, rgba(149, 236, 105, 0.08) 0%, rgba(21, 21, 29, 0) 58%),
    rgba(10, 10, 14, 0.72);
  padding: 16rpx 0 8rpx;
}

.radar {
  display: block;
  margin: 0 auto;
}

.dims {
  margin-top: 14rpx;
  background: rgba(21, 21, 29, 0.94);
  border: 1rpx solid var(--vc-border);
  border-radius: 26rpx;
  padding: 12rpx 18rpx;
}

.dim-row {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 10rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(229, 211, 179, 0.12);
}

.dim-row:last-child {
  border-bottom: none;
}

.dim-row-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.dim-name {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: var(--vc-text);
  font-weight: 700;
}

.dim-bar-track {
  width: 100%;
  height: 14rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 999rpx;
  overflow: hidden;
}

.dim-bar-fill {
  height: 100%;
  border-radius: 999rpx;
  transition: width 0.8s ease;
}

.dim-meta {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
}

.dim-score-pill {
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.06);
  color: var(--vc-text);
  font-size: 22rpx;
  font-weight: 700;
}

.dim-stars {
  font-size: 20rpx;
  letter-spacing: 1rpx;
  color: var(--vc-gold, #f6c76f);
  white-space: nowrap;
}

.summary {
  margin-top: 14rpx;
  background: rgba(21, 21, 29, 0.92);
  border: 1rpx solid var(--vc-border);
  border-radius: 26rpx;
  padding: 18rpx 18rpx 14rpx;
}

.summary-title {
  margin-bottom: 12rpx;
  font-size: 24rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  color: var(--vc-gold);
}

.summary-line {
  font-size: 28rpx;
  color: var(--vc-text);
  line-height: 42rpx;
  margin-bottom: 10rpx;
  word-break: break-word;
}

.summary-line:last-child {
  margin-bottom: 0;
}

.tabs-wrap {
  position: sticky;
  top: 0;
  z-index: 20;
  margin-top: 14rpx;
  padding: 8rpx 0 10rpx;
  background: linear-gradient(180deg, rgba(5, 5, 7, 0.96) 0%, rgba(5, 5, 7, 0.88) 100%);
}

.tabs {
  position: relative;
  display: flex;
  align-items: center;
  padding: 6rpx;
  border-radius: 999rpx;
  background: rgba(21, 21, 29, 0.92);
  border: 1rpx solid var(--vc-border);
  overflow: hidden;
}

.tab {
  position: relative;
  z-index: 1;
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 999rpx;
  background: transparent;
  border: none;
  color: var(--vc-text-muted);
  font-size: 24rpx;
  transition: color 0.28s ease;
}

.tab.active {
  color: #1a1510;
  font-weight: 800;
}

.tab-indicator {
  position: absolute;
  top: 6rpx;
  bottom: 6rpx;
  left: 6rpx;
  width: calc((100% - 12rpx) / 5);
  border-radius: 999rpx;
  background: linear-gradient(135deg, #dcc7a6 0%, #f1e3c6 50%, #c1a076 100%);
  transition: transform 0.28s ease;
}

.current-tab-title {
  margin-top: 10rpx;
  padding: 8rpx 12rpx;
  border-radius: 14rpx;
  border: 1rpx solid rgba(229, 211, 179, 0.16);
  background: rgba(229, 211, 179, 0.08);
  color: var(--vc-text-muted);
  font-size: 24rpx;
  line-height: 32rpx;
}

.tab-body {
  margin-top: 12rpx;
}

.tab-title {
  padding: 6rpx 6rpx 10rpx;
  font-size: 34rpx;
  font-weight: 900;
  color: var(--vc-gold);
}

.metric-card,
.qa-card {
  background: rgba(21, 21, 29, 0.94);
  border: 1rpx solid var(--vc-border);
  border-radius: 26rpx;
  padding: 16rpx;
  margin-bottom: 14rpx;
}

.metric-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.metric-name {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--vc-text);
}

.metric-status {
  font-size: 28rpx;
  color: var(--vc-success);
  font-weight: 800;
}

.metric-text {
  font-size: 28rpx;
  color: var(--vc-text);
  line-height: 42rpx;
  white-space: pre-wrap;
  word-break: break-word;
}

.tag-row {
  margin-top: 12rpx;
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.tag {
  padding: 10rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(149, 236, 105, 0.1);
  border: 1rpx solid rgba(149, 236, 105, 0.28);
  color: #b9f39c;
  font-size: 26rpx;
}

.qa-title {
  margin-top: 10rpx;
  font-size: 28rpx;
  font-weight: 900;
  color: var(--vc-gold);
}

.qa-title:first-child {
  margin-top: 0;
}

.qa-text {
  margin-top: 8rpx;
  font-size: 28rpx;
  color: var(--vc-text);
  line-height: 42rpx;
  white-space: pre-wrap;
  word-break: break-word;
}

.linechart-card {
  background: rgba(21, 21, 29, 0.94);
  border: 1rpx solid var(--vc-border);
  border-radius: 26rpx;
  margin-bottom: 14rpx;
  overflow: hidden;
}

.chart-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 16rpx 18rpx 0;
}

.chart-card-title {
  font-size: 26rpx;
  font-weight: 800;
  color: var(--vc-text);
}

.linechart-canvas {
  display: block;
  margin: 0 auto;
}

.chart-empty {
  min-height: 320rpx;
  background: rgba(21, 21, 29, 0.94);
  border: 1rpx solid var(--vc-border);
  border-radius: 26rpx;
  margin-bottom: 14rpx;
  padding: 28rpx 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.chart-empty-title {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--vc-text);
  margin-bottom: 10rpx;
}

.chart-empty-text {
  font-size: 24rpx;
  line-height: 36rpx;
  color: var(--vc-text-muted);
}

.audio-list {
  background: rgba(21, 21, 29, 0.94);
  border: 1rpx solid var(--vc-border);
  border-radius: 26rpx;
  padding: 16rpx;
  margin-bottom: 14rpx;
}

.audio-title {
  font-size: 30rpx;
  font-weight: 900;
  color: var(--vc-text);
  margin-bottom: 12rpx;
}

.audio-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 0;
  border-bottom: 1rpx solid rgba(229, 211, 179, 0.12);
}

.audio-item:last-child {
  border-bottom: none;
}

.audio-play {
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(149, 236, 105, 0.12);
  color: #b9f39c;
  border: 1rpx solid rgba(149, 236, 105, 0.32);
}

.audio-meta {
  font-size: 26rpx;
  color: var(--vc-text-muted);
}

/* Report -> dialog replay */
.chat-view {
  padding-top: 10rpx;
}

.row {
  display: flex;
  align-items: flex-end;
  margin-bottom: 18rpx;
}

.row.left {
  justify-content: flex-start;
}

.row.right {
  justify-content: flex-end;
}

.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 28rpx;
  margin: 0 12rpx;
}

.avatar-customer {
  background: rgba(255, 255, 255, 0.12);
  color: var(--vc-text);
}

.avatar-beautician {
  background: rgba(149, 236, 105, 0.22);
  color: var(--vc-success);
}

.bubble {
  max-width: 560rpx;
  border-radius: 22rpx;
  padding: 18rpx 18rpx 14rpx;
  box-shadow: 0 12rpx 30rpx rgba(0, 0, 0, 0.26);
}

.bubble-customer {
  background: var(--vc-bubble-other);
}

.bubble-beautician {
  background: var(--vc-bubble-self);
}

.voice {
  margin-bottom: 10rpx;
}

.voice-bar {
  align-self: flex-start;
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  background: rgba(0, 0, 0, 0.16);
  padding: 10rpx 14rpx;
  border-radius: 999rpx;
}

.voice-label,
.voice-dur {
  font-size: 26rpx;
}

.bubble-customer .voice-label,
.bubble-customer .voice-dur,
.bubble-customer .msg-text {
  color: var(--vc-bubble-other-text);
}

.bubble-beautician .voice-label,
.bubble-beautician .voice-dur,
.bubble-beautician .msg-text {
  color: var(--vc-bubble-self-text);
}

.msg-text {
  font-size: 30rpx;
  line-height: 44rpx;
  white-space: pre-wrap;
  word-break: break-word;
}

.bottom-space {
  height: 150rpx;
}

.cta {
  padding: 14rpx 16rpx calc(14rpx + env(safe-area-inset-bottom));
  background: rgba(10, 10, 14, 0.94);
  border-top: 1rpx solid var(--vc-border);
}

.again-btn {
  width: 100%;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #dcc7a6 0%, #f1e3c6 50%, #c1a076 100%);
  color: #1a1510;
  font-size: 32rpx;
  height: 90rpx;
  line-height: 90rpx;
}

/* Persuasion compare cards */
.compare-card-objection {
  border-left: 6rpx solid #ff5858;
  padding-left: 16rpx;
  margin-bottom: 16rpx;
}

.compare-card-yours {
  border-left: 6rpx solid rgba(255, 255, 255, 0.2);
  padding-left: 16rpx;
  margin-bottom: 16rpx;
}

.compare-card-improved {
  border-left: 6rpx solid var(--vc-green, #95ec69);
  padding-left: 16rpx;
  margin-bottom: 16rpx;
}

.compare-card-improved:last-child {
  margin-bottom: 0;
}
