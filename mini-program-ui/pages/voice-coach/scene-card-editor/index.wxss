@import "../theme.wxss";

page {
  position: fixed;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

.vc-editor-v2 .container {
  padding-top: 36rpx;
}

.vc-editor-v2 .hero {
  padding-bottom: 24rpx;
}

.vc-editor-v2 .hero .subtitle {
  max-width: 640rpx;
}

.vc-editor-v2 .tips-row {
  margin-top: 18rpx;
  gap: 10rpx;
}

.vc-editor-v2 .hero-actions.compact-actions {
  margin-top: 18rpx;
}

.vc-editor-v2 .hero-actions.compact-actions > button:only-child {
  width: auto;
  min-width: 280rpx;
}

.vc-editor-v2 .section {
  margin-top: 26rpx;
}

.vc-editor-v2 .section-head {
  margin-bottom: 14rpx;
}

.vc-editor-v2 .card {
  padding: 20rpx 18rpx;
}

.vc-editor-v2 .field-stack {
  gap: 20rpx;
}

.vc-editor-v2 .field-block {
  gap: 10rpx;
}

.vc-editor-v2 .textarea {
  min-height: 200rpx;
}

.vc-editor-v2 .footer-cta-card {
  padding: 22rpx 20rpx;
}

.vc-editor-v2 .footer-cta-card .btn-primary {
  margin-top: 18rpx;
}
