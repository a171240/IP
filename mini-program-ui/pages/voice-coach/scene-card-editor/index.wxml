<view class="vc-page vc-editor-page vc-flow-v2 vc-editor-v2">
  <view class="vc-page-scroll-shell">
    <scroll-view class="page-scroll" scroll-y="true" enhanced="true" bounces="false" show-scrollbar="false">
      <view class="container">
        <view class="project-editor-hero fade-up">
          <view class="project-hero-copy">
            <text class="project-eyebrow">项目启动</text>
            <text class="project-title">把项目讲熟</text>
          </view>
          <button class="project-sample-btn" bindtap="handleFillStarterTemplate">示例</button>
        </view>

        <view class="project-form-card fade-up delay-1">
          <view class="project-form-head">
            <text class="project-form-title">项目资料</text>
          </view>

          <view class="field-stack">
            <view class="field-block">
              <text class="field-label">项目名称</text>
              <input class="input" placeholder="例如：胶原抗衰护理 / 头皮养护" value="{{name}}" bindinput="onName" />
            </view>

            <view class="field-block">
              <text class="field-label">项目资料 / 专业知识</text>
              <textarea
                class="input textarea project-main-textarea"
                maxlength="1600"
                placeholder="例如：这个项目解决什么问题，核心原理是什么，做完有什么感受，适合什么人，顾客常问什么..."
                value="{{projectMaterial}}"
                bindinput="onProjectMaterial"
              />
            </view>

            <button
              class="btn-primary project-generate-btn"
              loading="{{generating}}"
              disabled="{{generating}}"
              bindtap="handleGeneratePack"
            >{{packReady ? '重新生成项目训练包' : '生成项目训练包'}}</button>
          </view>
        </view>

        <view wx:if="{{packReady}}" class="project-focus-panel fade-up delay-2">
          <view class="project-focus-head">
            <text class="project-focus-title">训练重点</text>
            <text class="project-focus-count">3 项</text>
          </view>

          <view class="project-focus-grid">
            <view wx:for="{{packRows}}" wx:key="key" class="project-focus-card">
              <view class="project-focus-icon project-focus-icon-{{item.key}}"></view>
              <text class="project-focus-card-title">{{item.title}}</text>
              <text class="project-focus-card-body">{{item.text}}</text>
              <text class="project-focus-arrow">›</text>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="project-save-bar">
    <button class="btn-primary" loading="{{saving}}" disabled="{{saving}}" bindtap="handleSave">保存项目卡</button>
  </view>
</view>
