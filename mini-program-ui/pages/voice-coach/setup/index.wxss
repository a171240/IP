@import "../theme.wxss";

.vc-setup-minimal .container {
  padding-top: 36rpx;
}

.vc-setup-minimal .setup-step-card {
  position: relative;
  overflow: hidden;
  padding: 18rpx 18rpx;
  border-radius: 22rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  background:
    linear-gradient(180deg, rgba(17, 21, 29, 0.96) 0%, rgba(11, 14, 20, 0.96) 100%);
  box-shadow: 0 10rpx 24rpx rgba(0, 0, 0, 0.18), inset 0 1rpx 0 rgba(255, 255, 255, 0.04);
}

.vc-setup-minimal .setup-step-head {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
}

.vc-setup-minimal .setup-step-index {
  width: 46rpx;
  height: 46rpx;
  border-radius: 14rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: rgba(215, 191, 150, 0.1);
  border: 1rpx solid rgba(215, 191, 150, 0.18);
  color: var(--vc-gold);
  font-size: 20rpx;
  font-weight: 800;
  flex-shrink: 0;
}

.vc-setup-minimal .setup-step-copy {
  flex: 1;
  min-width: 0;
}

.vc-setup-minimal .setup-step-note {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  line-height: 1.4;
  color: var(--vc-text-muted);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.vc-setup-minimal .setup-chip-row {
  margin-top: 10rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.vc-setup-minimal .setup-empty-copy {
  display: none;
}

.vc-setup-minimal .setup-action-row {
  margin-top: 12rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.vc-setup-minimal .compact-textarea {
  margin-top: 18rpx;
  height: 160rpx;
  min-height: 160rpx;
}

.vc-setup-minimal .minimal-footer-card {
  padding-top: 18rpx;
}

.vc-setup-minimal .hero.compact-hero {
  display: none;
}

.vc-setup-minimal .tips-copy {
  display: none;
}

.vc-setup-minimal .setup-step-index {
  width: 40rpx;
  height: 40rpx;
  border-radius: 12rpx;
}

.vc-setup-minimal .setup-chip-row .tag:nth-child(n+3) {
  display: none;
}

.debug-pill {
  position: fixed;
  top: calc(18rpx + env(safe-area-inset-top));
  right: 24rpx;
  z-index: 120;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 84rpx;
  height: 46rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  border: 2rpx solid rgba(149, 236, 105, 0.22);
  background: rgba(9, 13, 19, 0.9);
  color: #95ec69;
  font-size: 22rpx;
  font-weight: 700;
  box-shadow: 0 10rpx 24rpx rgba(0, 0, 0, 0.24);
}

.debug-mask {
  position: fixed;
  inset: 0;
  z-index: 109;
  background: rgba(4, 6, 9, 0.44);
}

.debug-sheet {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  z-index: 110;
  height: min(920rpx, 72vh);
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 28rpx 24rpx;
  border-radius: 28rpx;
  border: 1rpx solid rgba(149, 236, 105, 0.18);
  background: rgba(8, 12, 18, 0.97);
  box-shadow: 0 24rpx 60rpx rgba(0, 0, 0, 0.35);
}

.debug-sheet-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.debug-sheet-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--vc-text);
}

.debug-sheet-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--vc-text-muted);
}

.debug-sheet-actions {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex-shrink: 0;
}

.debug-sheet-link {
  font-size: 24rpx;
  color: var(--vc-gold);
}

.debug-log-scroll {
  flex: 1;
  min-height: 0;
}

.debug-log-empty {
  padding: 24rpx 0;
  font-size: 24rpx;
  color: var(--vc-text-muted);
}

.debug-log-item {
  padding: 16rpx 18rpx;
  margin-bottom: 14rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.debug-log-warn {
  border-color: rgba(255, 188, 96, 0.24);
  background: rgba(255, 188, 96, 0.08);
}

.debug-log-error {
  border-color: rgba(255, 104, 104, 0.24);
  background: rgba(255, 104, 104, 0.08);
}

.debug-log-meta {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex-wrap: wrap;
}

.debug-log-time {
  font-size: 22rpx;
  color: var(--vc-text-muted);
}

.debug-log-stage {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--vc-text);
}

.debug-log-text {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.55;
  color: var(--vc-text-muted);
  word-break: break-all;
  white-space: pre-wrap;
}
