@import "../theme.wxss";

page {
  position: fixed;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

.vc-setup-v2 .container {
  padding-top: 30rpx;
}

.vc-setup-v2 .hero.compact-hero {
  padding-bottom: 22rpx;
}

.vc-setup-v2 .hero .subtitle {
  max-width: 620rpx;
}

.vc-setup-v2 .setup-step-card {
  position: relative;
  overflow: hidden;
  padding: 22rpx 20rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(108, 86, 77, 0.12);
  background: linear-gradient(180deg, rgba(241, 233, 223, 0.98) 0%, rgba(234, 223, 211, 0.98) 100%);
  box-shadow:
    0 14rpx 24rpx rgba(71, 54, 47, 0.08),
    0 4rpx 10rpx rgba(71, 54, 47, 0.04),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.60);
}

.vc-setup-v2 .setup-step-head {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
}

.vc-setup-v2 .setup-step-index {
  width: 44rpx;
  height: 44rpx;
  border-radius: 14rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: linear-gradient(180deg, var(--vc-flow-sage-1) 0%, var(--vc-flow-sage-2) 100%);
  box-shadow:
    0 10rpx 20rpx rgba(55, 71, 49, 0.12),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.12);
  color: #fbf7f0;
  font-size: 20rpx;
  font-weight: 700;
}

.vc-setup-v2 .setup-step-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.vc-setup-v2 .setup-step-note {
  display: block;
  font-size: 22rpx;
  line-height: 1.52;
  color: var(--vc-flow-ink-soft);
}

.vc-setup-v2 .setup-chip-row {
  margin-top: 14rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.vc-setup-v2 .setup-empty-copy {
  display: block;
  margin-top: 14rpx;
  font-size: 22rpx;
  line-height: 1.58;
  color: var(--vc-flow-ink-soft);
}

.vc-setup-v2 .setup-action-row {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.vc-setup-v2 .setup-action-row > button {
  width: auto;
  flex: 0 0 auto;
  min-width: 108rpx;
  min-height: 54rpx;
  padding: 0 18rpx;
  border-radius: 16rpx;
  font-size: 20rpx;
}

.vc-setup-v2 .compact-textarea {
  margin-top: 16rpx;
  height: 176rpx;
  min-height: 176rpx;
}

.vc-setup-v2 .minimal-footer-card {
  padding: 22rpx 20rpx 20rpx;
}

.vc-setup-v2 .minimal-footer-card .btn-primary {
  margin-top: 14rpx;
}

.debug-pill {
  position: fixed;
  top: calc(18rpx + env(safe-area-inset-top));
  right: 24rpx;
  z-index: 120;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 92rpx;
  height: 50rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(167, 181, 154, 0.28);
  background: rgba(27, 34, 28, 0.92);
  box-shadow:
    0 12rpx 22rpx rgba(17, 22, 16, 0.22),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.06);
  color: #e4edd7;
  font-size: 22rpx;
  font-weight: 700;
}

.debug-mask {
  position: fixed;
  inset: 0;
  z-index: 109;
  background: rgba(17, 22, 16, 0.32);
}

.debug-sheet {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  z-index: 110;
  height: min(920rpx, 72vh);
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 28rpx 24rpx;
  border-radius: 28rpx;
  border: 1rpx solid rgba(208, 220, 197, 0.12);
  background:
    radial-gradient(120% 130% at 100% 0%, rgba(164, 181, 150, 0.08) 0%, rgba(255, 255, 255, 0) 52%),
    linear-gradient(180deg, rgba(36, 42, 35, 0.98) 0%, rgba(29, 35, 28, 0.98) 100%);
  box-shadow: 0 26rpx 56rpx rgba(17, 22, 16, 0.28);
}

.debug-sheet-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.debug-sheet-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #f7f2ea;
}

.debug-sheet-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.58;
  color: rgba(237, 232, 223, 0.74);
}

.debug-sheet-actions {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex-shrink: 0;
}

.debug-sheet-link {
  font-size: 24rpx;
  color: #dce7d0;
}

.debug-log-scroll {
  flex: 1;
  min-height: 0;
}

.debug-log-empty {
  padding: 24rpx 0;
  font-size: 24rpx;
  color: rgba(237, 232, 223, 0.74);
}

.debug-log-item {
  padding: 16rpx 18rpx;
  margin-bottom: 14rpx;
  border-radius: 18rpx;
  border: 1rpx solid rgba(208, 220, 197, 0.08);
  background: rgba(255, 255, 255, 0.04);
}

.debug-log-warn {
  border-color: rgba(214, 187, 129, 0.24);
  background: rgba(214, 187, 129, 0.1);
}

.debug-log-error {
  border-color: rgba(203, 118, 118, 0.24);
  background: rgba(203, 118, 118, 0.1);
}

.debug-log-meta {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex-wrap: wrap;
}

.debug-log-time {
  font-size: 22rpx;
  color: rgba(237, 232, 223, 0.68);
}

.debug-log-stage {
  font-size: 24rpx;
  font-weight: 700;
  color: #f7f2ea;
}

.debug-log-text {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.55;
  color: rgba(237, 232, 223, 0.74);
  word-break: break-all;
  white-space: pre-wrap;
}
