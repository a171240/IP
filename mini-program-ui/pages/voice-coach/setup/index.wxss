@import "../theme.wxss";

page {
  position: fixed;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #efe5d8;
}

.vc-setup-v4,
.vc-setup-v4 .vc-page-scroll-shell,
.vc-setup-v4 .page-scroll {
  height: 100%;
  overflow: hidden;
}

.vc-setup-v4 {
  background: #efe5d8;
  color: #281f1c;
}

.vc-setup-v4 .container {
  min-height: 100%;
  padding: 36rpx 42rpx calc(64rpx + env(safe-area-inset-bottom));
  background: #efe5d8;
}

.vc-setup-v4 view,
.vc-setup-v4 text,
.vc-setup-v4 textarea,
.vc-setup-v4 button {
  box-sizing: border-box;
  letter-spacing: 0;
  font-family: "Inter", "PingFang SC", "Microsoft YaHei", sans-serif;
}

.setup-hero {
  position: relative;
  min-height: 0;
  padding: 20rpx 0 26rpx;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  background: transparent;
  border: 0;
  box-shadow: none;
  overflow: hidden;
}

.setup-hero::after {
  display: none;
}

.setup-hero-copy,
.setup-flow-pill {
  position: relative;
  z-index: 1;
}

.setup-eyebrow {
  align-self: flex-start;
  min-height: 40rpx;
  margin: 0 0 26rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(130, 148, 116, 0.18);
  background: #edf4e8;
  color: #526149;
  font-size: 21rpx;
  line-height: 40rpx;
  font-weight: 800;
}

.setup-title {
  display: block;
  width: auto;
  max-width: 560rpx;
  margin: 0;
  color: #281f1c;
  font-size: 50rpx;
  line-height: 1.22;
  font-weight: 800;
  text-shadow: none;
}

.setup-title text {
  display: block;
  color: inherit;
  font: inherit;
  line-height: inherit;
}

.setup-subtitle {
  display: block;
  width: auto;
  max-width: 600rpx;
  margin-top: 20rpx;
  color: #6e605a;
  font-size: 24rpx;
  line-height: 1.62;
  font-weight: 500;
}

.setup-flow-pill {
  min-height: 86rpx;
  margin-top: 28rpx;
  padding: 16rpx 18rpx;
  border-radius: 32rpx;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  align-items: center;
  gap: 16rpx;
  background: #f8f1e8;
  border: 1rpx solid #d8c8bb;
  box-shadow:
    0 10rpx 22rpx rgba(40, 31, 28, 0.06),
    inset 0 1rpx 0 rgba(244, 236, 228, 0.82);
}

.setup-flow-pill-compact {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.setup-flow-step {
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 14rpx;
  color: #281f1c;
  font-size: 22rpx;
  line-height: 1;
  font-weight: 800;
  text-align: left;
}

.setup-flow-dot {
  width: 46rpx;
  height: 46rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255, 248, 239, 0.74);
  background: #7f8d72;
  font-size: 19rpx;
  line-height: 1;
  font-weight: 800;
}

.setup-flow-copy {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.setup-flow-label,
.setup-flow-caption {
  display: block;
  line-height: 1;
}

.setup-flow-label {
  color: inherit;
  font-size: 23rpx;
  font-weight: 800;
}

.setup-flow-caption {
  color: #8a7b72;
  font-size: 18rpx;
  font-weight: 600;
}

.vc-setup-v4 .setup-flow-step .setup-flow-label {
  color: #281f1c;
}

.vc-setup-v4 .setup-flow-step .setup-flow-caption {
  color: #8a7b72;
}

.setup-flow-step.is-active,
.setup-flow-step.is-done {
  color: #281f1c;
}

.setup-flow-step.is-active .setup-flow-dot,
.setup-flow-step.is-done .setup-flow-dot {
  color: #fff8ef;
  background: #7f8d72;
}

.setup-flow-step.is-locked {
  opacity: 1;
  color: #6e605a;
}

.vc-setup-v4 .setup-flow-step.is-locked .setup-flow-label {
  color: #6e605a;
}

.setup-flow-step.is-locked .setup-flow-dot {
  color: #7f8d72;
  background: #edf4e8;
}

.setup-flow-step.is-locked .setup-flow-caption {
  color: #9a8b82;
}

.vc-setup-v4 .setup-flow-step.is-locked .setup-flow-caption {
  color: #9a8b82;
}

.setup-panel {
  position: relative;
  z-index: 2;
  margin-top: 18rpx;
  padding: 36rpx 32rpx 34rpx;
  border-radius: 36rpx;
  background: #f8f1e8;
  border: 1rpx solid #d8c8bb;
  box-shadow:
    0 14rpx 28rpx rgba(40, 31, 28, 0.07),
    inset 0 1rpx 0 rgba(244, 236, 228, 0.82);
}

.setup-guide-card {
  margin-top: 18rpx;
}

.setup-panel-head,
.setup-action-row,
.setup-secondary-row,
.setup-start-summary,
.setup-summary-line,
.setup-mode-switch {
  display: flex;
  align-items: center;
}

.setup-panel-head {
  justify-content: space-between;
  gap: 22rpx;
}

.setup-card-title {
  display: block;
  color: #281f1c;
  font-size: 33rpx;
  line-height: 1.3;
  font-weight: 700;
}

.setup-card-copy {
  display: block;
  margin-top: 18rpx;
  color: #6e605a;
  font-size: 24rpx;
  line-height: 1.58;
  font-weight: 400;
}

.setup-state-pill {
  flex-shrink: 0;
  min-height: 52rpx;
  padding: 0 20rpx;
  border-radius: 26rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: #526149;
  background: #edf4e8;
  box-shadow:
    0 8rpx 18rpx rgba(40, 31, 28, 0.05),
    inset 0 1rpx 0 rgba(248, 241, 232, 0.56);
  font-size: 23rpx;
  line-height: 52rpx;
  font-weight: 700;
  white-space: nowrap;
}

.setup-state-pill.is-ready {
  color: #526149;
  background: #edf4e8;
}

.setup-profile-box,
.setup-scene-box,
.setup-empty-box,
.setup-start-summary {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 28rpx;
  background: #fff8ef;
  border: 1rpx solid rgba(216, 200, 187, 0.9);
}

.setup-profile-name,
.setup-scene-name {
  display: block;
  color: #281f1c;
  font-size: 31rpx;
  line-height: 1.32;
  font-weight: 800;
}

.setup-profile-meta,
.setup-scene-meta,
.setup-empty-box text {
  display: block;
  margin-top: 10rpx;
  color: #6e605a;
  font-size: 24rpx;
  line-height: 1.42;
  font-weight: 500;
}

.setup-chip-row {
  margin-top: 20rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.setup-chip {
  min-height: 50rpx;
  padding: 0 18rpx;
  border-radius: 25rpx;
  display: inline-flex;
  align-items: center;
  color: #6e605a;
  background: #efe4d9;
  font-size: 21rpx;
  line-height: 50rpx;
  font-weight: 700;
}

.setup-chip.is-accent {
  color: #526149;
  background: #edf4e8;
}

.setup-primary-btn,
.setup-secondary-btn,
.setup-outline-btn,
.setup-ghost-btn {
  min-width: 0;
  height: 76rpx;
  margin: 0;
  padding: 0 26rpx;
  border-radius: 34rpx;
  border: 0;
  font-size: 25rpx;
  line-height: 76rpx;
  font-weight: 800;
  text-align: center;
  overflow: visible;
}

.setup-primary-btn,
.setup-secondary-btn {
  color: #fff8ef;
  background: #7f8d72;
}

.vc-setup-v4 button.setup-primary-btn,
.vc-setup-v4 button.setup-secondary-btn {
  color: #fff8ef;
  background: #7f8d72;
}

.setup-primary-btn {
  box-shadow:
    0 12rpx 24rpx rgba(36, 52, 31, 0.16),
    inset 0 1rpx 0 rgba(248, 241, 232, 0.16);
}

.setup-outline-btn,
.setup-ghost-btn {
  color: #3f352f;
  background: #efe4d9;
}

.vc-setup-v4 button.setup-outline-btn,
.vc-setup-v4 button.setup-ghost-btn {
  color: #3f352f;
  background: #efe4d9;
}

.setup-outline-btn {
  border: 1rpx solid rgba(177, 153, 139, 0.42);
  box-shadow:
    0 8rpx 16rpx rgba(78, 59, 50, 0.04),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.48);
}

.setup-main-btn {
  width: 100%;
  height: 84rpx;
  margin-top: 30rpx;
  border-radius: 42rpx;
  line-height: 84rpx;
  font-size: 27rpx;
}

.setup-secondary-row {
  margin-top: 18rpx;
  gap: 12rpx;
}

.setup-secondary-row button,
.setup-action-row button {
  flex: 1;
}

.setup-action-row {
  margin-top: 24rpx;
  gap: 14rpx;
  flex-wrap: wrap;
}

.setup-action-row button {
  flex-basis: 172rpx;
}

.setup-start-panel {
  padding-top: 36rpx;
}

.setup-start-summary {
  margin-top: 0;
  display: block;
}

.setup-summary-line {
  min-height: 44rpx;
  justify-content: space-between;
  gap: 22rpx;
}

.setup-summary-line + .setup-summary-line {
  margin-top: 14rpx;
}

.setup-summary-label {
  flex-shrink: 0;
  color: #8a7b72;
  font-size: 23rpx;
  line-height: 1.3;
  font-weight: 700;
}

.setup-summary-value {
  min-width: 0;
  color: #281f1c;
  font-size: 25rpx;
  line-height: 1.3;
  font-weight: 800;
  text-align: right;
}

.setup-mode-switch {
  margin-top: 28rpx;
  padding: 8rpx;
  border-radius: 34rpx;
  background: #efe4d9;
  gap: 8rpx;
}

.setup-mode-option {
  flex: 1;
  min-height: 68rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #6e605a;
  font-size: 24rpx;
  line-height: 1;
  font-weight: 800;
}

.setup-mode-option.is-active {
  color: #fff8ef;
  background: #7f8d72;
  box-shadow: 0 8rpx 18rpx rgba(36, 52, 31, 0.12);
}

.setup-textarea {
  width: 100%;
  min-height: 176rpx;
  margin-top: 28rpx;
  padding: 24rpx 28rpx;
  border-radius: 32rpx;
  color: #281f1c;
  background: #fff8ef;
  border: 1rpx solid rgba(216, 200, 187, 0.9);
  box-shadow: inset 0 1rpx 0 rgba(248, 241, 232, 0.7);
  font-size: 25rpx;
  line-height: 1.5;
  font-weight: 600;
}

.setup-support-card {
  position: relative;
  z-index: 1;
  margin-top: 26rpx;
  padding: 28rpx 30rpx;
  border-radius: 34rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  background:
    linear-gradient(135deg, rgba(237, 244, 232, 0.86) 0%, rgba(248, 241, 232, 0.90) 56%, rgba(239, 228, 217, 0.86) 100%);
  border: 1rpx solid rgba(130, 148, 116, 0.18);
  box-shadow:
    0 14rpx 28rpx rgba(40, 31, 28, 0.05),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.68);
}

.setup-support-visual {
  position: relative;
  width: 126rpx;
  height: 112rpx;
  flex-shrink: 0;
}

.setup-visual-sheet {
  position: absolute;
  left: 4rpx;
  top: 10rpx;
  width: 104rpx;
  height: 86rpx;
  padding: 18rpx 14rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #fff8ef;
  border: 1rpx solid rgba(216, 200, 187, 0.8);
  box-shadow: 0 12rpx 22rpx rgba(73, 57, 49, 0.08);
}

.setup-visual-avatar {
  width: 34rpx;
  height: 48rpx;
  border-radius: 17rpx 17rpx 14rpx 14rpx;
  background: #b98a7f;
}

.setup-visual-lines {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.setup-visual-lines view {
  height: 8rpx;
  border-radius: 999rpx;
  background: #d8c8bb;
}

.setup-visual-lines view:first-child {
  width: 42rpx;
  background: #7f8d72;
}

.setup-visual-lines view:nth-child(2) {
  width: 34rpx;
}

.setup-visual-lines view:nth-child(3) {
  width: 24rpx;
}

.setup-visual-badge {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff8ef;
  background: #7f8d72;
  border: 4rpx solid #efe5d8;
  box-shadow: 0 10rpx 18rpx rgba(36, 52, 31, 0.14);
  font-size: 19rpx;
  line-height: 1;
  font-weight: 800;
}

.setup-support-copy {
  min-width: 0;
  flex: 1;
}

.setup-support-title {
  display: block;
  color: #281f1c;
  font-size: 27rpx;
  line-height: 1.34;
  font-weight: 800;
}

.setup-support-text {
  display: block;
  margin-top: 12rpx;
  color: #6e605a;
  font-size: 22rpx;
  line-height: 1.56;
  font-weight: 500;
}

button::after {
  border: none;
}

button[disabled] {
  opacity: 0.74;
}

.setup-outline-btn[disabled],
.setup-ghost-btn[disabled] {
  color: #6e605a;
  background: #eee3d9;
  opacity: 1;
}

.vc-setup-v4 button.setup-outline-btn[disabled],
.vc-setup-v4 button.setup-ghost-btn[disabled] {
  color: #6e605a;
  background: #eee3d9;
  opacity: 1;
}

button:active,
.setup-mode-option:active {
  opacity: 0.94;
}

.fade-up {
  animation: setupFadeUp 360ms ease both;
}

.delay-1 {
  animation-delay: 60ms;
}

.delay-2 {
  animation-delay: 110ms;
}

@keyframes setupFadeUp {
  from {
    opacity: 0;
    transform: translateY(10rpx);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.debug-pill {
  position: fixed;
  top: calc(18rpx + env(safe-area-inset-top));
  right: 24rpx;
  z-index: 120;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 92rpx;
  height: 50rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(167, 181, 154, 0.28);
  background: rgba(27, 34, 28, 0.92);
  box-shadow:
    0 12rpx 22rpx rgba(17, 22, 16, 0.22),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.06);
  color: #e4edd7;
  font-size: 22rpx;
  font-weight: 700;
}

.debug-mask {
  position: fixed;
  inset: 0;
  z-index: 109;
  background: rgba(17, 22, 16, 0.32);
}

.debug-sheet {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  z-index: 110;
  height: min(920rpx, 72vh);
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 28rpx 24rpx;
  border-radius: 28rpx;
  border: 1rpx solid rgba(208, 220, 197, 0.12);
  background: linear-gradient(180deg, rgba(36, 42, 35, 0.98) 0%, rgba(29, 35, 28, 0.98) 100%);
  box-shadow: 0 26rpx 56rpx rgba(17, 22, 16, 0.28);
}

.debug-sheet-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.debug-sheet-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #f7f2ea;
}

.debug-sheet-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.58;
  color: rgba(237, 232, 223, 0.74);
}

.debug-sheet-actions {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex-shrink: 0;
}

.debug-sheet-link {
  font-size: 24rpx;
  color: #dce7d0;
}

.debug-log-scroll {
  flex: 1;
  min-height: 0;
}

.debug-log-empty {
  padding: 24rpx 0;
  font-size: 24rpx;
  color: rgba(237, 232, 223, 0.74);
}

.debug-log-item {
  padding: 16rpx 18rpx;
  margin-bottom: 14rpx;
  border-radius: 18rpx;
  border: 1rpx solid rgba(208, 220, 197, 0.08);
  background: rgba(255, 255, 255, 0.04);
}

.debug-log-warn {
  border-color: rgba(214, 187, 129, 0.24);
  background: rgba(214, 187, 129, 0.1);
}

.debug-log-error {
  border-color: rgba(203, 118, 118, 0.24);
  background: rgba(203, 118, 118, 0.1);
}

.debug-log-meta {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex-wrap: wrap;
}

.debug-log-time {
  font-size: 22rpx;
  color: rgba(237, 232, 223, 0.68);
}

.debug-log-stage {
  font-size: 24rpx;
  font-weight: 700;
  color: #f7f2ea;
}

.debug-log-text {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.55;
  color: rgba(237, 232, 223, 0.74);
  word-break: break-all;
  white-space: pre-wrap;
}

@media (max-width: 420rpx) {
  .vc-setup-v4 .container {
    padding-left: 46rpx;
    padding-right: 46rpx;
  }

  .setup-title,
  .setup-subtitle {
    width: auto;
    max-width: 100%;
  }

  .setup-panel-head,
  .setup-secondary-row {
    align-items: stretch;
    flex-direction: column;
  }

  .setup-action-row button {
    flex-basis: 150rpx;
  }
}
