<view class="vc-page vc-setup-page vc-flow-v2 vc-setup-v2">
  <view wx:if="{{debugPanelEnabled}}" class="debug-pill" bindtap="toggleDebugPanel">日志</view>
  <view class="vc-page-scroll-shell">
    <scroll-view class="page-scroll" scroll-y="true" enhanced="true" bounces="false" show-scrollbar="false">
      <view class="container">
      <view class="hero compact-hero fade-up">
        <text class="eyebrow">训练配置</text>
        <text class="title">配置好就开始练</text>
        <text class="subtitle">三步完成，不用先读一堆说明。</text>
      </view>

      <view class="section fade-up delay-1">
        <view class="setup-step-card">
          <view class="setup-step-head">
            <view class="setup-step-index">1</view>
            <view class="setup-step-copy">
              <text class="card-title">顾客</text>
              <text class="setup-step-note">{{customerProfile ? customerProfile.name : '还没选择顾客档案'}}</text>
            </view>
          </view>

          <view wx:if="{{customerProfile}}" class="setup-chip-row">
            <text wx:if="{{customerMeta}}" class="tag tag-accent">{{customerMeta}}</text>
            <text wx:if="{{customerProfile.core_concerns.length}}" class="tag">{{customerProfile.core_concerns[0]}}</text>
          </view>

          <view wx:if="{{!customerProfile}}" class="setup-empty-copy">可以先直接用测试顾客。</view>

          <view class="setup-action-row">
            <button
              class="btn-primary"
              size="mini"
              loading="{{preparingTestCustomer}}"
              disabled="{{preparingTestCustomer}}"
              bindtap="handleUseTestCustomer"
            >
              {{customerProfile ? '切换测试顾客' : '直接用测试顾客'}}
            </button>
            <button class="btn-outline" size="mini" bindtap="handlePickCustomerProfile">{{customerProfile ? '更换' : '选择'}}</button>
            <button wx:if="{{customerProfile}}" class="btn-outline" size="mini" bindtap="handleClearCustomerProfile">清空</button>
            <button wx:else class="btn-outline" size="mini" bindtap="handleCreateCustomerProfile">新建</button>
          </view>
        </view>
      </view>

      <view class="section fade-up delay-1">
        <view class="setup-step-card">
          <view class="setup-step-head">
            <view class="setup-step-index">2</view>
            <view class="setup-step-copy">
              <text class="card-title">场景卡</text>
              <text class="setup-step-note">{{sceneCard ? sceneCard.name : '还没选择场景卡'}}</text>
            </view>
          </view>

          <view wx:if="{{sceneCard}}" class="setup-chip-row">
            <text class="tag tag-accent">{{sceneCard.scene_kind_label}}</text>
            <text wx:if="{{sceneMeta}}" class="tag">{{sceneMeta}}</text>
          </view>

          <view wx:if="{{!sceneCard}}" class="setup-empty-copy">先选一个重点场景，这轮训练才不会发散。</view>

          <view class="setup-action-row">
            <button
              class="btn-primary"
              size="mini"
              loading="{{preparingTestSceneCard}}"
              disabled="{{preparingTestSceneCard}}"
              bindtap="handleUseTestSceneCard"
            >
              {{sceneCard ? '切换测试场景卡' : '直接用测试场景卡'}}
            </button>
            <button class="btn-outline" size="mini" bindtap="handlePickSceneCard">{{sceneCard ? '更换' : '选择场景卡'}}</button>
            <button class="btn-outline" size="mini" bindtap="handleCreateSceneCard">新建</button>
            <button wx:if="{{sceneCard}}" class="btn-outline" size="mini" bindtap="handleClearSceneCard">清空</button>
          </view>
        </view>
      </view>

      <view class="section fade-up delay-2">
        <view class="setup-step-card">
          <view class="setup-step-head">
            <view class="setup-step-index">3</view>
            <view class="setup-step-copy">
              <text class="card-title">备注</text>
              <text class="setup-step-note">只写本次特殊背景。</text>
            </view>
          </view>

          <textarea
            class="input textarea compact-textarea"
            maxlength="500"
            placeholder="例如：明天下午来做护理，这轮重点练破冰和价格异议。"
            value="{{liveNotes}}"
            bindinput="onLiveNotes"
          />
        </view>
      </view>

      <view class="section fade-up delay-2">
        <view class="footer-cta-card minimal-footer-card">
          <text class="tips-title">开始训练</text>
          <text class="tips-copy">进入后，顾客会按当前顾客档案和场景卡来提问。</text>
          <button class="btn-primary" loading="{{starting}}" disabled="{{starting}}" bindtap="handleStart">开始语音训练</button>
        </view>
      </view>
      </view>
    </scroll-view>
  </view>

  <view class="debug-mask" wx:if="{{debugPanelVisible}}" bindtap="closeDebugPanel"></view>
  <view class="debug-sheet" wx:if="{{debugPanelVisible}}">
    <view class="debug-sheet-head">
      <view>
        <view class="debug-sheet-title">调试日志</view>
        <view class="debug-sheet-sub">扫码预览时也能直接查看训练配置链路</view>
      </view>
      <view class="debug-sheet-actions">
        <view class="debug-sheet-link" bindtap="clearDebugPanel">清空</view>
        <view class="debug-sheet-link" bindtap="closeDebugPanel">关闭</view>
      </view>
    </view>

    <scroll-view class="debug-log-scroll" scroll-y="true" enhanced="true" bounces="false" show-scrollbar="false">
      <view wx:if="{{!debugLogs.length}}" class="debug-log-empty">当前还没有日志</view>
      <view wx:for="{{debugLogs}}" wx:key="id" class="debug-log-item debug-log-{{item.level}}">
        <view class="debug-log-meta">
          <text class="debug-log-time">{{item.timeText}}</text>
          <text class="debug-log-stage">{{item.stage}}</text>
        </view>
        <text wx:if="{{item.metaText}}" class="debug-log-text">{{item.metaText}}</text>
      </view>
    </scroll-view>
  </view>
</view>
