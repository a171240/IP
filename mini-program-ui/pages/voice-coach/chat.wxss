/* 1.5 寮圭獥涓庡叆鍦哄姩鐢?*/
.modal-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  backdrop-filter: blur(12rpx);
  background: rgba(0, 0, 0, 0.6);
  z-index: 90;
  transition: all 0.3s;
}

.end-modal {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: 24rpx;
  z-index: 100;
  background: var(--vc-surface);
  border: 2rpx solid var(--vc-border);
  border-radius: 26rpx;
  padding: 22rpx;
}

.end-modal, .hint-sheet {
  animation: slideUp 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

@keyframes slideUp {
  from { transform: translateY(100%); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

.hint-sheet {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  z-index: 100;
