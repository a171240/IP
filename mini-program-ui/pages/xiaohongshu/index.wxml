<view class="page page-xhs-workbench">
  <view class="xhs-page-scroll-shell">
    <scroll-view
      class="page-scroll"
      scroll-y="true"
      enhanced="true"
      bounces="false"
      refresher-enabled="{{false}}"
      show-scrollbar="{{false}}"
    >
      <view class="xhs-container">
        <view class="xhs-hero fade-up">
          <view class="xhs-hero-head">
            <view class="xhs-hero-copy">
              <text class="xhs-eyebrow">发文入口</text>
              <view class="xhs-title">
                <text>小红书</text>
                <text>发文工作台</text>
              </view>
              <text class="xhs-subtitle">选题、正文、封面、发布收进一条清晰流程。</text>
            </view>
            <button class="xhs-draft-btn" bindtap="handleOpenDrafts">草稿</button>
          </view>

          <view class="xhs-flow-pill">
            <view class="xhs-flow-step is-active">
              <view class="xhs-flow-dot"></view>
              <text>方向</text>
            </view>
            <view class="xhs-flow-step {{resultContent ? 'is-active' : ''}}">
              <view class="xhs-flow-dot"></view>
              <text>正文</text>
            </view>
            <view class="xhs-flow-step {{coverImageUrl ? 'is-active' : ''}}">
              <view class="xhs-flow-dot"></view>
              <text>封面</text>
            </view>
            <view class="xhs-flow-step {{publishResult ? 'is-active' : ''}}">
              <view class="xhs-flow-dot"></view>
              <text>发布</text>
            </view>
          </view>
        </view>

        <view class="xhs-compose-card fade-up delay-1">
          <view class="xhs-card-head">
            <view>
              <text class="xhs-card-title">创作输入</text>
              <text class="xhs-card-copy">先把主题、内容类型和门店语气定准。</text>
            </view>
            <text class="xhs-card-badge">主任务</text>
          </view>

          <view class="xhs-type-row">
            <view
              wx:for="{{contentTypes}}"
              wx:key="id"
              class="xhs-type-chip {{contentType === item.id ? 'is-selected' : ''}}"
              data-type="{{item.id}}"
              bindtap="onSelectType"
            >
              {{item.label}}
            </view>
          </view>

          <view class="xhs-field-stack">
            <view class="xhs-field">
              <text class="xhs-field-label">今天要写的主题</text>
              <input
                class="xhs-input"
                placeholder="例如：五一补水体验、老客复购活动"
                value="{{topic}}"
                bindinput="onTopicInput"
              />
            </view>

            <view class="xhs-field">
              <text class="xhs-field-label">关键词 / 标签</text>
              <input
                class="xhs-input"
                placeholder="项目、功效、到店场景、目标人群"
                value="{{keywords}}"
                bindinput="onKeywordsInput"
              />
            </view>

            <view class="xhs-field">
              <text class="xhs-field-label">表达强度</text>
              <view class="xhs-level-row">
                <view class="xhs-level-chip {{conflictLevel === 'safe' ? 'is-selected' : ''}}" data-level="safe" bindtap="onSelectConflict">稳健</view>
                <view class="xhs-level-chip {{conflictLevel === 'standard' ? 'is-selected' : ''}}" data-level="standard" bindtap="onSelectConflict">标准</view>
                <view class="xhs-level-chip {{conflictLevel === 'hard' ? 'is-selected' : ''}}" data-level="hard" bindtap="onSelectConflict">更有张力</view>
              </view>
            </view>

            <view class="xhs-store-panel">
              <view class="xhs-store-copy">
                <text class="xhs-field-label">门店档案</text>
                <text class="xhs-store-label">{{storeProfileLabel}}</text>
              </view>
              <button class="xhs-light-btn" bindtap="handleOpenStoreProfiles">切换</button>
            </view>
          </view>

          <button
            class="xhs-primary-btn xhs-generate-btn"
            loading="{{isGenerating}}"
            disabled="{{isGenerating}}"
            bindtap="handleGenerate"
          >
            {{resultContent ? '重新生成正文' : '生成正文'}}
          </button>
          <text class="xhs-action-note">生成后再补封面和发布，不把所有功能堆在首屏。</text>
        </view>

        <view class="xhs-delivery-stack fade-up delay-2">
          <view class="xhs-stack-head">
            <view>
              <text class="xhs-section-title">交付队列</text>
              <text class="xhs-section-copy">正文、封面、发布按顺序完成，下一步始终清楚。</text>
            </view>
            <text class="xhs-card-badge {{publishResult ? 'is-ready' : ''}}">{{publishResult ? '已完成' : '进行中'}}</text>
          </view>

          <view class="xhs-work-card {{resultContent ? 'is-ready' : ''}}">
            <view class="xhs-work-head">
              <view>
                <text class="xhs-work-kicker">01 正文</text>
                <text class="xhs-work-title">{{resultTitle ? resultTitle : '等待生成标题'}}</text>
              </view>
              <text class="xhs-status-pill {{dangerStatusClass}}">{{dangerStatusText}}</text>
            </view>

            <textarea
              class="xhs-output-area"
              value="{{resultContent ? resultContent : ''}}"
              maxlength="-1"
              auto-height="true"
              disabled="true"
              placeholder="生成后的正文会显示在这里"
            ></textarea>

            <view wx:if="{{resultTags.length}}" class="xhs-tag-row">
              <text class="xhs-result-tag" wx:for="{{resultTags}}" wx:key="*this">{{item}}</text>
            </view>

            <view wx:if="{{resultContent}}" class="xhs-card-actions">
              <button class="xhs-secondary-btn" bindtap="handleCopy" disabled="{{!resultContent}}">复制正文</button>
              <button class="xhs-secondary-btn" bindtap="handleGenerate" loading="{{isGenerating}}" disabled="{{isGenerating}}">重写</button>
            </view>
            <text wx:else class="xhs-empty-note">先在上方输入主题，生成后这里会承接正文、标签和风控状态。</text>
          </view>

          <view class="xhs-work-card {{coverImageUrl ? 'is-ready' : ''}}">
            <view class="xhs-work-head">
              <view>
                <text class="xhs-work-kicker">02 封面</text>
                <text class="xhs-work-title">首图与置顶评论</text>
              </view>
              <text class="xhs-status-pill {{coverImageUrl ? 'is-success' : ''}}">{{coverImageUrl ? '封面已生成' : '待生成'}}</text>
            </view>

            <view wx:if="{{coverImageUrl}}" class="xhs-cover-preview">
              <image src="{{coverImageUrl}}" mode="aspectFill" class="xhs-cover-image" />
            </view>

            <view wx:else class="xhs-cover-empty">
              <view class="xhs-cover-thumb"></view>
              <view class="xhs-cover-lines">
                <view class="xhs-cover-line strong"></view>
                <view class="xhs-cover-line"></view>
                <view class="xhs-cover-pill"></view>
              </view>
            </view>

            <view wx:if="{{pinnedComment}}" class="xhs-sub-block">
              <text class="xhs-field-label">置顶评论</text>
              <textarea class="xhs-output-area is-compact" value="{{pinnedComment}}" maxlength="-1" auto-height="true" disabled="true"></textarea>
            </view>

            <view wx:if="{{coverPrompt}}" class="xhs-sub-block">
              <text class="xhs-field-label">首图提示词</text>
              <textarea class="xhs-output-area is-compact" value="{{coverPrompt}}" maxlength="-1" auto-height="true" disabled="true"></textarea>
            </view>

            <view class="xhs-card-actions">
              <button class="xhs-primary-btn" loading="{{isCoverLoading}}" disabled="{{!resultContent || isCoverLoading}}" bindtap="handleGenerateCover">{{coverImageUrl ? '重做封面' : '生成封面'}}</button>
              <button wx:if="{{pinnedComment}}" class="xhs-secondary-btn" bindtap="handleCopyPinned">复制评论</button>
              <button wx:if="{{coverPrompt}}" class="xhs-secondary-btn" bindtap="handleCopyCoverPrompt">复制提示词</button>
            </view>
          </view>

          <view class="xhs-work-card {{publishResult ? 'is-ready' : ''}}">
            <view class="xhs-work-head">
              <view>
                <text class="xhs-work-kicker">03 发布</text>
                <text class="xhs-work-title">确认后发布到小红书</text>
              </view>
              <text class="xhs-status-pill {{publishResult ? 'is-success' : ''}}">{{publishResult ? '已发布' : '待发布'}}</text>
            </view>

            <view class="xhs-readiness">
              <view class="xhs-readiness-item {{resultContent ? 'is-done' : ''}}">
                <text class="xhs-readiness-mark"></text>
                <text>正文</text>
              </view>
              <view class="xhs-readiness-item {{coverImageUrl ? 'is-done' : ''}}">
                <text class="xhs-readiness-mark"></text>
                <text>封面</text>
              </view>
            </view>

            <button class="xhs-primary-btn xhs-publish-btn" loading="{{isPublishing}}" disabled="{{!resultContent || !coverImageUrl || isPublishing}}" bindtap="handlePublish">立即发布</button>

            <view wx:if="{{publishResult}}" class="xhs-publish-result">
              <text class="xhs-field-label">发布链接</text>
              <text class="xhs-publish-link">{{publishResult.publishUrl}}</text>
              <image wx:if="{{publishResult.qrImageUrl}}" src="{{publishResult.qrImageUrl}}" mode="widthFix" class="xhs-qr-image" />
            </view>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>
</view>
