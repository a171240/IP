.page-xhs-workbench .xhs-flow-step.is-active .xhs-icon-direction .xhs-icon-needle::before,
.page-xhs-workbench .xhs-flow-step.is-active .xhs-icon-copy::before,
.page-xhs-workbench .xhs-flow-step.is-active .xhs-icon-cover::before,
