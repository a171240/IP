page {
  position: fixed;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #21181c;
}

.page-xhs-workbench,
.page-xhs-workbench .xhs-page-scroll-shell,
.page-xhs-workbench .page-scroll {
  height: 100%;
  overflow: hidden;
}

.page-xhs-workbench {
  color: #24191d;
  background: #efe5d8;
}

.page-xhs-workbench .xhs-container {
  min-height: 100%;
  padding: 85rpx 46rpx calc(188rpx + env(safe-area-inset-bottom));
  background:
    linear-gradient(180deg, #21181c 0rpx, #21181c 500rpx, #efe5d8 500rpx, #efe5d8 100%);
  box-sizing: border-box;
}

.page-xhs-workbench view,
.page-xhs-workbench text,
.page-xhs-workbench input,
.page-xhs-workbench textarea,
.page-xhs-workbench button {
  box-sizing: border-box;
  letter-spacing: 0;
  font-family: "Inter", "PingFang SC", "Microsoft YaHei", sans-serif;
}

.xhs-hero {
  position: relative;
  height: 604rpx;
  padding: 56rpx 58rpx 50rpx;
  border-radius: 62rpx;
  display: flex;
  flex-direction: column;
  background: #21181c;
  border: 1rpx solid rgba(91, 52, 56, 0.3);
  box-shadow:
    0 28rpx 54rpx rgba(40, 31, 28, 0.24),
    inset 0 1rpx 0 rgba(255, 244, 237, 0.05);
  overflow: hidden;
}

.xhs-hero-head {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 96rpx;
  gap: 20rpx;
  align-items: flex-start;
}

.xhs-hero-copy {
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.xhs-eyebrow {
  align-self: flex-start;
  min-height: 44rpx;
  margin: 0 0 34rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  color: rgba(255, 244, 237, 0.82);
  font-size: 23rpx;
  line-height: 44rpx;
  font-weight: 800;
}

.xhs-title {
  display: block;
  width: 420rpx;
  margin: 0;
  color: #fff4ed;
  font-size: 56rpx;
  line-height: 1.1;
  font-weight: 800;
}

.xhs-title text {
  display: block;
  color: inherit;
  font: inherit;
  line-height: inherit;
}

.xhs-subtitle {
  display: block;
  width: 420rpx;
  margin-top: 28rpx;
  color: rgba(241, 230, 220, 0.78);
  font-size: 27rpx;
  line-height: 1.48;
  font-weight: 500;
}

.xhs-draft-btn {
  position: relative;
  z-index: 1;
  width: 96rpx;
  min-height: 64rpx;
  margin: 0;
  padding: 0;
  border-radius: 32rpx;
  border: 1rpx solid rgba(255, 244, 237, 0.18);
  color: #fff4ed;
  background: rgba(255, 244, 237, 0.12);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.08);
  font-size: 23rpx;
  line-height: 64rpx;
  font-weight: 800;
}

.xhs-flow-pill {
  position: relative;
  z-index: 1;
  height: 112rpx;
  margin-top: auto;
  padding: 0 28rpx;
  border-radius: 48rpx;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  align-items: center;
  gap: 12rpx;
  background: #a9655a;
  box-shadow:
    0 18rpx 32rpx rgba(112, 61, 57, 0.22),
    inset 0 1rpx 0 rgba(255, 244, 237, 0.12);
}

.xhs-flow-step {
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  color: rgba(255, 244, 237, 0.74);
  font-size: 21rpx;
  line-height: 1;
  font-weight: 800;
  text-align: center;
}

.xhs-flow-dot {
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: rgba(91, 52, 56, 0.62);
}

.xhs-flow-step.is-active {
  color: #fff4ed;
}

.xhs-flow-step.is-active .xhs-flow-dot {
  background: #fff4ed;
}

.xhs-compose-card,
.xhs-work-card {
  border-radius: 54rpx;
  background: #fff4ed;
  border: 1rpx solid #dac8bb;
  box-shadow:
    0 16rpx 34rpx rgba(40, 31, 28, 0.08),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.68);
}

.xhs-compose-card {
  position: relative;
  z-index: 2;
  margin-top: 60rpx;
  padding: 50rpx 44rpx 42rpx;
}

.xhs-card-head,
.xhs-stack-head,
.xhs-work-head,
.xhs-store-panel,
.xhs-card-actions,
.xhs-readiness {
  display: flex;
  align-items: center;
}

.xhs-card-head,
.xhs-stack-head,
.xhs-work-head {
  justify-content: space-between;
  gap: 22rpx;
}

.xhs-card-title,
.xhs-section-title,
.xhs-work-title {
  display: block;
  color: #24191d;
  font-weight: 800;
}

.xhs-card-title {
  font-size: 38rpx;
  line-height: 1.22;
}

.xhs-card-copy,
.xhs-section-copy,
.xhs-action-note,
.xhs-store-label {
  display: block;
  color: rgba(36, 25, 29, 0.62);
  font-weight: 500;
}

.xhs-card-copy,
.xhs-section-copy {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.42;
}

.xhs-card-badge {
  flex-shrink: 0;
  min-height: 58rpx;
  padding: 0 24rpx;
  border-radius: 29rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: #6f4b48;
  background: #f1e6dc;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.55);
  font-size: 22rpx;
  line-height: 58rpx;
  font-weight: 800;
  white-space: nowrap;
}

.xhs-card-badge.is-ready {
  color: #526149;
  background: #edf4e8;
}

.xhs-type-row {
  margin-top: 32rpx;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12rpx;
}

.xhs-type-chip,
.xhs-level-chip {
  min-width: 0;
  min-height: 64rpx;
  padding: 0 18rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #6f625a;
  background: #fff9f3;
  border: 1rpx solid #dac8bb;
  font-size: 23rpx;
  line-height: 1.2;
  font-weight: 800;
  text-align: center;
}

.xhs-type-chip.is-selected,
.xhs-level-chip.is-selected {
  color: #fff4ed;
  background: #7f8d72;
  border-color: rgba(127, 141, 114, 0.55);
}

.xhs-field-stack {
  margin-top: 32rpx;
  display: grid;
  gap: 24rpx;
}

.xhs-field {
  display: grid;
  gap: 12rpx;
}

.xhs-field-label {
  display: block;
  color: #24191d;
  font-size: 24rpx;
  line-height: 1.35;
  font-weight: 800;
}

.xhs-input,
.xhs-output-area {
  width: 100%;
  margin: 0;
  padding: 0 28rpx;
  border-radius: 28rpx;
  color: #24191d;
  background: #f1e6dc;
  border: 1rpx solid #dac8bb;
  font-size: 25rpx;
  font-weight: 600;
}

.xhs-input {
  height: 84rpx;
  line-height: 84rpx;
}

.xhs-output-area {
  min-height: 190rpx;
  margin-top: 26rpx;
  padding-top: 24rpx;
  padding-bottom: 24rpx;
  line-height: 1.55;
}

.xhs-output-area.is-compact {
  min-height: 112rpx;
  margin-top: 12rpx;
  font-size: 23rpx;
}

.xhs-level-row {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
}

.xhs-store-panel {
  min-height: 116rpx;
  padding: 24rpx;
  border-radius: 34rpx;
  justify-content: space-between;
  gap: 20rpx;
  background: #f1e6dc;
  border: 1rpx solid #dac8bb;
}

.xhs-store-copy {
  min-width: 0;
}

.xhs-store-label {
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.35;
  word-break: break-word;
}

.xhs-light-btn {
  flex-shrink: 0;
  width: 120rpx;
  min-height: 64rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 32rpx;
  color: #6f4b48;
  background: #fff4ed;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.56);
  font-size: 23rpx;
  line-height: 64rpx;
  font-weight: 800;
}

.xhs-primary-btn,
.xhs-secondary-btn {
  min-width: 0;
  height: 76rpx;
  margin: 0;
  padding: 0 28rpx;
  border-radius: 34rpx;
  border: 0;
  font-size: 25rpx;
  line-height: 76rpx;
  font-weight: 800;
  text-align: center;
}

.xhs-primary-btn {
  color: #fff4ed;
  background: #a9655a;
  box-shadow:
    0 12rpx 24rpx rgba(112, 61, 57, 0.16),
    inset 0 1rpx 0 rgba(255, 244, 237, 0.12);
}

.xhs-secondary-btn {
  color: #6f625a;
  background: #f1e6dc;
}

.xhs-generate-btn {
  width: 100%;
  height: 88rpx;
  margin-top: 34rpx;
  border-radius: 36rpx;
  line-height: 88rpx;
  font-size: 28rpx;
}

.xhs-action-note {
  margin-top: 20rpx;
  font-size: 23rpx;
  line-height: 1.45;
}

.xhs-delivery-stack {
  margin-top: 58rpx;
  display: grid;
  gap: 30rpx;
}

.xhs-stack-head {
  padding: 0 6rpx;
}

.xhs-section-title {
  font-size: 36rpx;
  line-height: 1.22;
}

.xhs-work-card {
  padding: 38rpx;
}

.xhs-work-card.is-ready {
  border-color: rgba(169, 101, 90, 0.35);
}

.xhs-work-head {
  align-items: flex-start;
}

.xhs-work-kicker {
  display: block;
  margin-bottom: 10rpx;
  color: #a9655a;
  font-size: 21rpx;
  line-height: 1.2;
  font-weight: 900;
}

.xhs-work-title {
  max-width: 390rpx;
  font-size: 32rpx;
  line-height: 1.3;
  word-break: break-word;
}

.xhs-status-pill {
  flex-shrink: 0;
  min-height: 52rpx;
  padding: 0 20rpx;
  border-radius: 26rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: #6f625a;
  background: #f1e6dc;
  font-size: 21rpx;
  line-height: 52rpx;
  font-weight: 800;
  white-space: nowrap;
}

.xhs-status-pill.tag-success,
.xhs-status-pill.is-success {
  color: #526149;
  background: #edf4e8;
}

.xhs-status-pill.tag-accent {
  color: #8f4d49;
  background: #f4dfd7;
}

.xhs-tag-row {
  margin-top: 22rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.xhs-result-tag {
  min-height: 48rpx;
  padding: 0 18rpx;
  border-radius: 24rpx;
  display: inline-flex;
  align-items: center;
  color: #6f4b48;
  background: #f1e6dc;
  font-size: 21rpx;
  line-height: 48rpx;
  font-weight: 800;
}

.xhs-card-actions {
  margin-top: 28rpx;
  gap: 14rpx;
  flex-wrap: wrap;
}

.xhs-card-actions .xhs-primary-btn,
.xhs-card-actions .xhs-secondary-btn {
  flex: 1 1 180rpx;
}

.xhs-empty-note {
  display: block;
  margin-top: 20rpx;
  color: rgba(36, 25, 29, 0.58);
  font-size: 23rpx;
  line-height: 1.45;
  font-weight: 600;
}

.xhs-cover-preview {
  margin-top: 26rpx;
  border-radius: 34rpx;
  overflow: hidden;
  background: #f1e6dc;
  border: 1rpx solid #dac8bb;
}

.xhs-cover-image {
  display: block;
  width: 100%;
  height: 420rpx;
}

.xhs-cover-empty {
  min-height: 232rpx;
  margin-top: 26rpx;
  padding: 28rpx;
  border-radius: 34rpx;
  display: grid;
  grid-template-columns: 150rpx minmax(0, 1fr);
  align-items: center;
  gap: 28rpx;
  background: #f1e6dc;
  border: 1rpx solid #dac8bb;
}

.xhs-cover-thumb {
  height: 164rpx;
  border-radius: 34rpx;
  background: #dac8bb;
}

.xhs-cover-lines {
  min-width: 0;
}

.xhs-cover-line {
  width: 72%;
  height: 16rpx;
  margin-top: 24rpx;
  border-radius: 8rpx;
  background: rgba(169, 101, 90, 0.22);
}

.xhs-cover-line.strong {
  width: 92%;
  margin-top: 0;
  background: #a9655a;
}

.xhs-cover-pill {
  width: 150rpx;
  height: 54rpx;
  margin-top: 36rpx;
  border-radius: 27rpx;
  background: #a9655a;
}

.xhs-sub-block {
  margin-top: 28rpx;
}

.xhs-readiness {
  margin-top: 28rpx;
  gap: 14rpx;
}

.xhs-readiness-item {
  flex: 1;
  min-height: 74rpx;
  padding: 0 20rpx;
  border-radius: 34rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  color: #6f625a;
  background: #f1e6dc;
  font-size: 24rpx;
  line-height: 1.2;
  font-weight: 800;
}

.xhs-readiness-mark {
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  background: #dac8bb;
}

.xhs-readiness-item.is-done {
  color: #526149;
  background: #edf4e8;
}

.xhs-readiness-item.is-done .xhs-readiness-mark {
  background: #7f8d72;
}

.xhs-publish-btn {
  width: 100%;
  margin-top: 28rpx;
}

.xhs-publish-result {
  margin-top: 28rpx;
  padding: 24rpx;
  border-radius: 34rpx;
  background: #f1e6dc;
  border: 1rpx solid #dac8bb;
}

.xhs-publish-link {
  display: block;
  margin-top: 12rpx;
  color: #6f4b48;
  font-size: 23rpx;
  line-height: 1.45;
  font-weight: 700;
  word-break: break-all;
}

.xhs-qr-image {
  display: block;
  width: 220rpx;
  margin-top: 20rpx;
  border-radius: 24rpx;
}

button::after {
  border: none;
}

button[disabled] {
  opacity: 0.58;
}

button:active,
.xhs-type-chip:active,
.xhs-level-chip:active,
.xhs-readiness-item:active {
  opacity: 0.94;
}

.fade-up {
  animation: xhsFadeUp 360ms ease both;
}

.delay-1 {
  animation-delay: 60ms;
}

.delay-2 {
  animation-delay: 110ms;
}

@keyframes xhsFadeUp {
  from {
    opacity: 0;
    transform: translateY(10rpx);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@media (max-width: 420rpx) {
  .page-xhs-workbench .xhs-container {
    padding-left: 46rpx;
    padding-right: 46rpx;
  }

  .xhs-type-row {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .xhs-hero-head,
  .xhs-card-head,
  .xhs-stack-head,
  .xhs-work-head,
  .xhs-store-panel {
    grid-template-columns: minmax(0, 1fr);
  }

  .xhs-card-head,
  .xhs-stack-head,
  .xhs-work-head,
  .xhs-store-panel {
    align-items: flex-start;
    flex-direction: column;
  }

  .xhs-work-title,
  .xhs-title,
  .xhs-subtitle {
    width: auto;
    max-width: 100%;
  }

  .xhs-draft-btn,
  .xhs-light-btn {
    width: auto;
    min-width: 120rpx;
  }

  .xhs-cover-empty {
    grid-template-columns: minmax(0, 1fr);
  }
}
