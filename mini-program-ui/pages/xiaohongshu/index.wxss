.page-xhs-workbench .xhs-flow-step.is-active .xhs-icon-line,
.page-xhs-workbench .xhs-flow-step.is-active .xhs-icon-sun,
.page-xhs-workbench .xhs-flow-step.is-active .xhs-icon-mountain,
.page-xhs-workbench .xhs-flow-step.is-active .xhs-icon-arrow,
.page-xhs-workbench .xhs-flow-step.is-active .xhs-icon-tray {
