.page-pay-checkout .pay-plan-card {
  gap: 16rpx;
}

.page-pay-checkout .pay-plan-card-pro {
  border-color: rgba(229, 211, 179, 0.24);
  box-shadow: 0 18rpx 44rpx rgba(0, 0, 0, 0.28), 0 0 0 1rpx rgba(229, 211, 179, 0.08), inset 0 1rpx 0 rgba(255, 255, 255, 0.06);
}

.page-pay-checkout .pay-plan-price {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.page-pay-checkout .pay-feature-row {
  gap: 8rpx;
}

.page-pay-checkout .pay-feature-row > text {
  margin-right: 0;
  margin-bottom: 0;
}
