<view class="page page-pay page-pay-checkout">
  <view class="container">
    <view class="hero pay-hero fade-up">
      <text class="eyebrow">支付</text>
      <text class="title">选择套餐并完成支付</text>
      <text class="subtitle">价格和支付逻辑保持不变，只收紧信息层级。</text>
    </view>

    <view class="section fade-up delay-1" wx:if="{{products.length}}">
      <view class="section-head">
        <text class="section-title">可购买套餐</text>
        <text class="section-copy">先看权益，再决定购买。</text>
      </view>

      <view class="list-stack">
        <view
          class="card pay-plan-card {{item.isPro ? 'pay-plan-card-pro' : ''}}"
          wx:for="{{products}}"
          wx:key="id"
        >
          <view class="list-item-head">
            <view>
              <text class="card-title">{{item.name}}</text>
              <text class="meta-line">{{item.description}}</text>
            </view>
            <view class="pay-plan-price">
              <text wx:if="{{item.isPro}}" class="status-pill status-pill-accent">推荐</text>
              <text class="status-pill {{item.isPro ? 'status-pill-accent' : 'status-pill-muted'}}">{{item.priceLabel}}</text>
            </view>
          </view>

          <view class="row pay-feature-row">
            <text class="tag">含 {{item.credits_grant}} 积分</text>
            <text wx:if="{{item.isPro}}" class="tag tag-accent">Pro 权益</text>
          </view>

          <button
            class="btn-primary"
            bindtap="handlePay"
            data-id="{{item.id}}"
            loading="{{payingId === item.id}}"
            disabled="{{payingId === item.id}}"
          >
            立即支付
          </button>
        </view>
      </view>
    </view>

    <view class="section fade-up delay-2" wx:if="{{!products.length}}">
      <view class="card">
        <text class="card-title">暂无套餐</text>
        <text class="muted small">请稍后刷新再试。</text>
      </view>
    </view>
  </view>
</view>
