page {
  position: fixed;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #21181c;
}

.mine-home-v2,
.mine-home-v2 .mine-page-scroll-shell,
.mine-home-v2 .page-scroll {
  height: 100%;
  overflow: hidden;
}

.mine-home-v2 {
  background: #efe5d8;
}

.mine-home-v2 .container {
  min-height: 100%;
  padding: 85rpx 46rpx calc(188rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background:
    linear-gradient(180deg, #21181c 0rpx, #21181c 900rpx, #efe5d8 900rpx, #efe5d8 100%);
}

.mine-home-v2 view,
.mine-home-v2 text,
.mine-home-v2 image,
.mine-home-v2 button {
  box-sizing: border-box;
  font-family: "Inter", "PingFang SC", "Microsoft YaHei", sans-serif;
  letter-spacing: 0;
}

.mine-account-panel {
  position: relative;
  height: 604rpx;
  border-radius: 62rpx;
  background: #2d2120;
  border: 1rpx solid rgba(111, 75, 62, 0.22);
  box-shadow:
    0 28rpx 54rpx rgba(40, 31, 28, 0.24),
    inset 0 1rpx 0 rgba(248, 241, 232, 0.04);
  overflow: hidden;
}

.mine-heading {
  position: absolute;
  left: 58rpx;
  top: 65rpx;
  z-index: 1;
  display: flex;
  flex-direction: column;
}

.mine-eyebrow {
  display: block;
  min-height: 34rpx;
  color: #f0d8c2;
  font-size: 26rpx;
  line-height: 34rpx;
  font-weight: 800;
}

.mine-title {
  display: block;
  margin-top: 36rpx;
  color: #f7f2ea;
  font-size: 64rpx;
  line-height: 1.3;
  font-weight: 700;
}

.mine-profile-band {
  position: absolute;
  left: 58rpx;
  top: 273rpx;
  z-index: 1;
  width: 542rpx;
  height: 185rpx;
  padding: 0 42rpx;
  border-radius: 54rpx;
  display: grid;
  grid-template-columns: 108rpx minmax(0, 1fr);
  align-items: center;
  gap: 36rpx;
  background: #b88667;
  box-shadow:
    0 16rpx 28rpx rgba(81, 48, 40, 0.18),
    inset 0 1rpx 0 rgba(248, 241, 232, 0.16);
}

.mine-avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff8ef;
  overflow: hidden;
}

.mine-avatar-fallback text {
  color: #b88667;
  font-size: 34rpx;
  line-height: 1;
  font-weight: 800;
}

.mine-profile-copy {
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.mine-profile-name {
  display: block;
  color: #fff8ef;
  font-size: 31rpx;
  line-height: 1.3;
  font-weight: 800;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mine-profile-note {
  display: block;
  margin-top: 8rpx;
  color: rgba(255, 248, 239, 0.78);
  font-size: 23rpx;
  line-height: 1.3;
  font-weight: 500;
}

.mine-quick-row {
  position: absolute;
  left: 58rpx;
  top: 496rpx;
  z-index: 1;
  width: 542rpx;
  display: grid;
  grid-template-columns: repeat(3, 162rpx);
  gap: 28rpx;
}

.mine-quick-pill {
  height: 77rpx;
  border-radius: 31rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 248, 239, 0.13);
}

.mine-quick-pill text {
  color: #fff8ef;
  font-size: 24rpx;
  line-height: 1;
  font-weight: 800;
}

.mine-menu-stack {
  position: relative;
  z-index: 2;
  margin-top: 70rpx;
  display: grid;
  gap: 50rpx;
}

.mine-menu-card {
  min-height: 207rpx;
  padding: 54rpx 60rpx;
  border-radius: 54rpx;
  display: flex;
  align-items: center;
  background: #f8f0e8;
  border: 1rpx solid #d8c8bb;
  box-shadow:
    0 16rpx 34rpx rgba(40, 31, 28, 0.08),
    inset 0 1rpx 0 rgba(244, 236, 228, 0.82);
}

.mine-menu-card-primary {
  min-height: 223rpx;
  padding-top: 0;
  padding-bottom: 0;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 162rpx;
  align-items: center;
  gap: 28rpx;
}

.mine-menu-copy {
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.mine-menu-title {
  display: block;
  color: #281f1c;
  font-size: 38rpx;
  line-height: 1.25;
  font-weight: 800;
}

.mine-menu-note {
  display: block;
  margin-top: 13rpx;
  color: #6e605a;
  font-size: 25rpx;
  line-height: 1.35;
  font-weight: 400;
}

.mine-upgrade-btn {
  width: 162rpx;
  height: 86rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 43rpx;
  color: #fff8ef;
  background: #b88667;
  box-shadow:
    0 10rpx 20rpx rgba(95, 55, 48, 0.14),
    inset 0 1rpx 0 rgba(248, 241, 232, 0.16);
  font-size: 26rpx;
  line-height: 86rpx;
  font-weight: 800;
}

button::after {
  border: none;
}

button:active,
.mine-menu-card:active,
.mine-quick-pill:active {
  opacity: 0.94;
}

.fade-up {
  animation: mineFadeUp 360ms ease both;
}

.delay-1 {
  animation-delay: 60ms;
}

@keyframes mineFadeUp {
  from {
    opacity: 0;
    transform: translateY(10rpx);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}
