<view class="page page-mine">
  <view class="container">
    <view class="hero mine-hero fade-up">
      <view class="hero-head">
        <view>
          <text class="eyebrow">账户中心</text>
          <text class="title">账户与权益</text>
          <text class="subtitle">账号、订阅、订单和工具统一收口到这里。</text>
        </view>
        <text class="mine-login-flag {{isLoggedIn ? 'mine-login-flag-active' : ''}}">{{isLoggedIn ? '已登录' : '未登录'}}</text>
      </view>

      <view class="mine-account-card" wx:if="{{isLoggedIn}}">
        <view class="mine-profile-main">
          <image class="avatar" src="{{avatarUrl}}" mode="aspectFill" wx:if="{{avatarUrl}}" />
          <view class="profile-info">
            <text class="card-title">{{displayName}}</text>
            <text class="muted small">微信账号已绑定</text>
          </view>
        </view>
        <button class="btn-outline mine-logout-btn" size="mini" bindtap="handleLogout">退出登录</button>
      </view>

      <view class="mine-account-card" wx:else>
        <text class="muted small">登录后可同步权益、积分和订单状态。</text>
        <button class="btn-primary" bindtap="handleLoginTap">微信一键登录</button>
      </view>
    </view>

    <view class="section fade-up delay-1">
      <view class="section-head">
        <text class="section-title">订阅与积分</text>
        <text class="section-copy">升级 / 购买保持唯一主动作。</text>
      </view>

      <view class="card membership-card">
        <view class="panel-head">
          <view>
            <text class="panel-kicker">订阅</text>
            <text class="card-title">当前权益</text>
          </view>
        </view>

        <view wx:if="{{isLoggedIn}}">
          <view class="mine-stat-grid">
            <view class="mine-stat-item">
              <text class="hero-summary-label">套餐状态</text>
              <text class="hero-summary-value">{{planLabel || '加载中...'}}</text>
            </view>
            <view class="mine-stat-item">
              <text class="hero-summary-label">可用积分</text>
              <text class="hero-summary-value">{{creditsUnlimited ? '不限' : creditsBalance}}</text>
            </view>
          </view>
          <button class="btn-primary" bindtap="handleUpgrade">升级 / 购买</button>
        </view>

        <view wx:else>
          <text class="muted small">登录后显示实时权益与积分。</text>
          <button class="btn-primary" bindtap="handleLoginTap">去登录</button>
        </view>
      </view>
    </view>

    <view class="section fade-up delay-2">
      <view class="section-head">
        <text class="section-title">订单</text>
        <text class="section-copy">查看付款与开通状态。</text>
      </view>

      <view class="card">
        <view class="panel-head">
          <view>
            <text class="panel-kicker">订单</text>
            <text class="card-title">订单与开通记录</text>
          </view>
        </view>
        <button class="btn-outline" bindtap="handleOrders" wx:if="{{isLoggedIn}}">查看订单</button>
        <button class="btn-outline" bindtap="handleLoginTap" wx:else>去登录</button>
      </view>
    </view>

    <view class="section fade-up delay-2">
      <view class="section-head">
        <text class="section-title">工具</text>
        <text class="section-copy">常用工具在前，进阶入口在后。</text>
      </view>

      <view class="list-stack">
        <view class="card tool-card">
          <view class="panel-head">
            <view>
              <text class="panel-kicker">门店</text>
              <text class="card-title">门店档案</text>
            </view>
          </view>
          <text class="muted small">一次配置，发文时直接复用。</text>
          <button class="btn-outline" bindtap="handleStoreProfiles">管理门店档案</button>
        </view>

        <view class="card tool-card tool-card-subtle">
          <view class="panel-head">
            <view>
              <text class="panel-kicker">进阶</text>
              <text class="card-title">进阶工具</text>
            </view>
          </view>
          <text class="muted small">P1-P10 工作流等能力保留原有入口。</text>
          <button class="btn-outline" bindtap="handleAdvanced">打开进阶</button>
        </view>
      </view>
    </view>
  </view>
</view>
