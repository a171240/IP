<view class="page mine-home-v2">
  <view class="mine-page-scroll-shell">
    <scroll-view class="page-scroll" scroll-y="true" enhanced="true" bounces="false" refresher-enabled="{{false}}" show-scrollbar="false">
      <view class="container">
        <view class="mine-account-panel fade-up">
          <view class="mine-heading">
            <text class="mine-eyebrow">账户中心</text>
            <text class="mine-title">我的</text>
          </view>

          <view class="mine-profile-band" wx:if="{{isLoggedIn}}">
            <image class="mine-avatar" src="{{avatarUrl}}" mode="aspectFill" wx:if="{{avatarUrl}}" />
            <view class="mine-avatar mine-avatar-fallback" wx:else>
              <text>{{avatarInitial}}</text>
            </view>
            <view class="mine-profile-copy">
              <text class="mine-profile-name">{{displayName}}</text>
              <text class="mine-profile-note">权益自动同步</text>
            </view>
          </view>

          <view class="mine-profile-band" wx:else>
            <view class="mine-avatar mine-avatar-fallback">
              <text>微</text>
            </view>
            <view class="mine-profile-copy">
              <text class="mine-profile-name">微信头像 / 昵称</text>
              <text class="mine-profile-note">权益自动同步</text>
            </view>
          </view>

          <view class="mine-quick-row">
            <view class="mine-quick-pill" bindtap="handleUpgrade">
              <text>套餐</text>
            </view>
            <view class="mine-quick-pill" bindtap="handleUpgrade">
              <text>积分</text>
            </view>
            <view class="mine-quick-pill" bindtap="handleOrders">
              <text>订单</text>
            </view>
          </view>
        </view>

        <view class="mine-menu-stack fade-up delay-1">
          <view class="mine-menu-card mine-menu-card-primary">
            <view class="mine-menu-copy">
              <text class="mine-menu-title">订阅与积分</text>
              <text class="mine-menu-note">查看套餐、余量和升级入口</text>
            </view>
            <button class="mine-upgrade-btn" bindtap="handleUpgrade" wx:if="{{isLoggedIn}}">升级</button>
            <button class="mine-upgrade-btn" bindtap="handleLoginTap" wx:else>登录</button>
          </view>

          <view class="mine-menu-card" bindtap="handleOrders" wx:if="{{isLoggedIn}}">
            <view class="mine-menu-copy">
              <text class="mine-menu-title">订单记录</text>
              <text class="mine-menu-note">购买、续费、开通状态</text>
            </view>
          </view>

          <view class="mine-menu-card" bindtap="handleLoginTap" wx:else>
            <view class="mine-menu-copy">
              <text class="mine-menu-title">订单记录</text>
              <text class="mine-menu-note">购买、续费、开通状态</text>
            </view>
          </view>

          <view class="mine-menu-card" bindtap="handleStoreProfiles">
            <view class="mine-menu-copy">
              <text class="mine-menu-title">设置与服务</text>
              <text class="mine-menu-note">门店档案、进阶设置</text>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>
</view>
