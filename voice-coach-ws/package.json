{
  "name": "voice-coach-ws",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json --outDir dist",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "probe:warm": "node scripts/warm-external-connections.mjs",
    "latency:e2e": "node scripts/e2e-latency-check.mjs",
    "latency:report": "node scripts/render-latency-report.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.87.1",
    "dotenv": "^16.6.1",
    "jsonrepair": "^3.13.2",
    "ws": "^8.18.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
