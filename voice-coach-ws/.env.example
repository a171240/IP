# === WebSocket service ===
WS_PORT=8080

# === Supabase ===
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional legacy env compatibility
IPgongchang_SUPABASE_URL=
IPgongchang_SUPABASE_SERVICE_ROLE_KEY=
IPgongchang_SUPABASE_SECRET_KEY=

# === Volcano speech ===
VOLC_SPEECH_APP_ID=
VOLC_SPEECH_ACCESS_TOKEN=
VOLC_TTS_CLUSTER=volcano_tts
VOLC_TTS_RESOURCE_ID=seed-tts-2.0
VOLC_TTS_VOICE_TYPE=zh_female_vv_uranus_bigtts
VOLC_TTS_LANGUAGE=cn
VOLC_TTS_FALLBACK_VOICES=
VOLC_ASR_RESOURCE_ID=volc.seedasr.auc
VOLC_STREAMING_ASR_RESOURCE_ID=volc.bigasr.sauc.duration

# === Voice coach LLM providers ===
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-seed-1-6-flash-250828
ARK_FALLBACK_MODELS=doubao-seed-1-6-250615

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DeepSeek V3.x non-thinking API model identifier.
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_FALLBACK_MODELS=deepseek-chat

GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4-flash
GLM_FALLBACK_MODELS=

QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-turbo
QWEN_FALLBACK_MODELS=

MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.chat/v1
MINIMAX_MODEL=minimax-abab6.5s-chat
MINIMAX_FALLBACK_MODELS=

VOICE_COACH_REPLY_PROVIDER=deepseek
VOICE_COACH_ANALYSIS_PROVIDER=deepseek
ARK_VOICE_COACH_REPLY_TIMEOUT_MS=8000
ARK_VOICE_COACH_ANALYSIS_TIMEOUT_MS=15000
VOICE_COACH_EARLY_REPLY_ENABLED=true
VOICE_COACH_EARLY_REPLY_MIN_CHARS=8
VOICE_COACH_EARLY_REPLY_STABLE_MS=180

# === Voice coach gating ===
VOICE_COACH_ENABLED=true
VOICE_COACH_ALLOW_USER_IDS=
VOICE_COACH_MAX_TURNS=10
