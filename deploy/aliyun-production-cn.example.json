{
  "name": "meiye-huajing-app-api",
  "environment": "production-cn",
  "region": "cn-hangzhou",
  "runtime": "custom-container",
  "container": {
    "image": "meiye-huajing-app-api:production-cn",
    "port": 3000,
    "healthPath": "/api/healthz",
    "strictHealthPath": "/api/app/health?strict=1"
  },
  "runtimePlan": {
    "file": "deploy/aliyun-production-cn.runtime-plan.json",
    "checkCommand": "corepack pnpm aliyun:runtime:plan",
    "provider": "SAE",
    "region": "cn-hangzhou",
    "appName": "meiye-huajing-app-api-production-cn",
    "note": "First production-cn bridge deploy targets Aliyun SAE custom container. ECS remains a fallback only if SAE cannot satisfy runtime constraints."
  },
  "imagePublish": {
    "exampleFile": "deploy/aliyun-production-cn.image-publish.example.json",
    "localFile": "deploy/aliyun-production-cn.image-publish.local.json",
    "checkCommand": "corepack pnpm aliyun:image:plan",
    "strictCheckCommand": "corepack pnpm aliyun:image:plan:strict",
    "provider": "Aliyun ACR",
    "registryRegion": "cn-hangzhou",
    "remoteRepository": "meiye-huajing-app-api",
    "remoteTag": "production-cn",
    "secretsPolicy": "Do not store ACR username, password, access token, RAM secret, or image pull secret in git. Keep credentials in docker credential helper, RAM, KMS, Secrets Manager, or Aliyun runtime settings."
  },
  "domain": {
    "apiHost": "api-cn.ipgongchang.xin",
    "assetHost": "assets-cn.ipgongchang.xin",
    "httpsRequired": true,
    "dnsProvider": "aliyun",
    "checkCommand": "corepack pnpm aliyun:domain:check",
    "strictCheckCommand": "corepack pnpm aliyun:domain:strict",
    "note": "Do not repoint ip.ipgongchang.xin until the APP production-cn backend passes remote smoke."
  },
  "environmentImport": {
    "localEnvFile": "/Users/Admin/Documents/美业话镜APP/.env.production-cn.local",
    "exampleEnvFile": "/Users/Admin/Documents/美业话镜APP/.env.production-cn.example",
    "prepareCommand": "node scripts/prepare-aliyun-runtime-env.mjs --env-file /Users/Admin/Documents/美业话镜APP/.env.production-cn.local --write /tmp/meiye-sae-env.json",
    "secretsPolicy": "Import through Aliyun console, KMS, or Secrets Manager. Do not bake secrets into the image."
  },
  "cloudConfirmations": {
    "exampleFile": "deploy/aliyun-production-cn.cloud-confirmations.example.json",
    "localFile": "deploy/aliyun-production-cn.cloud-confirmations.local.json",
    "checkCommand": "corepack pnpm aliyun:cloud:confirmations",
    "strictCheckCommand": "corepack pnpm aliyun:cloud:confirmations:strict",
    "operatorTasksCommand": "corepack pnpm aliyun:operator:tasks",
    "backendOperatorTasksCommand": "corepack pnpm aliyun:operator:tasks:backend",
    "statusCommand": "corepack pnpm aliyun:status",
    "secretsPolicy": "The local confirmation file must contain resource names, booleans, and evidence handles only. Do not paste secret values."
  },
  "cloudInventoryPlan": {
    "checkCommand": "corepack pnpm aliyun:cloud:inventory-plan",
    "script": "scripts/generate-aliyun-cli-inventory-plan.mjs",
    "scope": "read-only command plan only; it never calls Aliyun cloud APIs by itself",
    "requiresConfiguredCli": true,
    "secretsPolicy": "Do not pass AccessKeySecret, AppSecret, registry password, STS token, cookie, or Supabase service role key on the command line or into reports."
  },
  "cloudInventoryRunner": {
    "checkCommand": "corepack pnpm aliyun:cloud:inventory-run",
    "script": "scripts/run-aliyun-cli-inventory.mjs",
    "scope": "dry-run by default; executes only allowlisted read-only Aliyun CLI commands with --execute-readonly and MEIYE_ALLOW_ALIYUN_READONLY_INVENTORY=1",
    "writesLocalFileOnlyWhenExplicit": true,
    "secretsPolicy": "The runner never writes raw stdout/stderr. It records command names, exit status, line counts, SHA-256 evidence handles, timestamps, and booleans only."
  },
  "cloudInventoryResults": {
    "exampleFile": "deploy/aliyun-production-cn.cloud-inventory-results.example.json",
    "localFile": "deploy/aliyun-production-cn.cloud-inventory-results.local.json",
    "checkCommand": "corepack pnpm aliyun:cloud:inventory-results",
    "strictCheckCommand": "corepack pnpm aliyun:cloud:inventory-results:strict",
    "scope": "non-secret read-only CLI inventory result summaries only; the checker never runs Aliyun commands",
    "secretsPolicy": "Record command names, booleans, exit status, timestamps, and evidence handles only. Do not paste full command output when it contains credentials, tokens, registry passwords, certificates, cookies, or personal secrets."
  },
  "localPredeployChecks": [
