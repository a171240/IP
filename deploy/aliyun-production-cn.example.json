{
  "name": "meiye-huajing-app-api",
  "environment": "production-cn",
  "region": "cn-hangzhou",
  "runtime": "custom-container",
  "container": {
    "image": "meiye-huajing-app-api:production-cn",
    "port": 3000,
    "healthPath": "/api/healthz",
    "strictHealthPath": "/api/app/health?strict=1"
  },
  "imagePublish": {
    "exampleFile": "deploy/aliyun-production-cn.image-publish.example.json",
    "localFile": "deploy/aliyun-production-cn.image-publish.local.json",
    "checkCommand": "corepack pnpm aliyun:image:plan",
    "strictCheckCommand": "corepack pnpm aliyun:image:plan:strict",
    "provider": "Aliyun ACR",
    "registryRegion": "cn-hangzhou",
    "remoteRepository": "meiye-huajing-app-api",
    "remoteTag": "production-cn",
    "secretsPolicy": "Do not store ACR username, password, access token, RAM secret, or image pull secret in git. Keep credentials in docker credential helper, RAM, KMS, Secrets Manager, or Aliyun runtime settings."
  },
  "domain": {
    "apiHost": "api-cn.ipgongchang.xin",
    "assetHost": "assets-cn.ipgongchang.xin",
    "httpsRequired": true,
    "dnsProvider": "aliyun",
    "checkCommand": "corepack pnpm aliyun:domain:check",
    "strictCheckCommand": "corepack pnpm aliyun:domain:strict",
    "note": "Do not repoint ip.ipgongchang.xin until the APP production-cn backend passes remote smoke."
  },
  "environmentImport": {
    "localEnvFile": "/Users/Admin/Documents/美业话镜APP/.env.production-cn.local",
    "exampleEnvFile": "/Users/Admin/Documents/美业话镜APP/.env.production-cn.example",
    "prepareCommand": "node scripts/prepare-aliyun-runtime-env.mjs --env-file /Users/Admin/Documents/美业话镜APP/.env.production-cn.local --write /tmp/meiye-sae-env.json",
    "secretsPolicy": "Import through Aliyun console, KMS, or Secrets Manager. Do not bake secrets into the image."
  },
  "cloudConfirmations": {
    "exampleFile": "deploy/aliyun-production-cn.cloud-confirmations.example.json",
    "localFile": "deploy/aliyun-production-cn.cloud-confirmations.local.json",
    "checkCommand": "corepack pnpm aliyun:cloud:confirmations",
    "strictCheckCommand": "corepack pnpm aliyun:cloud:confirmations:strict",
    "operatorTasksCommand": "corepack pnpm aliyun:operator:tasks",
    "secretsPolicy": "The local confirmation file must contain resource names, booleans, and evidence handles only. Do not paste secret values."
  },
  "predeployChecks": [
    "corepack pnpm aliyun:deploy:spec",
    "corepack pnpm aliyun:image:plan",
    "corepack pnpm aliyun:operator:tasks",
    "corepack pnpm aliyun:cloud:confirmations",
    "corepack pnpm aliyun:readiness",
    "corepack pnpm aliyun:env:sources",
    "corepack pnpm aliyun:domain:check",
    "corepack pnpm aliyun:cloud:check",
    "corepack pnpm aliyun:readiness:cloud-ready",
    "corepack pnpm aliyun:release:artifacts",
    "corepack pnpm aliyun:app-client:contract",
    "corepack pnpm aliyun:app-native:check",
    "corepack pnpm aliyun:app-api:coverage",
    "corepack pnpm aliyun:predeploy",
    "corepack pnpm aliyun:docker:build",
    "corepack pnpm aliyun:container:smoke"
  ],
  "postdeployChecks": [
    "corepack pnpm aliyun:domain:strict",
    "corepack pnpm aliyun:cloud:confirmations:strict",
    "corepack pnpm aliyun:postdeploy:smoke -- --base-url https://api-cn.ipgongchang.xin",
    "corepack pnpm aliyun:remote:smoke -- --base-url https://api-cn.ipgongchang.xin",
    "corepack pnpm aliyun:app-api:smoke -- --base-url https://api-cn.ipgongchang.xin"
  ],
  "requiredExternalConfirmations": [
    "SAE or ECS application created",
    "Aliyun ACR image pushed and runtime image pull configured",
    "api-cn/assets-cn DNS and HTTPS certificates configured",
    "OSS CORS and RAM least-privilege policy confirmed",
    "WeChat Open Platform mobile app credentials configured",
    "SLS logging and alerts configured"
  ],
  "bridgeDataLayer": {
    "current": "Supabase",
    "target": "Aliyun RDS PostgreSQL",
    "status": "RDS migration is not included in the first bridge deployment"
  }
}
