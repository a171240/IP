## Copy to .env.local and fill in values.
## PowerShell:
##   Copy-Item .env.example .env.local

# Evolink / Apimart (if you use it)
APIMART_API_KEY=
APIMART_BASE_URL=https://api.evolink.ai/v1
APIMART_MODEL=kimi-k2-thinking
# Optional: request timeout in ms (default: 240000)
APIMART_TIMEOUT_MS=
# Basic image generation / poster generation via APIMart.
# Image generation uses APIMART_IMAGE_API_KEY first, then falls back to APIMART_API_KEY.
APIMART_IMAGE_API_KEY=
APIMART_IMAGE_BASE_URL=https://api.apimart.ai/v1
APIMART_IMAGE_MODEL=gpt-image-2
APIMART_IMAGE_SIZE=3:4
# Commercial image generation is fixed to the base-priced 1k tier.
APIMART_IMAGE_RESOLUTION=1k
APIMART_IMAGE_POLL_TIMEOUT_MS=240000
APIMART_IMAGE_REQUEST_TIMEOUT_MS=30000
APIMART_IMAGE_MAX_RETRIES=0
# Quick-start (optional): use faster Kimi K2 Thinking Turbo for quick-* agents
# If not set, it will reuse APIMART_* above.
APIMART_QUICK_API_KEY=
APIMART_QUICK_BASE_URL=
APIMART_QUICK_MODEL=kimi-k2-thinking-turbo

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: support email shown on pricing/contact
NEXT_PUBLIC_SUPPORT_EMAIL=
# Credits / anti-abuse (hash IP on server; set a long random secret in production)
CREDITS_IP_SALT=
# Redeem login secret (HMAC). If empty, will fallback to WECHAT_LOGIN_SECRET.
REDEEM_LOGIN_SECRET=

# Supabase (server-only)
SUPABASE_SERVICE_ROLE_KEY=

# WeChat Mini Program login
WECHAT_MINI_APPID=
WECHAT_MINI_SECRET=
# Random secret used to derive deterministic passwords for mini program users
WECHAT_LOGIN_SECRET=

# WeChat Open Platform mobile App login
# Use the native iOS/Android WeChat SDK to obtain the authorization code,
# then call POST /api/app/auth/wechat with { "code": "..." }.
WECHAT_OPEN_APP_ID=
WECHAT_OPEN_APP_SECRET=

# Voice coach (speech roleplay training)
# Feature flag + optional whitelist (comma-separated Supabase user IDs).
VOICE_COACH_ENABLED=false
VOICE_COACH_ALLOW_USER_IDS=
# Max beautician turns per session (default 10 if empty).
VOICE_COACH_MAX_TURNS=

# Volcengine / Doubao Speech (ASR + TTS)
# Create an app in Volcengine OpenSpeech console to obtain these values.
VOLC_SPEECH_APP_ID=
VOLC_SPEECH_ACCESS_TOKEN=
# TTS defaults (override if your account has different clusters/voices enabled)
VOLC_TTS_CLUSTER=volcano_tts
VOLC_TTS_RESOURCE_ID=seed-tts-2.0
VOLC_TTS_VOICE_TYPE=BV700_streaming
VOLC_TTS_LANGUAGE=cn
# Optional fallback voice list (comma-separated), used if primary voice fails.
VOLC_TTS_FALLBACK_VOICES=
# ASR resource (recording file recognize big model)
# - volc.seedasr.auc: model 2.0
# - volc.bigasr.auc: model 1.0
VOLC_ASR_RESOURCE_ID=volc.seedasr.auc
# Streaming ASR resource (realtime big model)
# - volc.bigasr.sauc.duration: direct websocket streaming
VOLC_STREAMING_ASR_RESOURCE_ID=volc.bigasr.sauc.duration
# Optional flash ASR resource id (only set when your account has flash recognize permission).
# Example: volc.bigasr.auc_turbo
VOLC_ASR_FLASH_RESOURCE_ID=

# Alibaba Cloud Model Studio / Bailian ASR for long service recordings.
# Use the China (Beijing) API key. Keep the real key only in local/Vercel env vars.
SERVICE_RECORD_ASR_PROVIDER=bailian
DASHSCOPE_API_KEY=
BAILIAN_ASR_MODEL=paraformer-v2
BAILIAN_ASR_LANGUAGE_HINTS=zh,yue,en
BAILIAN_ASR_DIARIZATION_ENABLED=true
BAILIAN_ASR_SPEAKER_COUNT=3
BAILIAN_ASR_AUDIO_URL_EXPIRES_SECONDS=21600

# Voice coach LLM providers (OpenAI-compatible)
# By default the realtime path now prefers DeepSeek V3 for both reply and analysis.
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-seed-1-6-flash-250828
ARK_FALLBACK_MODELS=doubao-seed-1-6-250615

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# DeepSeek V3.x non-thinking API model identifier.
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_FALLBACK_MODELS=deepseek-chat
# Optional: Xiaohongshu copywriting should point DEEPSEEK_XHS_MODEL at the official DeepSeek Pro model.
DEEPSEEK_XHS_MODEL=deepseek-v4-pro
DEEPSEEK_XHS_BASE_URL=
DEEPSEEK_PRO_MODEL=deepseek-v4-pro
DEEPSEEK_XHS_THINKING=disabled

# Private copy assistant. Defaults to DEEPSEEK_PRO_MODEL / DEEPSEEK_MODEL when unset.
PRIVATE_COPY_DEEPSEEK_MODEL=deepseek-v4-pro
PRIVATE_COPY_DEEPSEEK_FALLBACK_MODEL=deepseek-v4-flash
PRIVATE_COPY_DEEPSEEK_BASE_URL=
PRIVATE_COPY_DEEPSEEK_TIMEOUT_MS=35000
PRIVATE_COPY_DEEPSEEK_MAX_TOKENS=2600
PRIVATE_COPY_DEEPSEEK_TEMPERATURE=0.52
PRIVATE_COPY_DEEPSEEK_THINKING=disabled

GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4-flash
GLM_FALLBACK_MODELS=

QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-turbo
QWEN_FALLBACK_MODELS=

MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.chat/v1
MINIMAX_MODEL=minimax-abab6.5s-chat
MINIMAX_FALLBACK_MODELS=

VOICE_COACH_REPLY_PROVIDER=deepseek
VOICE_COACH_ANALYSIS_PROVIDER=deepseek
ARK_VOICE_COACH_REPLY_TIMEOUT_MS=8000
ARK_VOICE_COACH_ANALYSIS_TIMEOUT_MS=15000
VOICE_COACH_EARLY_REPLY_ENABLED=true
VOICE_COACH_EARLY_REPLY_MIN_CHARS=8
VOICE_COACH_EARLY_REPLY_STABLE_MS=180

# WeChat Pay v3 (Native)
WECHATPAY_APPID=
WECHATPAY_MCHID=
WECHATPAY_SERIAL_NO=
# Merchant private key PEM; store as a single line with \n for newlines
WECHATPAY_PRIVATE_KEY=
# API v3 key (32 chars)
WECHATPAY_API_V3_KEY=

# WeChat Pay callback verifier (choose one mode)
# Option A (recommended): WeChat Pay public key mode
WECHATPAY_PLATFORM_PUBLIC_KEY_ID=
# WeChat Pay public key PEM; store as a single line with \n for newlines
WECHATPAY_PLATFORM_PUBLIC_KEY_PEM=

# Option B: Platform certificate mode (legacy)
WECHATPAY_PLATFORM_SERIAL_NO=
# Platform certificate PEM; store as a single line with \n for newlines
WECHATPAY_PLATFORM_CERT_PEM=

# Public HTTPS callback URL, e.g. https://www.example.com/api/wechatpay/notify
WECHATPAY_NOTIFY_URL=

# WeChat Mini Program Virtual Payment (official 小程序虚拟支付)
# env: 0 = production, 1 = sandbox
WECHAT_VIRTUAL_PAY_ENV=0
WECHAT_VIRTUAL_PAY_MODE=short_series_goods
WECHAT_VIRTUAL_PAY_OFFER_ID=
WECHAT_VIRTUAL_PAY_APP_KEY=
WECHAT_VIRTUAL_PAY_SANDBOX_APP_KEY=
# Optional: map current mini-program product IDs to official virtual-payment product IDs
WECHAT_VIRTUAL_PAY_PRODUCT_BASIC_MONTH=basic_month
WECHAT_VIRTUAL_PAY_PRODUCT_PRO_MONTH=pro_month
WECHAT_VIRTUAL_PAY_TEST_ENABLED=0
WECHAT_VIRTUAL_PAY_PRODUCT_TEST_1FEN=test_1fen
WECHAT_VIRTUAL_PAY_TEST_PRICE_CENTS=1
WECHAT_VIRTUAL_PAY_TEST_CREDITS=1
