## Copy to .env.local and fill in values.
## PowerShell:
##   Copy-Item .env.example .env.local

# Evolink / Apimart (if you use it)
APIMART_API_KEY=
APIMART_BASE_URL=https://api.evolink.ai/v1
APIMART_MODEL=kimi-k2-thinking
# Optional: request timeout in ms (default: 240000)
APIMART_TIMEOUT_MS=
# Quick-start (optional): use faster Kimi K2 Thinking Turbo for quick-* agents
# If not set, it will reuse APIMART_* above.
APIMART_QUICK_API_KEY=
APIMART_QUICK_BASE_URL=
APIMART_QUICK_MODEL=kimi-k2-thinking-turbo

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: support email shown on pricing/contact
NEXT_PUBLIC_SUPPORT_EMAIL=
# Credits / anti-abuse (hash IP on server; set a long random secret in production)
CREDITS_IP_SALT=
# Redeem login secret (HMAC). If empty, will fallback to WECHAT_LOGIN_SECRET.
REDEEM_LOGIN_SECRET=

# Supabase (server-only)
SUPABASE_SERVICE_ROLE_KEY=

# WeChat Mini Program login
WECHAT_MINI_APPID=
WECHAT_MINI_SECRET=
# Random secret used to derive deterministic passwords for mini program users
WECHAT_LOGIN_SECRET=

# Voice coach (speech roleplay training)
# Feature flag + optional whitelist (comma-separated Supabase user IDs).
VOICE_COACH_ENABLED=false
VOICE_COACH_ALLOW_USER_IDS=
# Text LLM provider for voice-coach: doubao|apimart
VOICE_COACH_LLM_PROVIDER=doubao
# Optional unified switch for response_format json_object
VOICE_COACH_LLM_USE_RESPONSE_FORMAT=true
# Max beautician turns per session (default 10 if empty).
VOICE_COACH_MAX_TURNS=
# Session creation strategy:
# - preset: first customer turn uses built-in opening text (recommended for speed)
# - llm: first customer turn generated by LLM
VOICE_COACH_FIRST_TURN_MODE=preset
# First turn TTS strategy:
# - async: do not block session creation waiting for first TTS
# - sync: generate first TTS in session create request
VOICE_COACH_FIRST_TTS_MODE=async
# Optional pre-generated first turn audio path in Supabase Storage bucket voice-coach-audio.
VOICE_COACH_SEED_OPENING_AUDIO_PATH=
VOICE_COACH_SEED_OPENING_SECONDS=3
# Prefix used by scripts/generate-voice-customer-line-seeds.mjs for customer fixed-line audio.
VOICE_COACH_LINE_SEED_PREFIX=seed/customer-lines/v1
# Keep preview off in phase-1 (preview chunks are not stable in flash single-file API path).
VOICE_COACH_STREAMING_PREVIEW_ENABLED=false
# Realtime gateway master switch.
VOICE_COACH_REALTIME_ENABLED=false
# Optional explicit WebSocket endpoint for the mini program realtime client.
VOICE_COACH_REALTIME_URL=
# Standalone realtime gateway bind port/path.
VOICE_COACH_REALTIME_PORT=8787
VOICE_COACH_REALTIME_PATH=/api/voice-coach/realtime/ws
# Recorder chunk size for realtime uplink (milliseconds).
VOICE_COACH_REALTIME_DEFAULT_CHUNK_MS=200
# Preferred synthesized playback segment size (milliseconds).
VOICE_COACH_REALTIME_TARGET_SEGMENT_MS=800
# Require this many consecutive speech chunks before sending interrupt.
VOICE_COACH_REALTIME_INTERRUPT_MIN_CHUNKS=2
# Submit fast-path only advances to customer.text_ready. TTS stays on worker path.
VOICE_COACH_SUBMIT_FASTPATH_ENABLED=false
VOICE_COACH_SUBMIT_FASTPATH_MAX_WALL_MS=900
VOICE_COACH_SUBMIT_FASTPATH_JOB_TIMEOUT_MS=700
# Streaming TTS miss-path gate. Final customer.audio_ready must still be emitted.
VOICE_COACH_TTS_STREAM_ENABLED=false
# TTS speed profile: fast|balanced
VOICE_COACH_TTS_PROFILE=fast
# Allow flash->AUC fallback to reduce "未识别语音" when flash permission is missing.
VOICE_COACH_ASR_ALLOW_AUC_FALLBACK=true
# Prefer lower-latency AUC resource first when configured resource is seedasr.
VOICE_COACH_ASR_FAST_FIRST=false
# AUC overall timeout in main stage (milliseconds).
VOICE_COACH_ASR_AUC_TOTAL_TIMEOUT_MS=9000
# Submit endpoint fast-path budget (milliseconds). Set 0 to always immediate ACK.
VOICE_COACH_SUBMIT_ADVANCE_BUDGET_MS=0
# Submit kick-off async pump budget (milliseconds).
VOICE_COACH_SUBMIT_KICKOFF_WALL_MS=9000
VOICE_COACH_SUBMIT_KICKOFF_JOB_TIMEOUT_MS=8500
VOICE_COACH_SUBMIT_KICKOFF_MAX_JOBS=2
# Whether /events and /events/stream are allowed to trigger queue pumping.
VOICE_COACH_EVENTS_PUMP_ENABLED=false
# Polling/stream event pump budget (milliseconds).
VOICE_COACH_EVENTS_PUMP_WALL_MS=700
VOICE_COACH_EVENTS_PUMP_JOB_TIMEOUT_MS=700
VOICE_COACH_PUMP_MAIN_JOB_TIMEOUT_MS=7000
VOICE_COACH_PUMP_TTS_JOB_TIMEOUT_MS=7000
# Fallback reasons allowed from flash -> AUC.
VOICE_COACH_ASR_AUC_FALLBACK_WHITELIST=asr_flash_empty,asr_flash_timeout,asr_flash_http_5xx,asr_flash_status_5xx,asr_flash_network,asr_flash_permission_denied
# Enable debug timing fields in submit response.
VOICE_COACH_DEBUG_TIMING=false
# Requeue jobs stuck in processing for too long (ms).
VOICE_COACH_PROCESSING_STALE_MS=6000
# Optional server build id override used in response header x-server-build.
VOICE_COACH_SERVER_BUILD=

# Doubao text model (Volcengine Ark; used when VOICE_COACH_LLM_PROVIDER=doubao)
# Model should be your Ark endpoint/model ID (for example: ep-xxxxxxxx).
DOUBAO_TEXT_API_KEY=
DOUBAO_TEXT_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_TEXT_MODEL=
DOUBAO_TEXT_FAST_MODEL=
DOUBAO_TEXT_ANALYSIS_MODEL=
# enabled | disabled (default disabled for lower latency)
DOUBAO_TEXT_THINKING_TYPE=disabled
DOUBAO_TEXT_FAST_THINKING_TYPE=disabled
DOUBAO_TEXT_ANALYSIS_THINKING_TYPE=disabled

# Volcengine / Doubao Speech (ASR + TTS)
# Create an app in Volcengine OpenSpeech console to obtain these values.
VOLC_SPEECH_APP_ID=
VOLC_SPEECH_ACCESS_TOKEN=
# TTS defaults (override if your account has different clusters/voices enabled)
VOLC_TTS_CLUSTER=volcano_tts
VOLC_TTS_VOICE_TYPE=zh_female_vv_uranus_bigtts
VOLC_TTS_LANGUAGE=cn
# Optional fallback voice list (comma-separated), used if primary voice fails.
VOLC_TTS_FALLBACK_VOICES=
# Timeout tuning (milliseconds) for fast profile.
VOLC_TTS_TIMEOUT_MS=5000
# ASR resource (recording file recognize big model)
# - volc.seedasr.auc: model 2.0
# - volc.bigasr.auc: model 1.0
# Do not use idle resource id in realtime coaching.
VOLC_ASR_RESOURCE_ID=volc.bigasr.auc
# Optional flash ASR resource id (only set when your account has flash recognize permission).
# Example: volc.bigasr.auc_turbo
VOLC_ASR_FLASH_RESOURCE_ID=
VOLC_ASR_FLASH_TIMEOUT_MS=4000
VOLC_ASR_AUC_SUBMIT_TIMEOUT_MS=4000
VOLC_ASR_AUC_QUERY_TIMEOUT_MS=2500
VOLC_ASR_AUC_QUERY_MAX_ATTEMPTS=10

# WeChat Pay v3 (Native)
WECHATPAY_APPID=
WECHATPAY_MCHID=
WECHATPAY_SERIAL_NO=
# Merchant private key PEM; store as a single line with \n for newlines
WECHATPAY_PRIVATE_KEY=
# API v3 key (32 chars)
WECHATPAY_API_V3_KEY=

# WeChat Pay callback verifier (choose one mode)
# Option A (recommended): WeChat Pay public key mode
WECHATPAY_PLATFORM_PUBLIC_KEY_ID=
# WeChat Pay public key PEM; store as a single line with \n for newlines
WECHATPAY_PLATFORM_PUBLIC_KEY_PEM=

# Option B: Platform certificate mode (legacy)
WECHATPAY_PLATFORM_SERIAL_NO=
# Platform certificate PEM; store as a single line with \n for newlines
WECHATPAY_PLATFORM_CERT_PEM=

# Public HTTPS callback URL, e.g. https://www.example.com/api/wechatpay/notify
WECHATPAY_NOTIFY_URL=
